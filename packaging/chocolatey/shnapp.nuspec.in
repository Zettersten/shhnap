<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>shnapp</id>
    <version>__VERSION__</version>
    <title>Shnapp</title>
    <authors>Erik Zettersten</authors>
    <owners>Erik Zettersten</owners>
    <projectUrl>https://shhnap.com</projectUrl>
    <iconUrl>https://shhnap.com/assets/icon.png</iconUrl>
    <packageSourceUrl>https://github.com/Zettersten/shhnap/tree/main/packaging</packageSourceUrl>
    <docsUrl>https://github.com/Zettersten/shhnap/blob/main/README.md</docsUrl>
    <bugTrackerUrl>https://github.com/Zettersten/shhnap/issues</bugTrackerUrl>
    <projectSourceUrl>https://github.com/Zettersten/shhnap</projectSourceUrl>
    <licenseUrl>https://github.com/Zettersten/shhnap/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Screenshot and screen video capture and editing for Windows 11</summary>
    <description>Shnapp is a Windows 11 capture and editing app for x64 and ARM64 PCs. Capture a region, window, or display as a screenshot or screen recording. Annotate images, trim and split video, add text, images, audio, and transitions, then export a PNG or MP4. Find and reopen photos and videos together in a local library.</description>
    <releaseNotes>https://github.com/Zettersten/shhnap/releases/tag/v__VERSION__</releaseNotes>
    <tags>screenshot screen-recording video editor capture annotation windows</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
