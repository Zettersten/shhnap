# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.10.0.schema.json
PackageIdentifier: Zettersten.Shnapp
PackageVersion: __VERSION__
InstallerType: zip
NestedInstallerType: portable
ArchiveBinariesDependOnPath: true
MinimumOSVersion: 10.0.22000.0
Installers:
  - Architecture: x64
    InstallerUrl: https://github.com/Zettersten/shhnap/releases/download/v__VERSION__/Shnapp-win-x64.zip
    InstallerSha256: __SHA256_X64__
    NestedInstallerFiles:
      - RelativeFilePath: Shnapp.exe
        PortableCommandAlias: shnapp
  - Architecture: arm64
    InstallerUrl: https://github.com/Zettersten/shhnap/releases/download/v__VERSION__/Shnapp-win-arm64.zip
    InstallerSha256: __SHA256_ARM64__
    NestedInstallerFiles:
      - RelativeFilePath: Shnapp.exe
        PortableCommandAlias: shnapp
ManifestType: installer
ManifestVersion: 1.10.0
