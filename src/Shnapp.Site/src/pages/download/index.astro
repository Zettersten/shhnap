---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { assetUrl, catalogChannels, distribution, downloadsAvailable, issueUrls, latestReleaseUrl } from '../../config/distribution';
import type { CatalogState } from '../../config/distribution';

const builds = Object.entries(distribution.builds).map(([architecture, build]) => ({ architecture, ...build }));
const contactHref = `mailto:${distribution.contactEmail}`;
const bugHref = distribution.publicRepository ? issueUrls.bug : contactHref;
const featureHref = distribution.publicRepository ? issueUrls.feature : contactHref;
const catalogStatus: Record<CatalogState, string> = {
  planned: 'Planned',
  'awaiting-listing': 'Awaiting catalog listing',
  live: 'Available',
};
if (catalogChannels.some((channel) => channel.state === 'live' && !channel.listingUrl)) {
  throw new Error('A live catalog channel needs a public listing URL.');
}
---

<SiteLayout
  page="download"
  title="Download Shnapp for Windows 11"
  description="Get Shnapp for Windows 11. Choose the x64 or ARM64 direct download and follow the setup steps for the current release."
>
  <div class="download-page">
    <section class="dl-hero" aria-labelledby="download-title">
      <div class="shell dl-hero-inner">
        <div class="dl-hero-copy">
          <span class="dl-release-status" role="status">
            <span class="dl-status-dot" aria-hidden="true"></span>
            <span data-release-status-copy>{downloadsAvailable ? 'Available now for Windows 11' : 'First public release in preparation'}</span>
          </span>
          <h1 id="download-title">Ready when the moment <em>hits.</em></h1>
          <p>Get Shnapp for Windows 11 and turn a quick capture into something ready to keep, copy, or share. Built for Intel, AMD, and ARM PCs.</p>
          <div class="dl-hero-actions">
            <a class="dl-primary-link" href="#builds">Choose your build <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            {downloadsAvailable && <a class="dl-secondary-link" data-release-link href={latestReleaseUrl} target="_blank" rel="noopener noreferrer">See release notes <span aria-hidden="true">↗</span></a>}
          </div>
        </div>
        <figure class="dl-hero-preview">
          <div class="dl-preview-frame">
            <img src="/screenshots/editor.png" width="1920" height="1032" alt="Shnapp editor showing a captured workspace with annotations and a covered access code" />
          </div>
          <figcaption>Capture. Mark it up. Keep moving.</figcaption>
        </figure>
      </div>
    </section>

    <section class="dl-build-section" id="builds" aria-labelledby="builds-title">
      <div class="shell">
        <div class="dl-section-intro dl-build-intro">
          <h2 id="builds-title">Pick the build for your PC.</h2>
          <p data-zip-only>Both portable ZIP packages include the app and its runtime. Extract the whole archive and keep the <code>versions</code> folder and <code>current-version.txt</code> beside the root <code>Shnapp.exe</code> launcher.</p>
          <p data-installer-only hidden>Run the setup file for your PC to install Shnapp. Prefer a portable copy? The ZIP package is available beneath each installer.</p>
        </div>
        {downloadsAvailable && <p class="dl-signing-note" data-unsigned-release><strong>v1.0.12 is unsigned.</strong> If you receive that version, Windows may show an Unknown publisher or SmartScreen warning. Check its SHA-256 checksum before running it.</p>}
        {!downloadsAvailable && (
          <div class="dl-availability-message" role="status">
            <strong>Public downloads are being prepared.</strong>
            <p>Shnapp is in preview, and the first release has not been published yet. The download buttons will appear here when the packages are ready.</p>
          </div>
        )}
        <div class="dl-build-grid">
          {builds.map((build) => (
            <article class="dl-build-card">
              <div class="dl-build-symbol" aria-hidden="true"><svg viewBox="0 0 36 36" fill="none"><path d="M3.5 8.1 16.4 6v12H3.5V8.1Zm16-2.6 13-2.1V18h-13V5.5Zm-16 15h12.9v12L3.5 30.4v-9.9Zm16 0h13v14.1l-13-2.1v-12Z" fill="currentColor" /></svg></div>
              <div class="dl-build-content"><h3>{build.label}</h3><p>{build.processor}</p><span class="dl-build-filename" data-release-filename={build.architecture}>{build.fileName}</span></div>
              <div class="dl-build-bottom">
                {downloadsAvailable
                  ? <a class="dl-build-action" data-release-download={build.architecture} href={assetUrl(build.fileName)} aria-label={`Download Shnapp ZIP for ${build.label}`}><span data-release-download-label={build.architecture}>Download ZIP</span> <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v10m-4-4 4 4 4-4M3.5 16.5h13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
                  : <span class="dl-build-pending">Coming with first release</span>}
                {downloadsAvailable && <a class="dl-build-hash" data-release-checksum={build.architecture} href={assetUrl(`${build.fileName}.sha256`)}>SHA-256 checksum file</a>}
                {downloadsAvailable && <a class="dl-build-portable" data-release-portable={build.architecture} href={assetUrl(build.fileName)} aria-label={`Download portable ZIP for ${build.label}`} hidden>Portable ZIP</a>}
                {downloadsAvailable && <a class="dl-build-portable" data-release-portable-checksum={build.architecture} href={assetUrl(`${build.fileName}.sha256`)} aria-label={`SHA-256 checksum file for portable ZIP for ${build.label}`} hidden>ZIP checksum</a>}
              </div>
            </article>
          ))}
        </div>
        <p class="dl-architecture-help"><strong>Not sure which one?</strong> In Windows Settings, open <span>System → About</span> and read <span>System type</span>.</p>
        {downloadsAvailable && (
          <div class="dl-release-details">
            <p>Latest release: <a data-release-version href={latestReleaseUrl} target="_blank" rel="noopener noreferrer">View current version on GitHub <span aria-hidden="true">↗</span></a><time data-release-date></time></p>
            <div class="dl-release-changes" data-release-changes hidden>
              <h3>What changed in <span data-release-changes-version></span></h3>
              <ul data-release-highlights></ul>
              <a data-release-link href={latestReleaseUrl} target="_blank" rel="noopener noreferrer">Read the full release notes <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        )}
      </div>
    </section>

    <section class="dl-setup-section" aria-labelledby="setup-title">
      <div class="shell dl-setup-layout">
        <div class="dl-setup-heading"><h2 id="setup-title">Three steps.<br />Then you’re off.</h2><p data-zip-only>No installer wizard to work through. Go from ZIP to your first capture.</p><p data-installer-only hidden>Go from setup file to your first capture in a few steps.</p></div>
        <ol class="dl-setup-list">
          <li><span class="dl-setup-index" aria-hidden="true">01</span><div><h3>Download</h3><p>Choose x64 for an Intel or AMD PC, or ARM64 for a Windows on ARM PC.</p></div></li>
          <li><span class="dl-setup-index" aria-hidden="true">02</span><div><h3 data-zip-only>Extract</h3><p data-zip-only>Extract the entire archive to a folder you choose. Keep <code>versions</code> and <code>current-version.txt</code> beside the root <code>Shnapp.exe</code>, then run that launcher.</p><h3 data-installer-only hidden>Install</h3><p data-installer-only hidden>Run the setup file to install Shnapp, then open the app.</p></div></li>
          <li><span class="dl-setup-index" aria-hidden="true">03</span><div><h3>Capture</h3><p>Use Ctrl + Shift + 4 for a window, 3 for the full screen, or 2 for a region.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="dl-catalog-section" aria-labelledby="catalog-title">
      <div class="shell">
        <div class="dl-section-intro dl-catalog-intro"><h2 id="catalog-title">Your preferred way to install.</h2><p>Package manager and Microsoft Store options appear here as their listings become available. Each channel shows its current status.</p></div>
        <div class="dl-catalog-list">
          {catalogChannels.map((channel) => (
            <article class="dl-catalog-row">
              <div class="dl-catalog-name"><h3>{channel.name}</h3><p>{channel.description}</p></div>
              <div class="dl-catalog-details">
                <span class="dl-catalog-status" data-state={channel.state}><span aria-hidden="true"></span>{catalogStatus[channel.state]}</span>
                {channel.state === 'live' && channel.listingUrl ? (
                  <div class="dl-catalog-available">
                    <a href={channel.listingUrl} target="_blank" rel="noopener noreferrer">Open listing <span aria-hidden="true">↗</span></a>
                    <dl>
                      <div><dt>Install</dt><dd>{channel.installCommand ? <code>{channel.installCommand}</code> : 'Use the store listing'}</dd></div>
                      <div><dt>Update</dt><dd>{channel.id === 'microsoft-store' ? channel.updateCommand : <code>{channel.updateCommand}</code>}</dd></div>
                    </dl>
                  </div>
                ) : <p class="dl-catalog-pending">Install and update details will appear after listing.</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="dl-info-section" aria-labelledby="know-title">
      <div class="shell dl-info-layout">
        <div class="dl-info-heading"><h2 id="know-title">A few useful details.</h2><p>Shnapp saves its library and preferences in your Windows user folder, separate from the app files.</p><a href="/privacy/">How Shnapp handles your data <span aria-hidden="true">↗</span></a></div>
        <div class="dl-faq">
          <details><summary>Does Shnapp need an account?</summary><p>No. Capturing, editing, copying, and saving do not require an account.</p></details>
          <details><summary>Where are my captures stored?</summary><p>Direct-download editions keep your library and settings under <code>%LOCALAPPDATA%\Shnapp</code> by default. The Microsoft Store edition uses its own Windows app-data folder. Quit a direct-download copy before opening the Store edition for the first time so it can copy your existing library. Your original files stay in place. PNGs you save elsewhere go to the location you choose. <a href="/privacy/">See the privacy details.</a></p></details>
          <details><summary>How do updates work?</summary><p data-zip-only>Direct ZIP copies check for a stable GitHub release at most once a day. Shnapp verifies and prepares a newer version in the background, then uses it on your next restart. You can check or restart from Settings → About &amp; Updates. Copies installed before v1.0.4 need one manual ZIP replacement to gain this feature; the local library stays in your Windows user folder. Scoop, WinGet, and Chocolatey copies use their package managers, with an update action in Shnapp. A Store copy uses Microsoft Store updates when its listing becomes available.</p><p data-installer-only hidden>Installer copies can check for and apply app updates from Settings → About &amp; Updates. Portable ZIP copies retain their existing GitHub release updater. Scoop, WinGet, and Chocolatey copies use their package managers, with an update action in Shnapp. A Store copy uses Microsoft Store updates when its listing becomes available.</p></details>
          <details><summary>What if my capture contains sensitive information?</summary><p>Use opaque Cover before copying, saving, or sharing the finished image. Blur and Pixelate are visual obscuring tools and may leave details recognizable. Your editable original stays in your local library.</p></details>
        </div>
      </div>
    </section>

    <section class="dl-feedback-section" aria-labelledby="feedback-title">
      <div class="shell dl-feedback-layout">
        <div><h2 id="feedback-title">Help shape what’s next.</h2><p>Report a bug or tell us what would make Shnapp more useful. {distribution.publicRepository ? 'The links open a GitHub issue form.' : 'Until the public issue tracker opens, email Erik directly.'}</p></div>
        <div class="dl-feedback-actions">
          <a href={bugHref} target={distribution.publicRepository ? '_blank' : undefined} rel={distribution.publicRepository ? 'noopener noreferrer' : undefined}>Report a bug <span aria-hidden="true">↗</span></a>
          <a href={featureHref} target={distribution.publicRepository ? '_blank' : undefined} rel={distribution.publicRepository ? 'noopener noreferrer' : undefined}>Request a feature <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<script>
  import { parseReleaseFeed, preferredReleaseAsset, releaseFeedUrl, releaseHighlights } from '../../lib/release-feed';

  async function showLatestRelease() {
    try {
      const response = await fetch(releaseFeedUrl);
      if (!response.ok) return;
      const feed = parseReleaseFeed(await response.json());
      if (!feed) return;

      const hasInstaller = feed.schemaVersion === 2;
      document.querySelectorAll<HTMLElement>('[data-zip-only]').forEach((element) => { element.hidden = hasInstaller; });
      document.querySelectorAll<HTMLElement>('[data-installer-only]').forEach((element) => { element.hidden = !hasInstaller; });
      const signingNote = document.querySelector<HTMLElement>('[data-unsigned-release]');
      if (signingNote) signingNote.hidden = feed.tag !== 'v1.0.12';

      const status = document.querySelector<HTMLElement>('[data-release-status-copy]');
      if (status) status.textContent = `Shnapp ${feed.tag} available for Windows 11`;

      const version = document.querySelector<HTMLAnchorElement>('[data-release-version]');
      if (version) {
        version.textContent = `Shnapp ${feed.tag}`;
        version.href = feed.releaseUrl;
      }
      const date = document.querySelector<HTMLTimeElement>('[data-release-date]');
      if (date) {
        date.dateTime = feed.publishedAt;
        date.textContent = `Published ${new Intl.DateTimeFormat(undefined, { year: 'numeric', month: 'short', day: 'numeric' }).format(new Date(feed.publishedAt))}`;
      }

      document.querySelectorAll<HTMLAnchorElement>('[data-release-link]').forEach((link) => { link.href = feed.releaseUrl; });
      for (const architecture of ['x64', 'arm64'] as const) {
        const download = preferredReleaseAsset(feed, architecture);
        const button = document.querySelector<HTMLAnchorElement>(`[data-release-download="${architecture}"]`);
        const checksum = document.querySelector<HTMLAnchorElement>(`[data-release-checksum="${architecture}"]`);
        const fileName = document.querySelector<HTMLElement>(`[data-release-filename="${architecture}"]`);
        const label = document.querySelector<HTMLElement>(`[data-release-download-label="${architecture}"]`);
        const portable = document.querySelector<HTMLAnchorElement>(`[data-release-portable="${architecture}"]`);
        const portableChecksum = document.querySelector<HTMLAnchorElement>(`[data-release-portable-checksum="${architecture}"]`);
        if (button) {
          button.href = download.url;
          button.setAttribute('aria-label', `Download Shnapp ${hasInstaller ? 'installer' : 'ZIP'} for Windows ${architecture === 'x64' ? 'x64' : 'ARM64'}`);
        }
        if (checksum) {
          checksum.href = `${download.url}.sha256`;
          checksum.textContent = hasInstaller ? 'Installer SHA-256' : 'SHA-256 checksum file';
          checksum.setAttribute('aria-label', `SHA-256 checksum file for Windows ${architecture === 'x64' ? 'x64' : 'ARM64'} ${hasInstaller ? 'installer' : 'ZIP'}`);
        }
        if (fileName) fileName.textContent = download.url.split('/').at(-1) ?? '';
        if (label) label.textContent = hasInstaller ? 'Download installer' : 'Download ZIP';
        if (portable) {
          portable.href = feed.downloads[architecture].url;
          portable.hidden = !hasInstaller;
        }
        if (portableChecksum) {
          portableChecksum.href = `${feed.downloads[architecture].url}.sha256`;
          portableChecksum.hidden = !hasInstaller;
        }
      }

      const highlights = releaseHighlights(feed.notes);
      const section = document.querySelector<HTMLElement>('[data-release-changes]');
      const list = document.querySelector<HTMLUListElement>('[data-release-highlights]');
      const headingVersion = document.querySelector<HTMLElement>('[data-release-changes-version]');
      if (section && list && headingVersion && highlights.length) {
        headingVersion.textContent = feed.tag;
        list.replaceChildren(...highlights.map((highlight) => {
          const item = document.createElement('li');
          item.textContent = highlight;
          return item;
        }));
        section.hidden = false;
      }
    } catch {
      // The release links rendered with the page remain available if the feed is offline.
    }
  }

  void showLatestRelease();
</script>
