---
import SiteLayout from '../layouts/SiteLayout.astro';
import { distribution, downloadsAvailable, issueUrls } from '../config/distribution';

const feedbackHref = distribution.publicRepository
  ? issueUrls.chooser
  : 'mailto:' + distribution.contactEmail;

const captureModes = [
  { title: 'A window', key: '4', description: 'Choose the window you want. Shnapp frames it with a soft shadow.' },
  { title: 'A screen', key: '3', description: 'Capture the display beneath your pointer in one move.' },
  { title: 'A region', key: '2', description: 'Drag a precise rectangle with live dimensions. Hold Shift for a square.' },
];
---

<SiteLayout
  title="Shnapp — Make the picture do the explaining"
  description="Shnapp is a Windows 11 screenshot and annotation app. Capture a window, screen, or region, add context, and copy or save a clear PNG."
  page="home"
>
  <section class="home-hero" aria-labelledby="hero-title">
    <img class="home-hero-art" src="/assets/shnapp-hero.png" alt="" width="1450" height="1086" fetchpriority="high" />
    <div class="home-hero-wash" aria-hidden="true"></div>
    <div class="shell home-hero-content">
      <img class="hero-icon" src="/assets/icon.png" alt="" width="92" height="92" />
      <h1 id="hero-title">Make the picture<br /><span>do the explaining.</span></h1>
      <p>Shnapp helps creators turn raw screenshots into clear, annotated visuals. Capture the moment, point to what matters, then copy or save a picture that is ready to share.</p>
      <div class="hero-actions">
        <a class="button button-hero" href="/download/">{downloadsAvailable ? 'Download Shnapp' : 'Explore the preview'} <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v10m-4-4 4 4 4-4M4 16h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        <a class="button button-hero-outline" href="#workflow">See how it works <span aria-hidden="true">↘</span></a>
      </div>
      <p class="hero-availability">Windows 11 · x64 and ARM64 · {downloadsAvailable ? 'Available now' : 'Early preview'}</p>
    </div>
    <p class="hero-art-caption">Illustrative scene. Actual app captures below.</p>
  </section>

  <section class="fact-band" aria-label="Shnapp at a glance">
    <div class="shell fact-band-inner">
      <p><span class="fact-dot" aria-hidden="true"></span>Ready from the tray</p>
      <p><span class="fact-dot" aria-hidden="true"></span>No account for the core flow</p>
      <p><span class="fact-dot" aria-hidden="true"></span>Your library stays local</p>
      <p><span class="fact-dot" aria-hidden="true"></span>Copy or save a PNG</p>
    </div>
  </section>

  <section class="opening-section section-space" id="workflow" aria-labelledby="opening-title">
    <div class="shell">
      <div class="opening-copy">
        <h2 id="opening-title">A little context changes everything.</h2>
        <p>For a walkthrough, a visual note, or a quick explanation, Shnapp keeps the whole job in one place. Choose what to capture, add a mark, and get back to making.</p>
      </div>
      <div class="workflow-frame">
        <div class="workflow-frame-head"><span class="frame-light" aria-hidden="true"></span><span>See Shnapp in action</span><span class="frame-duration">24 seconds</span></div>
        {distribution.workflowVideoLive ? (
          <div class="workflow-player">
            <video data-workflow-video controls preload="none" poster="/demos/shnapp-workflow-poster.jpg" playsinline width="1280" height="688" aria-label="Shnapp demo showing capture, annotation, copy, and the local library">
              <source src="/demos/shnapp-workflow.mp4" type="video/mp4" />
              Your browser cannot play this video. The steps are described below.
            </video>
            <button class="workflow-play" type="button" data-video-start aria-label="Play the 24-second Shnapp demo"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 10 7-10 7V5Z" fill="currentColor" /></svg><span>Play the demo</span></button>
          </div>
        ) : (
          <img class="workflow-fallback" src="/screenshots/editor.png" alt="The Shnapp editor with an annotated sample capture" width="1920" height="1032" loading="lazy" />
        )}
        <p class="workflow-caption">A real Shnapp session using fictional sample content: capture, annotate, copy, and find it again.</p>
      </div>
      <div class="workflow-steps" aria-label="The Shnapp workflow">
        <div><span>1</span><h3>Capture</h3><p>Pick a window, full screen, or a precise region.</p></div>
        <div><span>2</span><h3>Make it clear</h3><p>Add the words, steps, shapes, or privacy cover you need.</p></div>
        <div><span>3</span><h3>Send it on</h3><p>Copy the finished image or save a PNG for later.</p></div>
      </div>
    </div>
  </section>

  <section class="feature-section editor-feature section-space" id="features" aria-labelledby="editor-title">
    <div class="shell feature-layout">
      <div class="feature-copy">
        <h2 id="editor-title">The right detail, in the right place.</h2>
        <p>Shnapp puts your capture on the canvas and its tools close by. Place an annotation directly on the image, then adjust it without losing the thread.</p>
        <ul class="feature-points">
          <li><strong>Explain the sequence.</strong> Add text and numbered, lettered, or Roman step markers.</li>
          <li><strong>Guide the eye.</strong> Use lines, arrows, and shapes to make a point unmistakable.</li>
          <li><strong>Keep it precise.</strong> Crop, zoom, pan, and nudge a mark one pixel at a time.</li>
        </ul>
        <a class="arrow-link" href="/download/">{downloadsAvailable ? 'Get Shnapp' : 'See the preview'} <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="feature-visual editor-visual">
        <a href="/screenshots/editor.png" aria-label="Open a full-size screenshot of the Shnapp editor"><img src="/screenshots/editor.png" alt="Actual Shnapp editor showing a sample launch checklist with numbered steps and an opaque cover over a fictional access code" width="1920" height="1032" loading="lazy" /></a>
        <figcaption>Actual app screenshot with fictional sample content.</figcaption>
      </figure>
    </div>
  </section>

  <section class="capture-section section-space" aria-labelledby="capture-title">
    <div class="shell">
      <div class="capture-heading"><h2 id="capture-title">There when you need it.<br />Gone when you don’t.</h2><p>Shnapp waits in the Windows tray. The main capture button starts a region shnapp; its attached arrow offers window and full-screen capture. Shortcuts work while you are in another app.</p></div>
      <div class="capture-list">
        {captureModes.map((mode) => (
          <div class="capture-row">
            <h3>{mode.title}</h3>
            <p>{mode.description}</p>
            <span class="shortcut" aria-label={'Control plus Shift plus ' + mode.key}><kbd>Ctrl</kbd><span aria-hidden="true">+</span><kbd>Shift</kbd><span aria-hidden="true">+</span><kbd>{mode.key}</kbd></span>
          </div>
        ))}
      </div>
      <figure class="capture-app-figure">
        <a href="/screenshots/empty-library.png" aria-label="Open a full-size screenshot of Shnapp before the first capture"><img src="/screenshots/empty-library.png" alt="Actual Shnapp empty library with the central Capture a region button and its separate dropdown arrow" width="1106" height="793" loading="lazy" /></a>
        <figcaption>Open Shnapp and start with a region, or use the arrow for another capture mode.</figcaption>
      </figure>
    </div>
  </section>

  <section class="feature-section library-feature section-space" aria-labelledby="library-title">
    <div class="shell feature-layout feature-layout-reverse">
      <figure class="feature-visual library-visual">
        <a href="/screenshots/library.png" aria-label="Open a full-size screenshot of the Shnapp library"><img src="/screenshots/library.png" alt="Actual Shnapp library showing fictional saved captures, search, sorting, and thumbnail controls" width="1226" height="693" loading="lazy" /></a>
        <figcaption>Actual app screenshot with fictional sample content.</figcaption>
      </figure>
      <div class="feature-copy">
        <h2 id="library-title">A good capture is worth finding again.</h2>
        <p>Saved shnapps land in your local library, ready to search, sort, reopen, or share. Choose the thumbnail size that makes browsing feel right.</p>
        <p>When you revisit an image, the canvas and your marks are ready for another pass.</p>
        <a class="arrow-link" href="/privacy/">Where your captures live <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="feature-section settings-feature section-space" id="settings" aria-labelledby="settings-title">
    <div class="shell feature-layout">
      <div class="feature-copy">
        <h2 id="settings-title">Set it once. Keep moving.</h2>
        <p>Choose how Shnapp starts, copies new captures, and frames captured windows. Change the theme, check the keyboard shortcuts, and find your local library path in one place.</p>
        <p>Preferences save as you change them. About &amp; Updates shows the installed version and any available release, while Feedback keeps report links close.</p>
        <a class="arrow-link" href="/download/">Get Shnapp <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="feature-visual settings-visual">
        <a href="/screenshots/settings-general.png" aria-label="Open a full-size screenshot of Shnapp settings"><img src="/screenshots/settings-general.png" alt="Actual Shnapp General settings dialog showing capture preferences, appearance, and keyboard shortcuts" width="1106" height="793" loading="lazy" /></a>
        <figcaption>Settings in the app. <a href="/screenshots/settings-about.png">See About &amp; Updates <span aria-hidden="true">↗</span></a></figcaption>
      </figure>
    </div>
  </section>

  <section class="privacy-feature section-space" aria-labelledby="privacy-title">
    <div class="shell privacy-feature-inner">
      <div class="privacy-symbol" aria-hidden="true"><img src="/assets/icon.png" alt="" width="130" height="130" loading="lazy" /></div>
      <div class="privacy-feature-copy">
        <h2 id="privacy-title">Your work stays yours.</h2>
        <p>The core capture and editing flow needs no account or internet connection. Your library and preferences stay in your Windows user folder. Use opaque Cover when sensitive details need to be removed from the image you share.</p>
        <a class="arrow-link arrow-link-light" href="/privacy/">Read the privacy details <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="faq-section section-space" aria-labelledby="faq-title">
    <div class="shell faq-layout">
      <div class="faq-intro"><h2 id="faq-title">Good to know.</h2><p>A few practical answers before your first shnapp.</p></div>
      <div class="faq-list">
        <details><summary>What can Shnapp capture?</summary><p>The main New shnapp button starts a rectangular region capture. Its attached arrow offers a window or the screen beneath your pointer. The visible desktop freezes while you make a selection.</p></details>
        <details><summary>Do I need an account?</summary><p>No. Capture, edit, copy, and save work without an account or internet connection.</p></details>
        <details><summary>How do I install it?</summary><p>Choose the x64 or ARM64 portable ZIP on the <a href="/download/">download page</a>, extract the whole archive, and run Shnapp.exe. Scoop is also available.</p></details>
        <details><summary>Can I hide sensitive information?</summary><p>Use opaque Cover before sharing the finished PNG. Blur and Pixelate are visual obscuring tools and may leave details recognizable. The editable original remains in your local library.</p></details>
      </div>
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-title">
    <div class="shell final-cta-inner">
      <div><h2 id="final-title">Ready to make it clear?</h2><p>Capture the moment. Add the context. Share the picture.</p></div>
      <div class="final-actions"><a class="button button-final" href="/download/">{downloadsAvailable ? 'Download Shnapp' : 'Explore the preview'} <span aria-hidden="true">↗</span></a><a href={feedbackHref} target={distribution.publicRepository ? '_blank' : undefined} rel={distribution.publicRepository ? 'noopener noreferrer' : undefined}>Help shape Shnapp</a></div>
    </div>
  </section>
</SiteLayout>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-workflow-video]');
  const start = document.querySelector<HTMLButtonElement>('[data-video-start]');
  start?.addEventListener('click', async () => {
    if (!video) return;
    try {
      await video.play();
      start.hidden = true;
    } catch {
      start.textContent = 'Video unavailable. Read the steps below.';
      start.disabled = true;
    }
  });
  video?.addEventListener('play', () => { if (start) start.hidden = true; });
</script>
