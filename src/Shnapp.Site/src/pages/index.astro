---
import SiteLayout from '../layouts/SiteLayout.astro';
import { distribution, downloadsAvailable, issueUrls } from '../config/distribution';

const shortcuts = [
  { name: 'A window', key: '4', detail: 'Pick an open window. Shnapp adds a soft shadow to the finished capture.' },
  { name: 'A full screen', key: '3', detail: 'Capture the display beneath your pointer.' },
  { name: 'A region', key: '2', detail: 'Drag a precise rectangle with live pixel dimensions. Hold Shift for a square.' },
];

const feedbackHref = distribution.publicRepository
  ? issueUrls.chooser
  : `mailto:${distribution.contactEmail}`;
---

<SiteLayout
  title="Shnapp — Capture it. Make your point."
  description="Shnapp is a Windows 11 screenshot app. Capture a window, screen, or region; add context; then copy or save a PNG."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-content">
      <div class="hero-heading-block">
        <h1 id="hero-title">Capture it.<br /><span>Make your point.</span></h1>
      </div>
      <div class="hero-side">
        <p>Shnapp gets a screenshot out of your way and into the conversation. Press a shortcut, add the detail that matters, then copy or save.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/download/">
            Get Shnapp for Windows
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
          <a class="text-link" href="#workflow">See how it works <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-meta">Windows 11 · x64 and ARM64 · {downloadsAvailable ? 'Available now' : 'Early preview'}</p>
      </div>
    </div>
    <div class="shell hero-product">
      <figure class="hero-figure">
        <div class="hero-visual">
          <a href="/screenshots/editor.png" aria-label="Open the full-size Shnapp editor screenshot">
            <img src="/screenshots/editor.png" alt="Shnapp editor showing a fictional launch checklist with three numbered markers and a covered demo code" width="1920" height="1032" fetchpriority="high" />
          </a>
          <span class="capture-bracket capture-bracket-top" aria-hidden="true"></span>
          <span class="capture-bracket capture-bracket-bottom" aria-hidden="true"></span>
        </div>
        <figcaption>Actual app screenshot with sample content.</figcaption>
      </figure>
    </div>
  </section>

  <div class="proof-strip" aria-label="Shnapp at a glance">
    <div class="shell proof-inner">
      <span>Ready from the tray</span>
      <span>No account for the core flow</span>
      <span>Copy or save a PNG</span>
    </div>
  </div>

  <section class="workflow-section section-pad" id="workflow" aria-labelledby="workflow-title">
    <div class="shell">
      <div class="section-heading workflow-heading">
        <h2 id="workflow-title">From screen to useful image.</h2>
        <p>Three quick moves. The walkthrough uses real app screenshots and an illustrated capture selection.</p>
      </div>

      {distribution.workflowVideoLive && (
        <figure class="workflow-video">
          <div class="workflow-video-player">
            <video data-workflow-video controls preload="none" poster="/demos/shnapp-workflow-poster.jpg" playsinline muted width="1280" height="688" aria-label="Shnapp capture, annotation, copy, and local library demonstration">
              <source src="/demos/shnapp-workflow.mp4" type="video/mp4" />
              Your browser cannot play this video. Use the step-by-step walkthrough below.
            </video>
            <button class="video-start" type="button" data-video-start>
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m7 4 9 6-9 6V4Z" fill="currentColor" /></svg>
              Watch the 24-second demo
            </button>
          </div>
          <figcaption>A real Shnapp session with fictional content: capture a window, add a step and Cover, copy the PNG, then open the local library. The same steps are available below.</figcaption>
        </figure>
      )}

      <div class="workflow-demo" data-workflow-demo>
        <div class="workflow-controls">
          <div class="workflow-steps" aria-label="Walkthrough steps">
            <button type="button" class="workflow-step is-active" data-step-button="0" aria-pressed="true" aria-controls="workflow-scene-0">
              <span class="step-count">1</span>
              <span><strong>Capture</strong><small>Pick a window, screen, or region.</small></span>
            </button>
            <button type="button" class="workflow-step" data-step-button="1" aria-pressed="false" aria-controls="workflow-scene-1">
              <span class="step-count">2</span>
              <span><strong>Annotate</strong><small>Add a mark and adjust it right away.</small></span>
            </button>
            <button type="button" class="workflow-step" data-step-button="2" aria-pressed="false" aria-controls="workflow-scene-2">
              <span class="step-count">3</span>
              <span><strong>Copy or save</strong><small>Use the PNG now or find it later.</small></span>
            </button>
          </div>
          <button class="demo-play" type="button" data-demo-play aria-pressed="false">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m7 4 9 6-9 6V4Z" fill="currentColor" /></svg>
            <span data-play-label>Play the walkthrough</span>
          </button>
        </div>

        <div class="demo-screen">
          <div class="demo-scene demo-scene-capture" id="workflow-scene-0" data-scene="0">
            <svg class="capture-diagram" viewBox="0 0 820 490" role="img" aria-labelledby="capture-diagram-title">
              <title id="capture-diagram-title">Illustration of a rectangular screen selection with pixel dimensions</title>
              <rect class="diagram-window" x="58" y="35" width="704" height="420" rx="18" />
              <path class="diagram-window-top" d="M58 83h704" />
              <circle class="diagram-dot" cx="89" cy="59" r="6" />
              <circle class="diagram-dot" cx="110" cy="59" r="6" />
              <circle class="diagram-dot" cx="131" cy="59" r="6" />
              <rect class="diagram-line diagram-line-title" x="104" y="125" width="288" height="19" rx="5" />
              <rect class="diagram-line" x="104" y="163" width="405" height="13" rx="5" />
              <rect class="diagram-line" x="104" y="188" width="326" height="13" rx="5" />
              <rect class="diagram-block" x="104" y="242" width="540" height="139" rx="9" />
              <path class="diagram-selection" d="M173 113h485v293H173z" />
              <path class="diagram-corner" d="M173 135v-22h22m441 0h22v22M173 384v22h22m441 0h22v-22" />
              <rect class="dimension-back" x="541" y="416" width="117" height="37" rx="8" />
              <text class="dimension-text" x="600" y="440" text-anchor="middle">986 × 673</text>
            </svg>
            <p class="scene-note">Illustrated selection; the current app captures rectangular regions.</p>
          </div>
          <div class="demo-scene demo-scene-image" id="workflow-scene-1" data-scene="1" hidden>
            <img src="/screenshots/editor.png" alt="Shnapp editor with numbered steps and opaque Cover over a fictional demo code" width="1920" height="1032" loading="lazy" />
            <p class="scene-note">Actual app screenshot with sample content.</p>
          </div>
          <div class="demo-scene demo-scene-image" id="workflow-scene-2" data-scene="2" hidden>
            <img src="/screenshots/library.png" alt="Shnapp local library with four saved sample captures, search, and sorting controls" width="1506" height="643" loading="lazy" />
            <p class="scene-note">Saved shnapps remain available in the local library.</p>
          </div>
        </div>
      </div>

      <div class="shortcut-intro">
        <h3>Start with a shortcut.</h3>
        <p>Shnapp waits quietly in the Windows tray. The editor opens after the capture.</p>
      </div>
      <div class="shortcut-list">
        {shortcuts.map((shortcut) => (
          <div class="shortcut-row">
            <strong>{shortcut.name}</strong>
            <span class="key-sequence" aria-label={`Control plus Shift plus ${shortcut.key}`}><kbd>Ctrl</kbd><span aria-hidden="true">+</span><kbd>Shift</kbd><span aria-hidden="true">+</span><kbd>{shortcut.key}</kbd></span>
            <p>{shortcut.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="details-section section-pad" id="details" aria-labelledby="details-title">
    <div class="shell details-layout">
      <div class="details-intro">
        <h2 id="details-title">Just enough to explain what matters.</h2>
        <p>Place a mark directly on the capture. The options for that mark appear beside it, so the image stays in charge.</p>
        <a class="inline-link" href="/download/">{downloadsAvailable ? 'Get Shnapp' : 'See the current preview'} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="feature-list">
        <div class="feature-row">
          <svg viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="M5 28V8h26v20H5Z" stroke="currentColor" stroke-width="1.8" /><path d="M11 14h14M11 19h10M11 24h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          <div><h3>Words and steps</h3><p>Write on the image or use a text box. Add numbered, lettered, or Roman step dots to make a sequence easy to follow.</p></div>
        </div>
        <div class="feature-row">
          <svg viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="m6 27 23-18M23 8l6 1-1 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /><path d="M7 8h8v8H7z" stroke="currentColor" stroke-width="1.8" /></svg>
          <div><h3>Lines and shapes</h3><p>Draw solid, dashed, or dotted lines with end caps. Add outlined or filled shapes to point at the right detail.</p></div>
        </div>
        <div class="feature-row">
          <svg viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="M10 4v22a3 3 0 0 0 3 3h19M4 10h22a3 3 0 0 1 3 3v19" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" /><path d="M12 12h12v12H12z" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3" /></svg>
          <div><h3>Crop to the point</h3><p>Move the crop into place and choose exact pixels or a familiar ratio. Zoom, pan, and nudge marks when precision matters.</p></div>
        </div>
        <div class="feature-row">
          <svg viewBox="0 0 36 36" fill="none" aria-hidden="true"><rect x="6" y="8" width="24" height="20" rx="2" stroke="currentColor" stroke-width="1.8" /><path d="M10 24 26 12M10 18l10-6M16 24l10-6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" /></svg>
          <div><h3>Keep private details private</h3><p>Use opaque Cover for sensitive information. Blur and Pixelate offer visual obscuring when that is enough.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="library-section section-pad" id="library" aria-labelledby="library-title">
    <div class="shell library-layout">
      <div class="library-copy">
        <h2 id="library-title">Find it again.<br />Right where you left it.</h2>
        <p>Every saved shnapp lands in your local library. Search, sort, choose a thumbnail size, and reopen a capture when there is more to say.</p>
        <a class="inline-link" href="/privacy/">Where your captures live <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="library-figure">
        <a href="/screenshots/library.png" aria-label="Open the full-size Shnapp library screenshot">
          <img src="/screenshots/library.png" alt="Shnapp local library with four saved sample captures, search, sorting, and thumbnail controls" width="1506" height="643" loading="lazy" />
        </a>
        <figcaption>Actual app screenshot with sample content.</figcaption>
      </figure>
    </div>
  </section>

  <section class="privacy-section section-pad" id="privacy" aria-labelledby="privacy-title">
    <div class="shell privacy-layout">
      <div class="privacy-symbol" aria-hidden="true">
        <svg viewBox="0 0 82 82" fill="none"><path d="M41 6 70 17v20c0 18-11 30-29 39C23 67 12 55 12 37V17L41 6Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" /><path d="m27 41 10 10 20-22" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </div>
      <div>
        <h2 id="privacy-title">Local is the default.</h2>
        <p>Your library and preferences stay in your Windows user folder. The core capture and editing flow needs no account or internet connection. Copied and exported PNGs include your chosen Cover, Blur, or Pixelate effect; editable originals remain in your local library.</p>
        <p class="privacy-note">For sensitive information, choose opaque Cover. Blur and Pixelate may leave details recognizable.</p>
        <a class="inline-link" href="/privacy/">Read the privacy details <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="closing-section" aria-labelledby="closing-title">
    <div class="shell closing-layout">
      <div>
        <h2 id="closing-title">Take a shnapp.<br />Make it clear.</h2>
        <p>Built for Windows 11, ready when you need to show something.</p>
      </div>
      <div class="closing-actions">
        <a class="button button-light" href="/download/">Get Shnapp <span aria-hidden="true">↗</span></a>
        <a class="closing-link" href={feedbackHref} target={distribution.publicRepository ? '_blank' : undefined} rel={distribution.publicRepository ? 'noopener noreferrer' : undefined}>{downloadsAvailable ? 'Help shape Shnapp' : 'Help shape the preview'}</a>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  const workflowVideo = document.querySelector<HTMLVideoElement>('[data-workflow-video]');
  const videoStart = document.querySelector<HTMLButtonElement>('[data-video-start]');
  videoStart?.addEventListener('click', async () => {
    if (!workflowVideo) return;
    try {
      await workflowVideo.play();
      videoStart.hidden = true;
    } catch {
      videoStart.textContent = 'Video unavailable. Use the walkthrough below.';
      videoStart.disabled = true;
    }
  });
  workflowVideo?.addEventListener('play', () => { if (videoStart) videoStart.hidden = true; });

  const demo = document.querySelector('[data-workflow-demo]');
  if (demo) {
    const stepButtons = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-step-button]'));
    const scenes = Array.from(demo.querySelectorAll<HTMLElement>('[data-scene]'));
    const playButton = demo.querySelector<HTMLButtonElement>('[data-demo-play]');
    const playLabel = demo.querySelector<HTMLElement>('[data-play-label]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let playing = false;
    let timer: number | undefined;

    const showStep = (index: number) => {
      current = index;
      stepButtons.forEach((button, position) => {
        const active = position === index;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      scenes.forEach((scene, position) => { scene.hidden = position !== index; });
    };

    const pause = (finished = false) => {
      window.clearTimeout(timer);
      timer = undefined;
      playing = false;
      playButton?.setAttribute('aria-pressed', 'false');
      if (playLabel) playLabel.textContent = finished ? 'Replay the walkthrough' : 'Play the walkthrough';
    };

    const advance = () => {
      if (!playing) return;
      if (current === scenes.length - 1) { pause(true); return; }
      showStep(current + 1);
      timer = window.setTimeout(advance, 3200);
    };

    stepButtons.forEach((button, index) => button.addEventListener('click', () => {
      pause();
      showStep(index);
    }));

    playButton?.addEventListener('click', () => {
      if (playing) { pause(); return; }
      if (reducedMotion.matches) return;
      showStep(0);
      playing = true;
      playButton.setAttribute('aria-pressed', 'true');
      if (playLabel) playLabel.textContent = 'Pause the walkthrough';
      timer = window.setTimeout(advance, 3200);
    });

    reducedMotion.addEventListener('change', () => { if (reducedMotion.matches) pause(); });
  }
</script>
