---
import styles from '../styles/global.css?inline';

const github = 'https://github.com/Zettersten/shhnap';
const shortcuts = [
  {
    title: 'A window',
    keys: ['Ctrl', 'Shift', '4'],
    description: 'Pick an open window. Shnapp gives the finished capture a soft shadow.',
  },
  {
    title: 'A full screen',
    keys: ['Ctrl', 'Shift', '3'],
    description: 'Capture the display beneath your pointer in one move.',
  },
  {
    title: 'A region',
    keys: ['Ctrl', 'Shift', '2'],
    description: 'Drag a rectangle around exactly what you need.',
  },
];

const capabilities = [
  {
    title: 'Say it in a sentence',
    description: 'Add text or numbered steps, then choose the type, size, weight, and colors that make your point clear.',
  },
  {
    title: 'Point to the detail',
    description: 'Draw lines with arrowheads at either end, or mark an area with a rectangle, square, ellipse, or circle.',
  },
  {
    title: 'Choose how to hide a detail',
    description: 'Use opaque Cover for sensitive details. Blur and Pixelate offer visual obscuring when that is enough.',
  },
  {
    title: 'Finish and move on',
    description: 'Crop, undo a change, copy to the clipboard, or save a PNG wherever you like.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6faff" />
    <meta name="description" content="Shnapp is a simple Windows 11 screenshot app. Capture a window, display, or region; annotate it; then copy or save." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Shnapp — capture it, make your point" />
    <meta property="og:description" content="A simple screenshot app for Windows 11. Capture, annotate, copy, and save without getting sidetracked." />
    <meta property="og:url" content="https://shnapp.com/" />
    <meta property="og:image" content="https://shnapp.com/screenshots/editor.png" />
    <meta property="og:image:alt" content="The Shnapp screenshot editor" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="favicon.ico" sizes="any" />
    <link rel="canonical" href="https://shnapp.com/" />
    <style is:global set:html={styles} />
    <title>Shnapp — Capture it. Make your point.</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="./" aria-label="Shnapp home">
          <img src="assets/logo.png" alt="Shnapp" width="137" height="43" />
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="#how-it-works">How it works</a>
          <a href="#tools">Tools</a>
          <a href="#library">Library</a>
        </nav>
        <a class="header-link" href={github} target="_blank" rel="noopener noreferrer">
          View on GitHub
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M4.5 10h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="shell hero-inner">
          <div class="hero-copy">
            <h1 id="hero-heading">Capture it.<br /><span>Make your point.</span></h1>
            <p class="hero-description">Shnapp is a simple screenshot app for Windows 11. Press a shortcut, add just enough context, then copy or save.</p>
            <div class="hero-actions">
              <a class="button button-primary" href={github} target="_blank" rel="noopener noreferrer">
                Explore Shnapp on GitHub
                <svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M4.5 10h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
              <a class="text-link" href="#how-it-works">See how it works <span aria-hidden="true">↓</span></a>
            </div>
            <p class="hero-note">An early preview for Windows 11. Built for x64 and ARM64.</p>
          </div>
          <figure class="hero-preview">
            <div class="preview-canvas">
              <a href="screenshots/editor.png" aria-label="View a full-size screenshot of the Shnapp editor">
                <img src="screenshots/editor.png" alt="The Shnapp editor showing a captured image and contextual text options" width="1376" height="843" fetchpriority="high" />
              </a>
            </div>
            <figcaption><span class="caption-dot" aria-hidden="true"></span> The editor after a capture. Actual app screenshot with sample content.</figcaption>
          </figure>
        </div>
      </section>

      <div class="proof-bar" aria-label="Shnapp at a glance">
        <div class="shell proof-inner">
          <span>Made for Windows 11</span>
          <span>Ready from the tray</span>
          <span>No account for the core flow</span>
        </div>
      </div>

      <section class="shortcuts-section" id="how-it-works" aria-labelledby="shortcuts-heading">
        <div class="shell">
          <div class="section-intro">
            <h2 id="shortcuts-heading">A shnapp starts with a shortcut.</h2>
            <p>Shnapp waits quietly in the tray. Choose what to capture and the editor appears right after.</p>
          </div>
          <div class="shortcut-list">
            {shortcuts.map((shortcut) => (
              <div class="shortcut-row">
                <div class="shortcut-title">{shortcut.title}</div>
                <div class="key-sequence" aria-label={`${shortcut.keys.join(' plus ')}`}>
                  {shortcut.keys.map((key, index) => <><kbd>{key}</kbd>{index < shortcut.keys.length - 1 && <span class="key-plus" aria-hidden="true">+</span>}</>)}
                </div>
                <p>{shortcut.description}</p>
              </div>
            ))}
          </div>
          <p class="shortcut-footnote">The free-form shortcut currently uses a rectangular selection.</p>
        </div>
      </section>

      <section class="tools-section" id="tools" aria-labelledby="tools-heading">
        <div class="shell tools-inner">
          <div class="tools-intro">
            <h2 id="tools-heading">Just enough to explain what matters.</h2>
            <p>Place a mark, then select it to adjust its settings in the side panel or resize it with drag handles. The capture stays in view while you work.</p>
          </div>
          <div class="capabilities">
            {capabilities.map((capability) => (
              <div class="capability">
                <h3>{capability.title}</h3>
                <p>{capability.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="library-section" id="library" aria-labelledby="library-heading">
        <div class="shell library-inner">
          <div class="library-visual">
            <a href="screenshots/library.png" aria-label="View a full-size screenshot of the Shnapp library">
              <img src="screenshots/library.png" alt="The Shnapp library showing saved screen captures" width="1106" height="463" loading="lazy" />
            </a>
            <p>Actual app screenshot with sample content</p>
          </div>
          <div class="library-copy">
            <h2 id="library-heading">Your shnapps, right where you left them.</h2>
            <p>Every capture lands in your local library, ready to find and reopen. Turn on launch at sign-in if you want Shnapp waiting in the tray whenever Windows starts.</p>
            <a class="inline-link" href="#privacy">See where your shnapps live <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="privacy-section" id="privacy" aria-labelledby="privacy-heading">
        <div class="shell privacy-inner">
          <div class="privacy-mark" aria-hidden="true"><img src="assets/icon.png" alt="" width="110" height="110" loading="lazy" /></div>
          <div>
            <h2 id="privacy-heading">Local is the default.</h2>
            <p>Your library and preferences live in your Windows user folder. Core capture and editing need no account or internet connection. Copied and exported PNGs include your chosen Cover, Blur, or Pixelate effect. Editable originals stay in your local library. Choose opaque Cover for private information; blur and pixelation may leave details recognizable.</p>
          </div>
        </div>
      </section>

      <section class="future-section" aria-labelledby="future-heading">
        <div class="shell future-inner">
          <div>
            <h2 id="future-heading">Still taking shape.</h2>
            <p>Shnapp is an early preview. Planned additions include captions, polygon shapes, output resizing, true free-form capture, and optional AI help for writing. They are not in the current app.</p>
          </div>
          <a class="inline-link" href={github} target="_blank" rel="noopener noreferrer">Follow the project on GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="closing-section" aria-labelledby="closing-heading">
        <div class="shell closing-inner">
          <div>
            <h2 id="closing-heading">Take a shnapp.<br />Make it clear.</h2>
            <p>The useful screenshot app for everyday Windows moments.</p>
          </div>
          <a class="button button-light" href={github} target="_blank" rel="noopener noreferrer">Explore the early preview <svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M4.5 10h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <a href="./" class="footer-brand" aria-label="Shnapp home"><img src="assets/logo.png" alt="Shnapp" width="104" height="32" loading="lazy" /></a>
        <p>Capture first. Think less.</p>
        <a href={github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </footer>
  </body>
</html>
