---
import SiteLayout from '../layouts/SiteLayout.astro';
import { distribution, downloadsAvailable, issueUrls } from '../config/distribution';

const feedbackHref = distribution.publicRepository
  ? issueUrls.chooser
  : 'mailto:' + distribution.contactEmail;

const captureModes = [
  { title: 'A region', key: '2', description: 'Drag a precise rectangle with live dimensions. Hold Shift for a square.' },
  { title: 'A window', key: '4', description: 'Choose the window you want. Shnapp frames it with a soft shadow.' },
  { title: 'A screen', key: '3', description: 'Capture the display beneath your pointer in one move.' },
  { title: 'A camera photo', key: '5', description: 'Preview a connected camera, take a still, and open it as an editable shnapp.' },
];
---

<SiteLayout
  title="Shnapp — Make the picture do the explaining"
  description="Shnapp captures a region, window, screen, or camera photo. Add callouts, magnify details, cover private information, and share a clear PNG."
  page="home"
>
  <section class="home-hero" aria-labelledby="hero-title">
    <img class="home-hero-art" src="/assets/shnapp-hero.png" alt="" width="1450" height="1086" fetchpriority="high" />
    <div class="home-hero-wash" aria-hidden="true"></div>
    <div class="shell home-hero-content">
      <img class="hero-icon" src="/assets/icon.png" alt="" width="92" height="92" />
      <h1 id="hero-title">Make the picture<br /><span>do the explaining.</span></h1>
      <p>Capture a region, window, screen, or camera photo. Add callouts, magnify what matters, cover private details, then copy or save a picture that is ready to share.</p>
      <div class="hero-actions">
        <a class="button button-hero" href="/download/">{downloadsAvailable ? 'Download Shnapp' : 'Explore the preview'} <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v10m-4-4 4 4 4-4M4 16h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        <a class="button button-hero-outline" href="#workflow">See how it works <span aria-hidden="true">↘</span></a>
      </div>
      <p class="hero-availability">Windows 11 · x64 and ARM64 · {downloadsAvailable ? 'Available now' : 'Early preview'}</p>
    </div>
    <p class="hero-art-caption">Illustrative scene. Actual app captures below.</p>
  </section>

  <section class="fact-band" aria-label="Shnapp at a glance">
    <div class="shell fact-band-inner">
      <p><span class="fact-dot" aria-hidden="true"></span>Screen and camera capture</p>
      <p><span class="fact-dot" aria-hidden="true"></span>Callouts and magnifier</p>
      <p><span class="fact-dot" aria-hidden="true"></span>No account for the core flow</p>
      <p><span class="fact-dot" aria-hidden="true"></span>Searchable local library</p>
    </div>
  </section>

  <section class="feature-overview section-space" id="features" aria-labelledby="features-title">
    <div class="shell feature-overview-inner">
      <div class="feature-overview-intro">
        <h2 id="features-title">A clearer picture, start to finish.</h2>
        <p>Shnapp brings capture, editing, and your saved work into one quick flow. Explore the tools behind each step.</p>
      </div>
      <div class="feature-overview-list">
        <a href="#capture">
          <h3>Capture</h3>
          <p>Choose a region, window, display, or camera photo with a click or shortcut.</p>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M9 5h10v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a href="#editor">
          <h3>Explain</h3>
          <p>Point with numbered callouts, magnify details, and add text, steps, lines, or shapes.</p>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M9 5h10v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a href="#privacy">
          <h3>Protect</h3>
          <p>Use opaque Cover to remove a private detail from the picture you share.</p>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M9 5h10v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a href="#library">
          <h3>Keep</h3>
          <p>Copy or save the finished PNG; find and reopen the editable shnapp in your local library.</p>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M9 5h10v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="opening-section section-space" id="workflow" aria-labelledby="opening-title">
    <div class="shell">
      <div class="opening-copy">
        <h2 id="opening-title">A little context changes everything.</h2>
        <p>For a walkthrough, a visual note, or a quick explanation, Shnapp keeps the whole job in one place. Choose what to capture, add a mark, and get back to making.</p>
      </div>
      <div class="workflow-frame">
        <div class="workflow-frame-head"><span class="frame-light" aria-hidden="true"></span><span>Shnapp v2 editor</span></div>
        <img class="workflow-fallback" src="/screenshots/editor.png" alt="The Shnapp editor with an annotated fictional launch checklist" width="1920" height="1032" loading="lazy" />
        <p class="workflow-caption">The Shnapp v2 editor with fictional sample content.</p>
      </div>
      <div class="workflow-steps" aria-label="The Shnapp workflow">
        <div><span>1</span><h3>Capture</h3><p>Pick a window, display, region, or camera photo.</p></div>
        <div><span>2</span><h3>Make it clear</h3><p>Add the words, steps, shapes, or privacy cover you need.</p></div>
        <div><span>3</span><h3>Send it on</h3><p>Copy the finished image or save a PNG for later.</p></div>
      </div>
    </div>
  </section>

  <section class="feature-section editor-feature section-space" id="editor" aria-labelledby="editor-title">
    <div class="shell feature-layout">
      <div class="feature-copy">
        <h2 id="editor-title">The right detail, in the right place.</h2>
        <p>Shnapp puts your capture on the canvas and its tools close by. Add a mark, then adjust it without losing the thread.</p>
        <ul class="feature-points">
          <li><strong>Point it out.</strong> Numbered callouts connect a detail on the capture to an explanation outside it.</li>
          <li><strong>Bring it closer.</strong> Magnify an area and adjust its zoom, size, and outline.</li>
          <li><strong>Make your mark.</strong> Add rich text, numbered steps, lines, arrows, and shapes.</li>
          <li><strong>Keep control.</strong> Crop, group and move marks, or nudge a selection one pixel at a time.</li>
        </ul>
        <a class="arrow-link" href="/download/">{downloadsAvailable ? 'Get Shnapp' : 'See the preview'} <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="feature-visual editor-visual">
        <a href="/screenshots/editor.png" aria-label="Open a full-size screenshot of the Shnapp editor"><img src="/screenshots/editor.png" alt="Actual Shnapp editor showing a fictional launch checklist with numbered steps and the selected step's font and color options" width="1920" height="1032" loading="lazy" /></a>
        <figcaption>Actual app screenshot with fictional sample content.</figcaption>
      </figure>
    </div>
  </section>

  <section class="capture-section section-space" id="capture" aria-labelledby="capture-title">
    <div class="shell">
      <div class="capture-heading"><h2 id="capture-title">Four ways to capture.<br />One place to finish.</h2><p>Shnapp waits in the Windows tray. The main Capture button starts a rectangular region; its separate arrow offers a window, display, or camera photo. Shortcuts work while you are in another app.</p></div>
      <div class="capture-list">
        {captureModes.map((mode) => (
          <div class="capture-row">
            <h3>{mode.title}</h3>
            <p>{mode.description}</p>
            <span class="shortcut" aria-label={'Control plus Shift plus ' + mode.key}><kbd>Ctrl</kbd><span aria-hidden="true">+</span><kbd>Shift</kbd><span aria-hidden="true">+</span><kbd>{mode.key}</kbd></span>
          </div>
        ))}
      </div>
      <div class="camera-spotlight" aria-labelledby="camera-title">
        <div class="camera-spotlight-copy">
          <svg class="camera-spotlight-icon" viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M7 13h6l2.5-3h9l2.5 3h6a3 3 0 0 1 3 3v16a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V16a3 3 0 0 1 3-3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><circle cx="20" cy="23" r="6" stroke="currentColor" stroke-width="2" /></svg>
          <h3 id="camera-title">A camera photo is a shnapp, too.</h3>
          <p>Press Ctrl+Shift+5 or choose Camera photo from the Capture menu. Pick a connected camera, frame the shot in a live preview, and take a still photo. It opens ready to annotate. You can also add another camera photo to the editor as a movable layer and crop it there.</p>
          <p class="camera-availability">Camera actions are available when a camera is connected. Choose your preferred camera in Settings.</p>
        </div>
        <ol class="camera-flow" aria-label="Camera photo workflow">
          <li><span>1</span><strong>Preview</strong><small>Frame the photo</small></li>
          <li><span>2</span><strong>Capture</strong><small>Open an editable shnapp</small></li>
          <li><span>3</span><strong>Layer</strong><small>Add and crop another photo</small></li>
        </ol>
      </div>
      <figure class="capture-app-figure">
        <a href="/screenshots/empty-library.png" aria-label="Open a full-size screenshot of Shnapp before the first capture"><img src="/screenshots/empty-library.png" alt="Actual Shnapp empty library with the central Capture a region button and its separate dropdown arrow" width="1280" height="900" loading="lazy" /></a>
        <figcaption>Start with a region, or use the arrow for a window, display, or camera photo.</figcaption>
      </figure>
    </div>
  </section>

  <section class="feature-section library-feature section-space" id="library" aria-labelledby="library-title">
    <div class="shell feature-layout feature-layout-reverse">
      <figure class="feature-visual library-visual">
        <a href="/screenshots/library.png" aria-label="Open a full-size screenshot of the Shnapp library"><img src="/screenshots/library.png" alt="Actual Shnapp library showing fictional saved captures, search, sorting, and thumbnail controls" width="1106" height="793" loading="lazy" /></a>
        <figcaption>Actual app screenshot with fictional sample content.</figcaption>
      </figure>
      <div class="feature-copy">
        <h2 id="library-title">A good capture is worth finding again.</h2>
        <p>Saved shnapps land in your local library, ready to search, sort, reopen, or share. Choose the thumbnail size that makes browsing feel right, or press Ctrl+A to select every result.</p>
        <p>When you revisit an image, the canvas and your marks are ready for another pass.</p>
        <a class="arrow-link" href="/privacy/">Where your captures live <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="feature-section settings-feature section-space" id="settings" aria-labelledby="settings-title">
    <div class="shell feature-layout">
      <div class="feature-copy">
        <h2 id="settings-title">Set it once. Keep moving.</h2>
        <p>Choose how Shnapp starts, copies new captures, and frames captured windows. Pick a connected camera or let Shnapp choose automatically. Assign Print Screen to full-screen, window, or region capture, change the theme, and find your local library path in one place.</p>
        <p>Preferences save as you change them. About &amp; Updates shows the installed version and any available release, while Feedback keeps report links close.</p>
        <a class="arrow-link" href="/download/">Get Shnapp <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="feature-visual settings-visual">
        <a href="/screenshots/settings-general.png" aria-label="Open a full-size screenshot of Shnapp settings"><img src="/screenshots/settings-general.png" alt="Actual Shnapp General settings showing the camera source, capture preferences, and Ctrl+Shift+5 camera photo shortcut" width="1280" height="900" loading="lazy" /></a>
        <figcaption>Camera source and shortcuts in Settings. <a href="/screenshots/settings-about.png">See About &amp; Updates <span aria-hidden="true">↗</span></a></figcaption>
      </figure>
    </div>
  </section>

  <section class="privacy-feature section-space" id="privacy" aria-labelledby="privacy-title">
    <div class="shell privacy-feature-inner">
      <div class="privacy-symbol" aria-hidden="true"><img src="/assets/icon.png" alt="" width="130" height="130" loading="lazy" /></div>
      <div class="privacy-feature-copy">
        <h2 id="privacy-title">Your work stays yours.</h2>
        <p>The core capture and editing flow needs no account or internet connection. Your library and preferences stay in your Windows user folder. Use opaque Cover when sensitive details need to be removed from the image you share.</p>
        <a class="arrow-link arrow-link-light" href="/privacy/">Read the privacy details <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="faq-section section-space" aria-labelledby="faq-title">
    <div class="shell faq-layout">
      <div class="faq-intro"><h2 id="faq-title">Good to know.</h2><p>A few practical answers before your first shnapp.</p></div>
      <div class="faq-list">
        <details><summary>What can Shnapp capture?</summary><p>The main Capture button starts a rectangular region capture. Its attached arrow offers a window, the screen beneath your pointer, or a camera photo when a camera is connected. The desktop freezes during a screen selection; Camera opens a live preview.</p></details>
        <details><summary>Do I need an account?</summary><p>No. Capture, edit, copy, and save work without an account or internet connection.</p></details>
        <details><summary>How do I install it?</summary><p>Choose the x64 or ARM64 direct download on the <a href="/download/">download page</a> and follow the steps shown for the current release. Portable ZIP packages and Scoop are also available.</p></details>
        <details><summary>Can I hide sensitive information?</summary><p>Use opaque Cover before sharing the finished PNG. Blur and Pixelate are visual obscuring tools and may leave details recognizable. The editable original remains in your local library.</p></details>
      </div>
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-title">
    <div class="shell final-cta-inner">
      <div><h2 id="final-title">Ready to make it clear?</h2><p>Capture the moment. Add the context. Share the picture.</p></div>
      <div class="final-actions"><a class="button button-final" href="/download/">{downloadsAvailable ? 'Download Shnapp' : 'Explore the preview'} <span aria-hidden="true">↗</span></a><a href={feedbackHref} target={distribution.publicRepository ? '_blank' : undefined} rel={distribution.publicRepository ? 'noopener noreferrer' : undefined}>Help shape Shnapp</a></div>
    </div>
  </section>
</SiteLayout>
