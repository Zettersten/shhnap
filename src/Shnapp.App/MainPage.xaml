                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8A0;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                </CommandBar>
            </Grid>
        </Grid>
        <Grid x:Name="LibraryRoot" Grid.Row="2" Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}"
            Padding="20,20,20,16" SizeChanged="LibraryRoot_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,16" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="LibrarySearch" HorizontalAlignment="Stretch"
                        QueryIcon="Find" PlaceholderText="Search shnapps" TextChanged="LibrarySearch_TextChanged"
                        QuerySubmitted="LibrarySearch_QuerySubmitted" KeyDown="LibrarySearch_KeyDown"
                        ToolTipService.ToolTip="Search by title, date, dimensions, or capture type"
                        AutomationProperties.Name="Search library" AutomationProperties.AutomationId="LibrarySearch" />
                    <Button x:Name="LibraryDeleteSelected" Grid.Column="1" Height="36" Padding="10,0"
                        Visibility="Collapsed" Click="LibraryDeleteSelected_Click"
                        AutomationProperties.Name="Delete selected shnapps" AutomationProperties.AutomationId="LibraryDeleteSelected">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <SymbolIcon Symbol="Delete" />
                            <TextBlock x:Name="LibrarySelectionCount" Text="Delete 0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <DropDownButton x:Name="LibrarySortButton" Height="36" Padding="10,0"
                        ToolTipService.ToolTip="Sort library by date, name, file size, or dimensions"
                        AutomationProperties.Name="Sort library" AutomationProperties.AutomationId="LibrarySortButton">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8CB;" FontSize="16" />
                            <TextBlock x:Name="LibrarySortLabel" Text="Newest first" VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <RadioMenuFlyoutItem Text="Date" Tag="Date" GroupName="LibrarySort" IsChecked="True" Click="LibrarySortField_Click" />
                                <RadioMenuFlyoutItem Text="Name" Tag="Name" GroupName="LibrarySort" Click="LibrarySortField_Click" />
                                <RadioMenuFlyoutItem Text="File size" Tag="FileSize" GroupName="LibrarySort" Click="LibrarySortField_Click" />
                                <RadioMenuFlyoutItem Text="Dimensions (pixel area)" Tag="Dimensions" GroupName="LibrarySort" Click="LibrarySortField_Click" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="LibrarySortDescending" Text="Descending order" IsChecked="True"
                                    Click="LibrarySortDescending_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="LibrarySizeButton" Width="36" Height="36" Padding="0"
                        ToolTipService.ToolTip="Thumbnail size" AutomationProperties.Name="Thumbnail size"
                        AutomationProperties.AutomationId="LibrarySizeButton">
                        <Button.Content><FontIcon Glyph="&#xE8A7;" FontSize="16" /></Button.Content>
                        <Button.Flyout>
                            <MenuFlyout>
                                <RadioMenuFlyoutItem Text="Small" Tag="0" GroupName="LibrarySize" Click="LibrarySize_Click" />
                                <RadioMenuFlyoutItem Text="Medium" Tag="1" GroupName="LibrarySize" Click="LibrarySize_Click" />
                                <RadioMenuFlyoutItem Text="Large" Tag="2" GroupName="LibrarySize" IsChecked="True" Click="LibrarySize_Click" />
                                <RadioMenuFlyoutItem Text="Extra large" Tag="3" GroupName="LibrarySize" Click="LibrarySize_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <ToggleButton x:Name="LibraryGridMode" Width="36" Height="36" Padding="0" IsChecked="True"
                        Click="LibraryGridMode_Click" ToolTipService.ToolTip="Grid view"
                        AutomationProperties.Name="Grid view" AutomationProperties.AutomationId="LibraryGridMode">
                        <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                    </ToggleButton>
                    <ToggleButton x:Name="LibraryListMode" Width="36" Height="36" Padding="0"
                        Click="LibraryListMode_Click" ToolTipService.ToolTip="List view"
                        AutomationProperties.Name="List view" AutomationProperties.AutomationId="LibraryListMode">
                        <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                    </ToggleButton>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2">
                <GridView x:Name="LibraryGrid" ItemsSource="{x:Bind ViewModel.Library}"
                    Padding="0,0,0,64" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                    SelectionMode="None" IsItemClickEnabled="True" ItemClick="LibraryCard_ItemClick"
                    GotFocus="LibraryGrid_GotFocus" LostFocus="LibraryGrid_LostFocus"
