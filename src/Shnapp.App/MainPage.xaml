                                    <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="White" />
                                    <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPressed" Color="White" />
                                    <SolidColorBrush x:Key="AppBarToggleButtonCheckGlyphForegroundChecked" Color="White" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Default">
                                    <SolidColorBrush x:Key="AppBarToggleButtonBackgroundChecked" Color="#0A84FF" />
                                    <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" Color="#0878EA" />
                                    <SolidColorBrush x:Key="AppBarToggleButtonBackgroundCheckedPressed" Color="#0668CC" />
                                    <SolidColorBrush x:Key="AppBarToggleButtonForegroundChecked" Color="White" />
                                    <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="AppBarToggleButtonForegroundCheckedPressed" Color="White" />
                                    <SolidColorBrush x:Key="AppBarToggleButtonCheckGlyphForegroundChecked" Color="White" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
