                        AutomationProperties.Name="Sort library" AutomationProperties.AutomationId="LibrarySortButton">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8CB;" FontSize="16" />
                            <TextBlock x:Name="LibrarySortLabel" Text="Newest first" VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <RadioMenuFlyoutItem Text="Date" Tag="Date" GroupName="LibrarySort" IsChecked="True" Click="LibrarySortField_Click" />
                                <RadioMenuFlyoutItem Text="Name" Tag="Name" GroupName="LibrarySort" Click="LibrarySortField_Click" />
                                <RadioMenuFlyoutItem Text="File size" Tag="FileSize" GroupName="LibrarySort" Click="LibrarySortField_Click" />
                                <RadioMenuFlyoutItem Text="Dimensions (pixel area)" Tag="Dimensions" GroupName="LibrarySort" Click="LibrarySortField_Click" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="LibrarySortDescending" Text="Descending order" IsChecked="True"
                                    Click="LibrarySortDescending_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button CornerRadius="8" x:Name="LibrarySizeButton" Width="36" Height="36" Padding="0"
