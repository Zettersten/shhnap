                        <Button x:Name="LibraryEmptyClear" Content="Clear search" Click="LibraryClearSearch_Click"
                            HorizontalAlignment="Center" Visibility="Collapsed" />
                        <StackPanel x:Name="LibraryEmptyShortcuts" Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Ctrl+Shift+4    Window" FontFamily="Cascadia Mono" FontSize="12" />
                            <TextBlock Text="Ctrl+Shift+3    Full screen" FontFamily="Cascadia Mono" FontSize="12" />
                            <TextBlock Text="Ctrl+Shift+2    Region" FontFamily="Cascadia Mono" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Height="36" Padding="20,4" ColumnSpacing="16" Background="{ThemeResource ShnappChromeBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <DropDownButton x:Name="ZoomPresetButton" Content="100%" Height="24" MinWidth="60"
                FontSize="11" Padding="5,0" Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                ToolTipService.ToolTip="Canvas zoom" AutomationProperties.AutomationId="ZoomPresets"
                AutomationProperties.HelpText="Canvas zoom. Choose a preset level.">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Fit canvas" Tag="fit" Click="ZoomPreset_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="10%" Tag="0.1" Click="ZoomPreset_Click" />
                        <MenuFlyoutItem Text="25%" Tag="0.25" Click="ZoomPreset_Click" />
                        <MenuFlyoutItem Text="50%" Tag="0.5" Click="ZoomPreset_Click" />
                        <MenuFlyoutItem Text="75%" Tag="0.75" Click="ZoomPreset_Click" />
                        <MenuFlyoutItem Text="100%" Tag="1" Click="ZoomPreset_Click" />
                        <MenuFlyoutItem Text="125%" Tag="1.25" Click="ZoomPreset_Click" />
                        <MenuFlyoutItem Text="150%" Tag="1.5" Click="ZoomPreset_Click" />
                        <MenuFlyoutItem Text="200%" Tag="2" Click="ZoomPreset_Click" />
                        <MenuFlyoutItem Text="400%" Tag="4" Click="ZoomPreset_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="LibraryStatus" />
            <TextBlock Grid.Column="1" Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ShnappStatus" />
            <TextBlock x:Name="DocumentMetadataText" Grid.Column="2" Text="{x:Bind ViewModel.DocumentMetadata, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                AutomationProperties.AutomationId="DocumentMetadata" />
        </Grid>
    </Grid>
</Page>
