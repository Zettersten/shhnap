                            <Setter Property="Margin" Value="0" />
                            <Setter Property="FocusVisualMargin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="editor:LibraryEntry">
                            <Grid Height="{x:Bind ListRowHeight, Mode=OneWay}" Padding="16,0" ColumnSpacing="12"
                                Background="Transparent"
                                Tag="{x:Bind}" RightTapped="LibraryCard_RightTapped"
                                ToolTipService.ToolTip="{x:Bind MetadataDescription}"
                                AutomationProperties.Name="{x:Bind MetadataDescription}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="{x:Bind ListThumbnailWidth, Mode=OneWay}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{x:Bind ListDateWidth, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ListDimensionsWidth, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ListSizeWidth, Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Width="32" MinWidth="0" Height="32" Padding="0"
                                    VerticalAlignment="Center" Tag="{x:Bind}"
                                    IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                    Checked="LibrarySelectionCheck_Changed" Unchecked="LibrarySelectionCheck_Changed"
                                    Tapped="LibrarySelectionCheck_Tapped"
                                    ToolTipService.ToolTip="Select shnapp"
                                    AutomationProperties.Name="{x:Bind SelectionLabel}" />
                                <Border Grid.Column="1" Height="48" VerticalAlignment="Center"
                                    Background="{ThemeResource ShnappPreviewBrush}" CornerRadius="4"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Image Source="{x:Bind Preview}" Stretch="Uniform" Margin="2"
                                        Tag="{x:Bind}" CanDrag="{x:Bind CanDrag, Mode=OneWay}" DragStarting="LibraryPreview_DragStarting"
                                        Tapped="LibraryPreview_Tapped" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind CaptureType}" FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind WideListVisibility, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind CompactMetadataSummary}" FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind CompactListVisibility, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{x:Bind DateText}" VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind WideListVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind DimensionsText}" VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind WideListVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind FileSizeText}" VerticalAlignment="Center"
                                    HorizontalAlignment="Right" FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind WideListVisibility, Mode=OneWay}" />
                                <Border Grid.ColumnSpan="6" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}" Opacity="0.45"
                                    Visibility="{x:Bind SeparatorVisibility, Mode=OneWay}" />
