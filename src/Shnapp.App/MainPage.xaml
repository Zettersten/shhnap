<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Shnapp.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:editor="using:Shnapp.App.Editor"
    xmlns:local="using:Shnapp.App"
    FontFamily="Segoe UI Variable Text"
    Background="Transparent">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyAccelerator_Invoked" />
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAccelerator_Invoked" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoAccelerator_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="RedoAccelerator_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusLibrarySearch_Invoked" />
        <KeyboardAccelerator Key="G" Modifiers="Control,Shift" Invoked="ToggleGalleryAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    <Grid KeyDown="Page_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True"
            Background="{ThemeResource ShnappChromeBrush}">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="0" Margin="16,0,16,0" MinHeight="48" VerticalAlignment="Center">
                    <AppBarButton x:Name="BackButton" Label="Back" LabelPosition="Collapsed" Width="48" Height="48"
                        IsEnabled="False" VerticalAlignment="Center"
                        Click="Back_Click" ToolTipService.ToolTip="Back · Alt+Left"
                        AutomationProperties.Name="Back" AutomationProperties.AutomationId="NavigateBack">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE72B;" FontSize="14" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="ForwardButton" Label="Forward" LabelPosition="Collapsed" Width="48" Height="48"
                        IsEnabled="False" VerticalAlignment="Center"
                        Click="Forward_Click" ToolTipService.ToolTip="Forward · Alt+Right"
                        AutomationProperties.Name="Forward" AutomationProperties.AutomationId="NavigateForward">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE72A;" FontSize="14" /></AppBarButton.Icon>
                    </AppBarButton>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                        <TextBlock Text="Library" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="LibraryResultCount" Text="0 shnapps" FontSize="14" VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <Grid Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}">
                        <Button x:Name="DocumentTitleButton" Click="DocumentTitleButton_Click" Padding="8,0" Height="40"
                            Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Rename shnapp"
                            AutomationProperties.Name="Rename shnapp" AutomationProperties.AutomationId="DocumentTitle">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                    MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                <FontIcon Glyph="&#xE70F;" FontSize="14" Opacity="0.72" />
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="DocumentTitleEditor" Visibility="Collapsed" Width="240" Height="40" Margin="8,0,0,0" MaxLength="120"
                            KeyDown="DocumentTitleEditor_KeyDown" LostFocus="DocumentTitleEditor_LostFocus"
                            AutomationProperties.Name="Shnapp title" AutomationProperties.AutomationId="DocumentTitleEditor" />
                    </Grid>
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton x:Name="NewShnappButton" Label="New shnapp" Icon="Camera" CornerRadius="8" FocusVisualMargin="3"
                MinWidth="130"
                Loaded="NewShnappButton_Loaded" Unloaded="NewShnappButton_Unloaded"
                ToolTipService.ToolTip="Capture a window, display, or region"
                AutomationProperties.AutomationId="NewShnapp">
                <AppBarButton.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <ImageBrush x:Key="AppBarButtonBackground" Stretch="Fill">
                                    <ImageBrush.ImageSource><SvgImageSource UriSource="ms-appx:///Assets/NewShnappButton.svg" /></ImageBrush.ImageSource>
                                </ImageBrush>
                                <ImageBrush x:Key="AppBarButtonBackgroundPointerOver" Stretch="Fill">
                                    <ImageBrush.ImageSource><SvgImageSource UriSource="ms-appx:///Assets/NewShnappButtonHover.svg" /></ImageBrush.ImageSource>
                                </ImageBrush>
                                <ImageBrush x:Key="AppBarButtonBackgroundPressed" Stretch="Fill">
                                    <ImageBrush.ImageSource><SvgImageSource UriSource="ms-appx:///Assets/NewShnappButtonPressed.svg" /></ImageBrush.ImageSource>
                                </ImageBrush>
                                <SolidColorBrush x:Key="AppBarButtonForeground" Color="White" />
                                <SolidColorBrush x:Key="AppBarButtonForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="AppBarButtonForegroundPressed" Color="White" />
                                <SolidColorBrush x:Key="AppBarButtonSubItemChevronForeground" Color="White" />
                                <SolidColorBrush x:Key="AppBarButtonSubItemChevronForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="AppBarButtonSubItemChevronForegroundPressed" Color="White" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Default">
                                <ImageBrush x:Key="AppBarButtonBackground" Stretch="Fill">
                                    <ImageBrush.ImageSource><SvgImageSource UriSource="ms-appx:///Assets/NewShnappButton.svg" /></ImageBrush.ImageSource>
                                </ImageBrush>
                                <ImageBrush x:Key="AppBarButtonBackgroundPointerOver" Stretch="Fill">
                                    <ImageBrush.ImageSource><SvgImageSource UriSource="ms-appx:///Assets/NewShnappButtonHover.svg" /></ImageBrush.ImageSource>
                                </ImageBrush>
                                <ImageBrush x:Key="AppBarButtonBackgroundPressed" Stretch="Fill">
                                    <ImageBrush.ImageSource><SvgImageSource UriSource="ms-appx:///Assets/NewShnappButtonPressed.svg" /></ImageBrush.ImageSource>
                                </ImageBrush>
                                <SolidColorBrush x:Key="AppBarButtonForeground" Color="White" />
                                <SolidColorBrush x:Key="AppBarButtonForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="AppBarButtonForegroundPressed" Color="White" />
                                <SolidColorBrush x:Key="AppBarButtonSubItemChevronForeground" Color="White" />
                                <SolidColorBrush x:Key="AppBarButtonSubItemChevronForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="AppBarButtonSubItemChevronForegroundPressed" Color="White" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <SolidColorBrush x:Key="AppBarButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                                <SolidColorBrush x:Key="AppBarButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                <SolidColorBrush x:Key="AppBarButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                <SolidColorBrush x:Key="AppBarButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                <SolidColorBrush x:Key="AppBarButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                <SolidColorBrush x:Key="AppBarButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                <SolidColorBrush x:Key="AppBarButtonSubItemChevronForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                <SolidColorBrush x:Key="AppBarButtonSubItemChevronForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                <SolidColorBrush x:Key="AppBarButtonSubItemChevronForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </AppBarButton.Resources>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Window" Tag="Window" Click="Capture_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE78B;" FontSize="16" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number4" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Full screen" Tag="FullScreen" Click="Capture_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" FontSize="16" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number3" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Free form (rectangle)" Tag="Region" Click="Capture_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A8;" FontSize="16" /></MenuFlyoutItem.Icon>
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number2" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Label="Library" Icon="Pictures" Click="Library_Click" AutomationProperties.AutomationId="OpenLibrary" />
            <AppBarSeparator />
            <AppBarButton x:Name="CopyButton" Label="Copy" Icon="Copy" Click="Copy_Click"
                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}" AutomationProperties.AutomationId="CopyShnapp"
                ToolTipService.ToolTip="Copy flattened image · Ctrl+C" />
            <AppBarButton x:Name="SaveButton" Label="Save" Icon="Save" Click="Save_Click"
                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}" AutomationProperties.AutomationId="SaveShnapp"
                ToolTipService.ToolTip="Save PNG to a chosen location · Ctrl+S" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Recent shnapps" Icon="Pictures" Click="ToggleGallery_Click"
                    Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                    AutomationProperties.AutomationId="ShowGallery"
                    ToolTipService.ToolTip="Show the gallery · Ctrl+Shift+G" />
                <AppBarButton Label="Share" Icon="Share" Click="Share_Click"
                    Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                    AutomationProperties.AutomationId="ShareShnapp"
                    ToolTipService.ToolTip="Share this shnapp with another app" />
                <AppBarButton Label="Copy full path" Icon="Copy" Click="CopyCurrentPath_Click"
                    Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                    AutomationProperties.AutomationId="CopyCurrentShnappPath"
                    ToolTipService.ToolTip="Copy the saved PNG's full path" />
                <AppBarButton Label="Delete shnapp" Icon="Delete" Click="DeleteCurrent_Click"
                    Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                    AutomationProperties.AutomationId="DeleteCurrentShnapp"
                    ToolTipService.ToolTip="Delete this shnapp from your Library" />
                <AppBarButton Label="Settings" Icon="Setting" Click="Settings_Click" AutomationProperties.AutomationId="OpenSettings" />
                <AppBarButton Label="Quit Shnapp" Icon="Cancel" Click="Quit_Click" AutomationProperties.AutomationId="QuitShnapp" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="20,0" />
        <Grid x:Name="EditorHost" Grid.Row="2" Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
            SizeChanged="EditorHost_SizeChanged"
            Background="{ThemeResource ShnappCanvasBrush}">
                    <local:EditorCursorHost x:Name="CanvasHost" Background="{ThemeResource ShnappCanvasBrush}"
                        SizeChanged="GalleryCanvasHost_SizeChanged"
                        PointerMoved="GalleryCanvasHost_PointerMoved" PointerExited="GalleryCanvasHost_PointerExited">
                        <canvas:CanvasControl x:Name="DrawingCanvas" Draw="Canvas_Draw" SizeChanged="Canvas_SizeChanged"
                            PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved"
                            PointerReleased="Canvas_PointerReleased" PointerCanceled="Canvas_PointerCanceled"
                            PointerCaptureLost="Canvas_PointerCaptureLost"
                            PointerEntered="Canvas_PointerEntered" PointerExited="Canvas_PointerExited"
                            PointerWheelChanged="Canvas_PointerWheelChanged"
                            DoubleTapped="Canvas_DoubleTapped" RightTapped="Canvas_RightTapped" AllowDrop="True"
                            DragOver="Canvas_DragOver" Drop="Canvas_Drop"
                            IsTabStop="True" AutomationProperties.Name="Shnapp annotation canvas"
                            AutomationProperties.AutomationId="ShnappCanvas" />
                        <Canvas x:Name="TextOverlay" />
                        <Canvas x:Name="CropOverlay" IsHitTestVisible="False">
                            <Border x:Name="CropTip" Visibility="Collapsed" Padding="12,8" CornerRadius="8"
                                Background="{ThemeResource ShnappPanelBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="CropPositionTip" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CropSizeTip" FontSize="12" Opacity="0.72" />
                                </StackPanel>
                            </Border>
                        </Canvas>
                        <Border x:Name="GalleryDock" Visibility="Collapsed" Width="80" Opacity="0"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                            Padding="8" CornerRadius="12"
                            Background="{ThemeResource ShnappToolbarBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            PointerMoved="GalleryDock_PointerMoved" PointerExited="GalleryDock_PointerExited"
                            PointerWheelChanged="GalleryDock_PointerWheelChanged"
                            ActualThemeChanged="GalleryDock_ActualThemeChanged"
                            AutomationProperties.Name="Recent shnapps gallery. Scroll to browse; drag a preview onto the canvas to add a copy.">
                            <Border.RenderTransform>
                                <TranslateTransform X="-96" />
                            </Border.RenderTransform>
                            <StackPanel Spacing="4">
                                <Button x:Name="GalleryPrevious" Width="58" Height="32" Padding="0"
                                    HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                                    Click="GalleryPrevious_Click" PointerWheelChanged="GalleryDock_PointerWheelChanged"
                                    AutomationProperties.Name="Previous gallery shnapps" AutomationProperties.AutomationId="GalleryPrevious">
                                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                                </Button>
                                <Canvas x:Name="GalleryDockItems" Width="58" />
                                <Button x:Name="GalleryNext" Width="58" Height="32" Padding="0"
                                    HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                                    Click="GalleryNext_Click" PointerWheelChanged="GalleryDock_PointerWheelChanged"
                                    AutomationProperties.Name="More gallery shnapps" AutomationProperties.AutomationId="GalleryNext">
                                    <FontIcon Glyph="&#xE70D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </local:EditorCursorHost>
                    <Border x:Name="InspectorPanel" Visibility="Visible"
                        Width="252" MaxHeight="560" Margin="12,64,12,12"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{ThemeResource ShnappChromeBrush}" CornerRadius="12"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        AutomationProperties.Name="Tool options">
                        <Border.Transitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromHorizontalOffset="24" />
                            </TransitionCollection>
                        </Border.Transitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Padding="12,12,12,16" Spacing="8">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon x:Name="InspectorToolIcon" Glyph="&#xE8B0;" FontSize="16"
                                            Foreground="{ThemeResource ShnappBlueBrush}" />
                                        <TextBlock x:Name="InspectorTitle" Text="Select" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock x:Name="InspectorHelp" Text="Click markup to move it. Press Delete to remove it."
                                        TextWrapping="Wrap" FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Grid x:Name="SelectGuideRow" Visibility="Collapsed" ColumnSpacing="10" RowSpacing="8"
                                    Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="SelectGuideFirstLabel" Text="Click" FontSize="11" FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SelectGuideFirstText" Grid.Column="1" Text="Choose an element"
                                        FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SelectGuideSecondLabel" Grid.Row="1" Text="Drag" FontSize="11" FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SelectGuideSecondText" Grid.Row="1" Grid.Column="1"
                                        Text="Move it or resize with handles" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="Arrows" FontSize="11" FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Nudge 1 px · Shift: 10 px"
                                        FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <Rectangle x:Name="InspectorSeparator" Height="1"
                                    Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                <StackPanel x:Name="CropOptionsRow" Visibility="Collapsed" Spacing="8">
                                    <TextBlock Text="Crop in pixels" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <NumberBox x:Name="CropXChoice" Header="X" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Compact"
                                            ValueChanged="CropNumber_Changed" Loaded="NumberBox_Loaded"
                                            AutomationProperties.Name="Crop X position in pixels" />
                                        <NumberBox x:Name="CropYChoice" Grid.Column="1" Header="Y" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Compact"
                                            ValueChanged="CropNumber_Changed" Loaded="NumberBox_Loaded"
                                            AutomationProperties.Name="Crop Y position in pixels" />
                                        <NumberBox x:Name="CropWidthChoice" Grid.Row="1" Header="Width" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact"
                                            ValueChanged="CropNumber_Changed" Loaded="NumberBox_Loaded"
                                            AutomationProperties.Name="Crop width in pixels" />
                                        <NumberBox x:Name="CropHeightChoice" Grid.Row="1" Grid.Column="1" Header="Height" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact"
                                            ValueChanged="CropNumber_Changed" Loaded="NumberBox_Loaded"
                                            AutomationProperties.Name="Crop height in pixels" />
                                    </Grid>
                                    <CheckBox x:Name="CropLockProportions" Content="Lock proportions" Click="CropLock_Click" />
                                    <ComboBox x:Name="CropRatioChoice" Header="Aspect ratio" HorizontalAlignment="Stretch"
                                        SelectedIndex="0" SelectionChanged="CropRatio_Changed">
                                        <ComboBoxItem Content="Free" Tag="Free" />
                                        <ComboBoxItem Content="1:1 · Square" Tag="1:1" />
                                        <ComboBoxItem Content="9:16 · Portrait" Tag="9:16" />
                                        <ComboBoxItem Content="16:9 · Wide" Tag="16:9" />
                                        <ComboBoxItem Content="5:7 · Print" Tag="5:7" />
                                        <ComboBoxItem Content="7:5 · Landscape" Tag="7:5" />
                                        <ComboBoxItem Content="4:3 · Classic" Tag="4:3" />
                                        <ComboBoxItem Content="3:2 · Photo" Tag="3:2" />
                                    </ComboBox>
                                    <Button HorizontalAlignment="Stretch" Click="ApplyCrop_Click"
                                        AutomationProperties.Name="Apply crop">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" />
                                            <TextBlock Text="Apply crop" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="RedactionModeRow" Visibility="Collapsed">
                                    <ComboBox x:Name="RedactionModeChoice" Header="Mode" SelectedIndex="0"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed">
                                        <ComboBoxItem Content="Cover" Tag="Solid" />
                                        <ComboBoxItem Content="Blur" Tag="Blur" />
                                        <ComboBoxItem Content="Pixelate" Tag="Pixelate" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="PrimaryColorRow" Visibility="Collapsed" Spacing="8">
                                    <TextBlock x:Name="PrimaryColorLabel" Text="Color" FontWeight="SemiBold" />
                                    <Button x:Name="PrimaryColorButton" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Choose annotation color">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border x:Name="PrimaryColorSwatch" Width="24" Height="24" CornerRadius="4"
                                                    Background="#E5484D" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                                <TextBlock Text="Choose color" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button.Content>
                                        <Button.Flyout>
                                            <Flyout Closed="ColorFlyout_Closed">
                                                <ColorPicker x:Name="PrimaryColorPicker" Color="#E5484D"
                                                    IsAlphaEnabled="False" ColorChanged="ColorOption_Changed" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="SecondaryColorRow" Visibility="Collapsed" Spacing="8">
                                    <TextBlock x:Name="SecondaryColorLabel" Text="Fill color" FontWeight="SemiBold" />
                                    <Button x:Name="SecondaryColorButton" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Choose fill or label color">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border x:Name="SecondaryColorSwatch" Width="24" Height="24" CornerRadius="4"
                                                    Background="#FFFFFF" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                                <TextBlock Text="Choose color" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button.Content>
                                        <Button.Flyout>
                                            <Flyout Closed="ColorFlyout_Closed">
                                                <ColorPicker x:Name="SecondaryColorPicker" Color="#FFFFFF"
                                                    IsAlphaEnabled="False" ColorChanged="ColorOption_Changed" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="StrokeWidthRow" Visibility="Collapsed">
                                    <NumberBox x:Name="StrokeSize" Header="Line width (px)" Value="3" Minimum="1" Maximum="24"
                                        SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="NumberOption_Changed"
                                        Loaded="NumberBox_Loaded" />
                                </StackPanel>
                                <StackPanel x:Name="FontFamilyRow" Visibility="Collapsed">
                                    <ComboBox x:Name="FontFamilyChoice" Header="Font" SelectedIndex="0"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed">
                                        <ComboBoxItem Content="Segoe UI Variable Text" Tag="Segoe UI Variable Text" />
                                        <ComboBoxItem Content="Arial" Tag="Arial" />
                                        <ComboBoxItem Content="Calibri" Tag="Calibri" />
                                        <ComboBoxItem Content="Georgia" Tag="Georgia" />
                                        <ComboBoxItem Content="Consolas" Tag="Consolas" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="FontWeightRow" Visibility="Collapsed">
                                    <ComboBox x:Name="FontWeightChoice" Header="Weight" SelectedIndex="2"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed">
                                        <ComboBoxItem Content="Regular" Tag="400" />
                                        <ComboBoxItem Content="Medium" Tag="500" />
                                        <ComboBoxItem Content="Semibold" Tag="600" />
                                        <ComboBoxItem Content="Bold" Tag="700" />
                                        <ComboBoxItem Content="Extra bold" Tag="800" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="ItalicRow" Visibility="Collapsed">
                                    <CheckBox x:Name="ItalicText" Content="Italic" Click="Options_Changed" />
                                </StackPanel>
                                <StackPanel x:Name="FontSizeRow" Visibility="Collapsed">
                                    <NumberBox x:Name="FontSizeChoice" Header="Text size (px)" Value="18" Minimum="8" Maximum="144"
                                        SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="NumberOption_Changed"
                                        Loaded="NumberBox_Loaded" />
                                </StackPanel>
                                <StackPanel x:Name="TextCharacterRow" Visibility="Collapsed" Spacing="8">
                                    <TextBlock Text="Characters" FontWeight="SemiBold" />
                                    <CheckBox x:Name="TextKerningChoice" Content="Kern letter pairs" IsChecked="True"
                                        Click="Options_Changed" AutomationProperties.AutomationId="TextKerningChoice" />
                                    <NumberBox x:Name="TextLetterSpacingChoice" Header="Letter spacing (px)" Value="0"
                                        Minimum="0" Maximum="50" SmallChange="1" SpinButtonPlacementMode="Compact"
                                        ValueChanged="NumberOption_Changed" Loaded="NumberBox_Loaded"
                                        AutomationProperties.AutomationId="TextLetterSpacingChoice" />
                                    <ComboBox x:Name="TextTransformChoice" Header="Text transform" SelectedIndex="0"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed"
                                        AutomationProperties.AutomationId="TextTransformChoice">
                                        <ComboBoxItem Content="As typed" Tag="None" />
