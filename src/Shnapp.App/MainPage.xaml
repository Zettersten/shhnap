<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Shnapp.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:editor="using:Shnapp.App.Editor"
    xmlns:local="using:Shnapp.App"
    FontFamily="Segoe UI Variable Text"
    Background="Transparent">
    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="CaptureSplitButtonStyle" TargetType="SplitButton" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="NewShnappSplitFill" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C138E3" Offset="0" />
                        <GradientStop Color="#7510AD" Offset="0.13" />
                        <GradientStop Color="#4B0585" Offset="0.36" />
                        <GradientStop Color="#430075" Offset="0.58" />
                        <GradientStop Color="#59078F" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="NewShnappSplitText" Color="White" />
                    <SolidColorBrush x:Key="CaptureButtonShadowBrush" Color="#3324004B" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrush" Color="#B0AD3CCF" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrushPointerOver" Color="#C8C85EE8" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrushPressed" Color="#90491A92" />
                    <SolidColorBrush x:Key="LibraryButtonOutlineBrush" Color="#6686ADD9" />
                    <SolidColorBrush x:Key="UpdateAttentionBrush" Color="#D6294D" />
                    <LinearGradientBrush x:Key="SplitButtonBackground" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C138E3" Offset="0" />
                        <GradientStop Color="#7510AD" Offset="0.13" />
                        <GradientStop Color="#4B0585" Offset="0.36" />
                        <GradientStop Color="#430075" Offset="0.58" />
                        <GradientStop Color="#59078F" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SplitButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D25AEC" Offset="0" />
                        <GradientStop Color="#8B24C1" Offset="0.13" />
                        <GradientStop Color="#5C1499" Offset="0.36" />
                        <GradientStop Color="#531085" Offset="0.58" />
                        <GradientStop Color="#7020A8" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SplitButtonBackgroundPressed" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#9329B4" Offset="0" />
                        <GradientStop Color="#61118F" Offset="0.13" />
                        <GradientStop Color="#3A006E" Offset="0.36" />
                        <GradientStop Color="#31005F" Offset="0.58" />
                        <GradientStop Color="#4A087B" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SplitButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="#F8E9FF" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="#A0210B54" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <LinearGradientBrush x:Key="NewShnappSplitFill" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C138E3" Offset="0" />
                        <GradientStop Color="#7510AD" Offset="0.13" />
                        <GradientStop Color="#4B0585" Offset="0.36" />
                        <GradientStop Color="#430075" Offset="0.58" />
                        <GradientStop Color="#59078F" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="NewShnappSplitText" Color="White" />
                    <SolidColorBrush x:Key="CaptureButtonShadowBrush" Color="#50200040" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrush" Color="#B0AD3CCF" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrushPointerOver" Color="#C8C85EE8" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrushPressed" Color="#90491A92" />
                    <SolidColorBrush x:Key="LibraryButtonOutlineBrush" Color="#6681A6DC" />
                    <SolidColorBrush x:Key="UpdateAttentionBrush" Color="#FF4968" />
                    <LinearGradientBrush x:Key="SplitButtonBackground" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C138E3" Offset="0" />
                        <GradientStop Color="#7510AD" Offset="0.13" />
                        <GradientStop Color="#4B0585" Offset="0.36" />
                        <GradientStop Color="#430075" Offset="0.58" />
                        <GradientStop Color="#59078F" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SplitButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D25AEC" Offset="0" />
                        <GradientStop Color="#8B24C1" Offset="0.13" />
                        <GradientStop Color="#5C1499" Offset="0.36" />
                        <GradientStop Color="#531085" Offset="0.58" />
                        <GradientStop Color="#7020A8" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SplitButtonBackgroundPressed" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#9329B4" Offset="0" />
                        <GradientStop Color="#61118F" Offset="0.13" />
                        <GradientStop Color="#3A006E" Offset="0.36" />
                        <GradientStop Color="#31005F" Offset="0.58" />
                        <GradientStop Color="#4A087B" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SplitButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="#F8E9FF" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="#A0210B54" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="NewShnappSplitFill" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NewShnappSplitText" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="CaptureButtonShadowBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="LibraryButtonOutlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="UpdateAttentionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SplitButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SplitButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyAccelerator_Invoked" />
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAccelerator_Invoked" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoAccelerator_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="RedoAccelerator_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusLibrarySearch_Invoked" />
        <KeyboardAccelerator Key="G" Modifiers="Control,Shift" Invoked="ToggleGalleryAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    <local:InteractiveCursorHost KeyDown="Page_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CommandBar x:Name="PrimaryCommandBar" Loaded="PrimaryCommandBar_Loaded"
            DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True"
            Background="{ThemeResource ShnappChromeBrush}">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="0" Margin="16,0,16,0" MinHeight="48" VerticalAlignment="Center">
                    <local:HandCursorAppBarButton CornerRadius="8" x:Name="BackButton" Label="Back" LabelPosition="Collapsed" Width="48" Height="48"
                        IsEnabled="False" VerticalAlignment="Center"
                        Click="Back_Click" ToolTipService.ToolTip="Back · Alt+Left"
                        AutomationProperties.Name="Back" AutomationProperties.AutomationId="NavigateBack">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE72B;" FontSize="14" /></AppBarButton.Icon>
                    </local:HandCursorAppBarButton>
                    <local:HandCursorAppBarButton CornerRadius="8" x:Name="ForwardButton" Label="Forward" LabelPosition="Collapsed" Width="48" Height="48"
                        IsEnabled="False" VerticalAlignment="Center"
                        Click="Forward_Click" ToolTipService.ToolTip="Forward · Alt+Right"
                        AutomationProperties.Name="Forward" AutomationProperties.AutomationId="NavigateForward">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE72A;" FontSize="14" /></AppBarButton.Icon>
                    </local:HandCursorAppBarButton>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                        <TextBlock Text="Library" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="LibraryResultCount" Text="0 shnapps" FontSize="14" VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <Grid Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}">
                        <Button CornerRadius="8" x:Name="DocumentTitleButton" Click="DocumentTitleButton_Click" Padding="8,0" Height="40"
                            Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Rename shnapp"
                            AutomationProperties.Name="Rename shnapp" AutomationProperties.AutomationId="DocumentTitle">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                    MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                <FontIcon Glyph="&#xE70F;" FontSize="14" Opacity="0.72" />
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="DocumentTitleEditor" Visibility="Collapsed" Width="240" Height="40" Margin="8,0,0,0" MaxLength="120"
                            KeyDown="DocumentTitleEditor_KeyDown" LostFocus="DocumentTitleEditor_LostFocus"
                            AutomationProperties.Name="Shnapp title" AutomationProperties.AutomationId="DocumentTitleEditor" />
                    </Grid>
                </StackPanel>
            </CommandBar.Content>
            <AppBarElementContainer Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                <Grid Width="168" Height="48" VerticalAlignment="Center" Translation="0,0,2">
                <local:HandCursorRegion x:Name="NewShnappCaptureShell" Width="168" Height="34" VerticalAlignment="Center" Background="Transparent">
                <Border Width="168" Height="34" CornerRadius="8" VerticalAlignment="Center"
                    Background="{ThemeResource CaptureButtonShadowBrush}" IsHitTestVisible="False">
                    <Border.RenderTransform><TranslateTransform Y="2" /></Border.RenderTransform>
                </Border>
                <local:HandCursorSplitButton x:Name="NewShnappButton" Width="168" Height="34" MinWidth="0" CornerRadius="8"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptureSplitButtonStyle}"
                    Click="NewShnappButton_Click"
                    ToolTipService.ToolTip="Capture a region · Ctrl+Shift+2"
                    Background="{ThemeResource NewShnappSplitFill}" Foreground="{ThemeResource NewShnappSplitText}"
                    AutomationProperties.Name="New shnapp" AutomationProperties.HelpText="Capture a region. Use the arrow for other capture options."
                    AutomationProperties.AutomationId="NewShnapp">
                    <SplitButton.Shadow><ThemeShadow /></SplitButton.Shadow>
                    <SplitButton.Resources>
                        <ResourceDictionary>
                            <x:Double x:Key="SplitButtonSecondaryButtonSize">34</x:Double>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <LinearGradientBrush x:Key="SplitButtonBackground" StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C138E3" Offset="0" />
                                        <GradientStop Color="#7510AD" Offset="0.13" />
                                        <GradientStop Color="#4B0585" Offset="0.36" />
                                        <GradientStop Color="#430075" Offset="0.58" />
                                        <GradientStop Color="#59078F" Offset="1" />
                                    </LinearGradientBrush>
                                    <LinearGradientBrush x:Key="SplitButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#D25AEC" Offset="0" />
                                        <GradientStop Color="#8B24C1" Offset="0.13" />
                                        <GradientStop Color="#5C1499" Offset="0.36" />
                                        <GradientStop Color="#531085" Offset="0.58" />
                                        <GradientStop Color="#7020A8" Offset="1" />
                                    </LinearGradientBrush>
                                    <LinearGradientBrush x:Key="SplitButtonBackgroundPressed" StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#9329B4" Offset="0" />
                                        <GradientStop Color="#61118F" Offset="0.13" />
                                        <GradientStop Color="#3A006E" Offset="0.36" />
                                        <GradientStop Color="#31005F" Offset="0.58" />
                                        <GradientStop Color="#4A087B" Offset="1" />
                                    </LinearGradientBrush>
                                    <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="White" />
                                    <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="White" />
                                    <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="White" />
                                    <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="#A0210B54" />
                                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="Transparent" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Default">
                                    <LinearGradientBrush x:Key="SplitButtonBackground" StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C138E3" Offset="0" />
                                        <GradientStop Color="#7510AD" Offset="0.13" />
                                        <GradientStop Color="#4B0585" Offset="0.36" />
                                        <GradientStop Color="#430075" Offset="0.58" />
                                        <GradientStop Color="#59078F" Offset="1" />
                                    </LinearGradientBrush>
                                    <LinearGradientBrush x:Key="SplitButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#D25AEC" Offset="0" />
                                        <GradientStop Color="#8B24C1" Offset="0.13" />
                                        <GradientStop Color="#5C1499" Offset="0.36" />
                                        <GradientStop Color="#531085" Offset="0.58" />
                                        <GradientStop Color="#7020A8" Offset="1" />
                                    </LinearGradientBrush>
                                    <LinearGradientBrush x:Key="SplitButtonBackgroundPressed" StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#9329B4" Offset="0" />
                                        <GradientStop Color="#61118F" Offset="0.13" />
                                        <GradientStop Color="#3A006E" Offset="0.36" />
                                        <GradientStop Color="#31005F" Offset="0.58" />
                                        <GradientStop Color="#4A087B" Offset="1" />
                                    </LinearGradientBrush>
                                    <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="White" />
                                    <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="White" />
                                    <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="White" />
                                    <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="#A0210B54" />
                                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="Transparent" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <SolidColorBrush x:Key="SplitButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                                    <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                    <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                    <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                    <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                    <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                    <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                    <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="Transparent" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </SplitButton.Resources>
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Window" Tag="Window" Click="Capture_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE78B;" FontSize="16" /></MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number4" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Full screen" Tag="FullScreen" Click="Capture_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" FontSize="16" /></MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number3" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Free form (rectangle)" Tag="Region" Click="Capture_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A8;" FontSize="16" /></MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Number2" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </local:HandCursorSplitButton>
                    <local:CaptureSparkleHost x:Name="NewShnappSparkleHost" Width="134" Height="34"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" IsHitTestVisible="False" />
                    <Grid Width="134" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center"
                        IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE722;" FontSize="17"
                                Foreground="{ThemeResource NewShnappSplitText}" />
                            <TextBlock Text="New shnapp" FontSize="14" FontWeight="SemiBold"
                                Foreground="{ThemeResource NewShnappSplitText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <local:HandCursorRegion x:Name="NewShnappArrowHitLayer" Width="34" Height="34" HorizontalAlignment="Right"
                        Background="Transparent" Tapped="NewShnappDivider_Tapped"
                        PointerEntered="NewShnappArrow_PointerEntered" PointerExited="NewShnappArrow_PointerExited"
                        PointerPressed="NewShnappArrow_PointerPressed" PointerReleased="NewShnappArrow_PointerReleased"
                        AutomationProperties.AccessibilityView="Raw">
                        <Border x:Name="NewShnappArrowHoverOverlay" CornerRadius="0,8,8,0" IsHitTestVisible="False" />
                    </local:HandCursorRegion>
                </local:HandCursorRegion>
                <Border x:Name="NewShnappRimNormal" Width="168" Height="34" CornerRadius="8" VerticalAlignment="Center"
                    BorderThickness="1" BorderBrush="{ThemeResource CaptureButtonRimBrush}"
                    IsHitTestVisible="False" />
                <Border x:Name="NewShnappRimHover" Width="168" Height="34" CornerRadius="8" VerticalAlignment="Center"
                    BorderThickness="1" BorderBrush="{ThemeResource CaptureButtonRimBrushPointerOver}"
                    Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="NewShnappRimPressed" Width="168" Height="34" CornerRadius="8" VerticalAlignment="Center"
                    BorderThickness="1" BorderBrush="{ThemeResource CaptureButtonRimBrushPressed}"
                    Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </AppBarElementContainer>
            <AppBarElementContainer Height="48" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                <local:HandCursorToggleButton x:Name="LibraryNavButton" Width="84" Height="34" MinWidth="0" Padding="8,0"
                    CornerRadius="8" VerticalAlignment="Center" BorderThickness="1"
                    BorderBrush="{ThemeResource LibraryButtonOutlineBrush}"
                    IsChecked="{x:Bind ViewModel.IsLibrarySelected, Mode=OneWay}"
                    Click="LibraryNav_Click" AutomationProperties.Name="Library"
                    AutomationProperties.AutomationId="OpenLibrary"
                    AutomationProperties.HelpText="Open your saved shnapps">
                    <ToggleButton.RenderTransform><TranslateTransform Y="7" /></ToggleButton.RenderTransform>
                    <ToggleButton.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B9;" FontSize="14" />
                            <TextBlock Text="Library" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton.Content>
                <ToggleButton.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="ToggleButtonBackground" Color="#E9F2FE" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#DCEBFC" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#C8DDF8" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#DCEBFF" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#C9E0FF" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#B8D4FA" />
                                <SolidColorBrush x:Key="ToggleButtonForeground" Color="#0A4D95" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#0A4D95" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Default">
                                <SolidColorBrush x:Key="ToggleButtonBackground" Color="#182C50" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#24406A" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#1C365F" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#21457B" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2B5590" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#173663" />
                                <SolidColorBrush x:Key="ToggleButtonForeground" Color="White" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SystemColorHighlightColorBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SystemColorHighlightColorBrush" />
                                <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="SystemColorHighlightTextColorBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </ToggleButton.Resources>
                </local:HandCursorToggleButton>
            </AppBarElementContainer>
            <AppBarSeparator />
            <local:HandCursorAppBarButton CornerRadius="8" x:Name="CopyButton" Label="Copy" Icon="Copy" Click="Copy_Click"
                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}" AutomationProperties.AutomationId="CopyShnapp"
                ToolTipService.ToolTip="Copy flattened image · Ctrl+C" />
