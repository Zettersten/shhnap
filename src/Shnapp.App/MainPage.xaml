                                    <ColumnDefinition Width="{x:Bind ListDimensionsWidth, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind ListSizeWidth, Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Width="32" MinWidth="0" Height="32" Padding="0"
                                    VerticalAlignment="Center" Tag="{x:Bind}"
                                    IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                    Checked="LibrarySelectionCheck_Changed" Unchecked="LibrarySelectionCheck_Changed"
                                    Tapped="LibrarySelectionCheck_Tapped"
                                    ToolTipService.ToolTip="Select shnapp"
                                    AutomationProperties.Name="{x:Bind SelectionLabel}" />
