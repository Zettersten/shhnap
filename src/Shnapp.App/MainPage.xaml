                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Capture region" Tag="Region" Click="Capture_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A8;" FontSize="16" /></MenuFlyoutItem.Icon>
