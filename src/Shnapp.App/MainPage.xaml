                        <MenuFlyoutItem Text="100%" Tag="1" Click="ZoomPreset_Click" />
                        <MenuFlyoutItem Text="125%" Tag="1.25" Click="ZoomPreset_Click" />
                        <MenuFlyoutItem Text="150%" Tag="1.5" Click="ZoomPreset_Click" />
                        <MenuFlyoutItem Text="200%" Tag="2" Click="ZoomPreset_Click" />
                        <MenuFlyoutItem Text="400%" Tag="4" Click="ZoomPreset_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="LibraryStatus" />
            <TextBlock Grid.Column="1" Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ShnappStatus" />
            <TextBlock x:Name="DocumentMetadataText" Grid.Column="2" Text="{x:Bind ViewModel.DocumentMetadata, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                AutomationProperties.AutomationId="DocumentMetadata" />
        </Grid>
    </local:InteractiveCursorHost>
</Page>
