                    ToolTipService.ToolTip="Show or hide info panel"
                    AutomationProperties.Name="Info panel" AutomationProperties.AutomationId="ToolOptions">
                    <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12"
                        Foreground="{ThemeResource ShnappBlueBrush}" />
                    <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                    </ToggleButton.Resources>
                </local:HandCursorToggleButton>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                VerticalAlignment="Center" Spacing="2"
                Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}">
                <Button x:Name="RecenterCanvasButton" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                    Visibility="Collapsed" CornerRadius="7" Background="Transparent" BorderThickness="0"
                    Click="RecenterCanvas_Click"
                    ToolTipService.ToolTip="Re-center canvas"
                    AutomationProperties.Name="Re-center canvas" AutomationProperties.AutomationId="RecenterCanvas">
                    <PathIcon Width="12" Height="12"
                        Data="F0 M8,1 A7,7 0 1 1 8,15 A7,7 0 1 1 8,1 Z M8,3 A5,5 0 1 0 8,13 A5,5 0 1 0 8,3 Z M7,0 L9,0 L9,4 L7,4 Z M7,12 L9,12 L9,16 L7,16 Z M0,7 L4,7 L4,9 L0,9 Z M12,7 L16,7 L16,9 L12,9 Z" />
                </Button>
                <Button x:Name="FooterFitButton" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="5"
                    Background="Transparent" BorderThickness="0" Click="FooterFit_Click"
                    ToolTipService.ToolTip="Fit image in window" AutomationProperties.Name="Fit image"
                    AutomationProperties.AutomationId="FooterFit">
                    <FontIcon Glyph="&#xE9A6;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12" />
                </Button>
                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="5"
                    Background="Transparent" BorderThickness="0" Click="ZoomOut_Click"
                    ToolTipService.ToolTip="Zoom out" AutomationProperties.Name="Zoom out"
                    AutomationProperties.AutomationId="ZoomOut">
                    <FontIcon Glyph="&#xE71F;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12" />
                </Button>
                <DropDownButton CornerRadius="5" x:Name="ZoomPresetButton" Content="100%" Height="24" MinHeight="0" MinWidth="48"
                    FontSize="10" Padding="4,0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Canvas zoom"
                    AutomationProperties.AutomationId="ZoomPresets"
                    AutomationProperties.HelpText="Canvas zoom. Choose a preset level.">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Fit canvas" Tag="fit" Click="ZoomPreset_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="10%" Tag="0.1" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="25%" Tag="0.25" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="50%" Tag="0.5" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="75%" Tag="0.75" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="100%" Tag="1" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="125%" Tag="1.25" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="150%" Tag="1.5" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="200%" Tag="2" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="400%" Tag="4" Click="ZoomPreset_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="5"
                    Background="Transparent" BorderThickness="0" Click="ZoomIn_Click"
                    ToolTipService.ToolTip="Zoom in" AutomationProperties.Name="Zoom in"
                    AutomationProperties.AutomationId="ZoomIn">
                    <FontIcon Glyph="&#xE8A3;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12" />
                </Button>
                <Button x:Name="FooterFullscreenButton" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="5"
                    Background="Transparent" BorderThickness="0" Click="Fullscreen_Click"
                    ToolTipService.ToolTip="Toggle full screen" AutomationProperties.Name="Toggle full screen"
                    AutomationProperties.AutomationId="Fullscreen">
                    <FontIcon Glyph="&#xE740;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12" />
                </Button>
            </StackPanel>
        </Grid>
    </local:InteractiveCursorHost>
</Page>
