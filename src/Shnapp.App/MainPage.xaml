                                    <TextBlock Text="{x:Bind Title}" FontSize="11" FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind GridMetadataText, Mode=OneWay}" FontSize="10"
                                        HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
