                                            Tapped="LibraryPreview_Tapped" />
                                    </Border>
                                    <CheckBox Width="32" MinWidth="0" Height="32" Padding="0" Margin="0,0,6,6"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Tag="{x:Bind}"
                                        IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                        Visibility="{x:Bind GridSelectionVisibility, Mode=OneWay}"
                                        Checked="LibrarySelectionCheck_Changed" Unchecked="LibrarySelectionCheck_Changed"
                                        Tapped="LibrarySelectionCheck_Tapped"
                                        ToolTipService.ToolTip="Select shnapp"
                                        AutomationProperties.Name="{x:Bind SelectionLabel}" />
                                </Grid>
                                <Grid Width="{x:Bind CardWidth, Mode=OneWay}" HorizontalAlignment="Left" ColumnSpacing="8">
