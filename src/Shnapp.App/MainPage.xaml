<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Shnapp.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:editor="using:Shnapp.App.Editor"
    xmlns:local="using:Shnapp.App"
    FontFamily="Segoe UI Variable Text"
    Background="{ThemeResource ShnappCanvasBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="QuietOverflowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" Control.IsTemplateFocusTarget="True">
                                <FontIcon Glyph="&#xE712;" FontFamily="Segoe Fluent Icons"
                                    FontSize="12" Width="12" Height="12"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon.RenderTransform><TranslateTransform Y="-10" /></FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="NewShnappSplitFill" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C138E3" Offset="0" />
                        <GradientStop Color="#7510AD" Offset="0.13" />
                        <GradientStop Color="#4B0585" Offset="0.36" />
                        <GradientStop Color="#430075" Offset="0.58" />
                        <GradientStop Color="#59078F" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="NewShnappSplitText" Color="White" />
                    <SolidColorBrush x:Key="CaptureButtonShadowBrush" Color="#3324004B" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrush" Color="#B0AD3CCF" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrushPointerOver" Color="#C8C85EE8" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrushPressed" Color="#90491A92" />
                    <SolidColorBrush x:Key="LibraryButtonOutlineBrush" Color="#6686ADD9" />
                    <SolidColorBrush x:Key="UpdateAttentionBrush" Color="#D6294D" />
                    <LinearGradientBrush x:Key="SplitButtonBackground" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C138E3" Offset="0" />
                        <GradientStop Color="#7510AD" Offset="0.13" />
                        <GradientStop Color="#4B0585" Offset="0.36" />
                        <GradientStop Color="#430075" Offset="0.58" />
                        <GradientStop Color="#59078F" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SplitButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D25AEC" Offset="0" />
                        <GradientStop Color="#8B24C1" Offset="0.13" />
                        <GradientStop Color="#5C1499" Offset="0.36" />
                        <GradientStop Color="#531085" Offset="0.58" />
                        <GradientStop Color="#7020A8" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SplitButtonBackgroundPressed" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#9329B4" Offset="0" />
                        <GradientStop Color="#61118F" Offset="0.13" />
                        <GradientStop Color="#3A006E" Offset="0.36" />
                        <GradientStop Color="#31005F" Offset="0.58" />
                        <GradientStop Color="#4A087B" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SplitButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="#F8E9FF" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="#A0210B54" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <LinearGradientBrush x:Key="NewShnappSplitFill" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C138E3" Offset="0" />
                        <GradientStop Color="#7510AD" Offset="0.13" />
                        <GradientStop Color="#4B0585" Offset="0.36" />
                        <GradientStop Color="#430075" Offset="0.58" />
                        <GradientStop Color="#59078F" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="NewShnappSplitText" Color="White" />
                    <SolidColorBrush x:Key="CaptureButtonShadowBrush" Color="#50200040" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrush" Color="#B0AD3CCF" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrushPointerOver" Color="#C8C85EE8" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrushPressed" Color="#90491A92" />
                    <SolidColorBrush x:Key="LibraryButtonOutlineBrush" Color="#6681A6DC" />
                    <SolidColorBrush x:Key="UpdateAttentionBrush" Color="#FF4968" />
                    <LinearGradientBrush x:Key="SplitButtonBackground" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C138E3" Offset="0" />
                        <GradientStop Color="#7510AD" Offset="0.13" />
                        <GradientStop Color="#4B0585" Offset="0.36" />
                        <GradientStop Color="#430075" Offset="0.58" />
                        <GradientStop Color="#59078F" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SplitButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D25AEC" Offset="0" />
                        <GradientStop Color="#8B24C1" Offset="0.13" />
                        <GradientStop Color="#5C1499" Offset="0.36" />
                        <GradientStop Color="#531085" Offset="0.58" />
                        <GradientStop Color="#7020A8" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SplitButtonBackgroundPressed" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#9329B4" Offset="0" />
                        <GradientStop Color="#61118F" Offset="0.13" />
                        <GradientStop Color="#3A006E" Offset="0.36" />
                        <GradientStop Color="#31005F" Offset="0.58" />
                        <GradientStop Color="#4A087B" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SplitButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="White" />
                    <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="#F8E9FF" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="#A0210B54" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="NewShnappSplitFill" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="NewShnappSplitText" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="CaptureButtonShadowBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="CaptureButtonRimBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="LibraryButtonOutlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="UpdateAttentionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SplitButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SplitButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SplitButtonForegroundSecondary" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SplitButtonForegroundSecondaryPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="SplitButtonBorderBrushDivider" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyAccelerator_Invoked" />
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAccelerator_Invoked" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoAccelerator_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="RedoAccelerator_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusLibrarySearch_Invoked" />
        <KeyboardAccelerator Key="G" Modifiers="Control,Shift" Invoked="ToggleGalleryAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    <local:InteractiveCursorHost KeyDown="Page_KeyDown">
        <CommandBar x:Name="PrimaryCommandBar" Loaded="PrimaryCommandBar_Loaded"
            DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="False"
            Height="28" VerticalAlignment="Center" Margin="0" Canvas.ZIndex="10"
            Background="Transparent">
            <CommandBar.Content>
                <StackPanel x:Name="PrimaryChromeContent" Orientation="Horizontal" Spacing="0" Margin="0" MinHeight="32" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <SolidColorBrush x:Key="AppBarButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="AppBarButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="AppBarButtonBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="AppBarButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    </StackPanel.Resources>
                    <local:ToolbarActionButton CornerRadius="7" x:Name="BackButton" Width="28" Height="28" MinWidth="0" Padding="0"
                        IsEnabled="False" VerticalAlignment="Center"
                        Click="Back_Click" ToolTipService.ToolTip="Back · Alt+Left"
                        AutomationProperties.Name="Back" AutomationProperties.AutomationId="NavigateBack">
                        <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12" />
                    </local:ToolbarActionButton>
                    <local:ToolbarActionButton CornerRadius="7" x:Name="ForwardButton" Width="28" Height="28" MinWidth="0" Padding="0"
                        IsEnabled="False" VerticalAlignment="Center"
                        Click="Forward_Click" ToolTipService.ToolTip="Forward · Alt+Right"
                        AutomationProperties.Name="Forward" AutomationProperties.AutomationId="NavigateForward">
                        <FontIcon Glyph="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12" />
                    </local:ToolbarActionButton>
                    <StackPanel x:Name="LibraryChromeTitle" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                        <TextBlock Text="Library" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="LibraryResultCount" Text="0 shnapps" FontSize="14" VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <Grid x:Name="DocumentChromeTitleHost" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}">
                        <Button CornerRadius="8" x:Name="DocumentTitleButton" Click="DocumentTitleButton_Click" Padding="8,0" Height="40"
                            Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Rename shnapp"
                            AutomationProperties.Name="Rename shnapp" AutomationProperties.AutomationId="DocumentTitle">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                    MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                <FontIcon Glyph="&#xE70F;" FontSize="14" Opacity="0.72" />
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="DocumentTitleEditor" Visibility="Collapsed" Width="240" Height="40" Margin="8,0,0,0" MaxLength="120"
                            KeyDown="DocumentTitleEditor_KeyDown" LostFocus="DocumentTitleEditor_LostFocus"
                            AutomationProperties.Name="Shnapp title" AutomationProperties.AutomationId="DocumentTitleEditor" />
                    </Grid>
                </StackPanel>
            </CommandBar.Content>
            <AppBarElementContainer x:Name="LibraryChromeHost" Height="32" VerticalAlignment="Center" Padding="0" Margin="0,0,4,0" Background="Transparent" BorderThickness="0">
                <local:HandCursorToggleButton x:Name="LibraryNavButton" Width="28" Height="28" MinWidth="0" Padding="0"
                    CornerRadius="7" VerticalAlignment="Center" BorderThickness="0" Background="Transparent"
                    IsChecked="{x:Bind ViewModel.IsLibrarySelected, Mode=OneWay}"
                    Click="LibraryNav_Click" AutomationProperties.Name="Library"
                    AutomationProperties.AutomationId="OpenLibrary"
                    AutomationProperties.HelpText="Open your saved shnapps"
                    ToolTipService.ToolTip="Library">
                    <ToggleButton.Content>
                        <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </ToggleButton.Content>
                    <ToggleButton.Resources>
                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ShnappToolbarBrush" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ShnappToolbarBrush" />
                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ShnappToolbarBrush" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                    </ToggleButton.Resources>
                </local:HandCursorToggleButton>
            </AppBarElementContainer>
            <CommandBar.SecondaryCommands>
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" Label="Capture region" Icon="Camera"
                    Tag="Region" Click="Capture_Click" AutomationProperties.AutomationId="CaptureRegion" />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" Label="Capture window" Icon="Page"
                    Tag="Window" Click="Capture_Click" AutomationProperties.AutomationId="CaptureWindow" />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" Label="Capture full screen" Icon="FullScreen"
                    Tag="FullScreen" Click="Capture_Click" AutomationProperties.AutomationId="CaptureFullScreen" />
                <AppBarSeparator />
                <local:HandCursorAppBarButton x:Name="QuickCameraCapture" CornerRadius="8" Width="190"
                    Label="Take camera photo" Icon="Camera" Click="CameraCapture_Click" IsEnabled="False"
                    AutomationProperties.AutomationId="QuickCameraCapture"
                    ToolTipService.ToolTip="Take a camera photo · Ctrl+Shift+5" />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" x:Name="CopyButton" Label="Copy image" Icon="Copy" Click="Copy_Click"
                    Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                    AutomationProperties.AutomationId="CopyShnapp"
                    ToolTipService.ToolTip="Copy flattened image · Ctrl+C" />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" x:Name="SaveButton" Label="Save PNG…" Icon="Save" Click="Save_Click"
                    Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                    AutomationProperties.AutomationId="SaveShnapp"
                    ToolTipService.ToolTip="Save PNG to a chosen location · Ctrl+S" />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" Label="Save as copy" Icon="Save"
                    Click="SaveCopy_Click" Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                    AutomationProperties.AutomationId="SaveAsCopy"
                    ToolTipService.ToolTip="Duplicate this shnapp in your Library" />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" Label="Share" Icon="Share" Click="Share_Click"
                    Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                    AutomationProperties.AutomationId="ShareShnapp"
                    ToolTipService.ToolTip="Share this shnapp with another app" />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" Label="Copy snapshot path" Icon="Copy" Click="CopyCurrentPath_Click"
                    Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                    AutomationProperties.AutomationId="CopyCurrentShnappPath"
                    ToolTipService.ToolTip="Copy an unchanged PNG path, kept at least 7 days unless this shnapp is deleted" />
                <AppBarSeparator Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}" />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" Label="Recent shnapps" Icon="Pictures" Click="ToggleGallery_Click"
                    Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                    AutomationProperties.AutomationId="ShowGallery"
                    ToolTipService.ToolTip="Show the gallery · Ctrl+Shift+G" />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" Label="Rename shnapp" Icon="Rename" Click="DocumentTitleButton_Click"
                    Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                    AutomationProperties.AutomationId="RenameShnapp" />
                <AppBarSeparator Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}" />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" Label="Delete shnapp" Icon="Delete" Click="DeleteCurrent_Click"
                    Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
                    AutomationProperties.AutomationId="DeleteCurrentShnapp"
                    ToolTipService.ToolTip="Delete this shnapp from your Library" />
                <AppBarSeparator Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}" />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" Label="Settings" Icon="Setting" Click="Settings_Click" AutomationProperties.AutomationId="OpenSettings" />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" x:Name="UpdateAvailableButton" Label="Update Shnapp" Icon="Download"
                    Click="Settings_Click" IsEnabled="False"
                    AutomationProperties.AutomationId="UpdateAvailable"
                    ToolTipService.ToolTip="Open About &amp; Updates when a newer Shnapp release is available" />
                <AppBarSeparator />
                <local:HandCursorAppBarButton CornerRadius="8" Width="190" Label="Quit Shnapp" Icon="Cancel" Click="Quit_Click" AutomationProperties.AutomationId="QuitShnapp" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <InfoBar x:Name="MessageBar" Canvas.ZIndex="12" IsOpen="False" IsClosable="True"
            VerticalAlignment="Top" Margin="16,44,16,0" />
        <Grid x:Name="EditorHost" Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
            SizeChanged="EditorHost_SizeChanged"
            Background="{ThemeResource ShnappCanvasBrush}">
                    <Grid Background="{ThemeResource ShnappCanvasBrush}"
                        SizeChanged="GalleryCanvasHost_SizeChanged"
                        PointerMoved="GalleryCanvasHost_PointerMoved" PointerExited="GalleryCanvasHost_PointerExited">
                        <canvas:CanvasControl x:Name="DrawingCanvas" Draw="Canvas_Draw" SizeChanged="Canvas_SizeChanged"
                            IsHitTestVisible="False" IsTabStop="True" />
                        <!-- Keep the cursor on the element that receives pointer input. Win2D's
                             CanvasControl otherwise restores its own default cursor on movement. -->
                        <local:EditorCursorHost x:Name="CanvasHost" Background="Transparent" IsTabStop="True"
                            PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved"
                            PointerReleased="Canvas_PointerReleased" PointerCanceled="Canvas_PointerCanceled"
                            PointerCaptureLost="Canvas_PointerCaptureLost"
                            PointerEntered="Canvas_PointerEntered" PointerExited="Canvas_PointerExited"
                            PointerWheelChanged="Canvas_PointerWheelChanged"
                            DoubleTapped="Canvas_DoubleTapped" RightTapped="Canvas_RightTapped" AllowDrop="True"
                            DragOver="Canvas_DragOver" Drop="Canvas_Drop"
                            AutomationProperties.Name="Shnapp annotation canvas"
                            AutomationProperties.AutomationId="ShnappCanvas" />
                        <Canvas x:Name="TextOverlay" SizeChanged="TextOverlay_SizeChanged">
                            <Border x:Name="InlineTextStyleRow" Visibility="Collapsed" Opacity="0"
                                Canvas.ZIndex="10" Width="108" Height="36" Padding="3"
                                Background="{ThemeResource ShnappImagePanelBrush}"
                                BorderBrush="{ThemeResource ShnappFloatingEdgeBrush}" BorderThickness="1"
                                CornerRadius="9" Translation="0,0,24"
                                AutomationProperties.Name="Text formatting">
                                <Border.Shadow><ThemeShadow /></Border.Shadow>
                                <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <local:HandCursorToggleButton x:Name="InlineBold" Width="30" Height="28"
                                        MinWidth="0" Padding="0" BorderThickness="0" CornerRadius="6"
                                        AllowFocusOnInteraction="False"
                                        Click="InlineTextStyle_Click" AutomationProperties.Name="Bold selected text"
                                        ToolTipService.ToolTip="Bold · Ctrl+B">
                                        <FontIcon Glyph="&#xE8DD;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                    </local:HandCursorToggleButton>
                                    <local:HandCursorToggleButton x:Name="InlineItalic" Width="30" Height="28"
                                        MinWidth="0" Padding="0" BorderThickness="0" CornerRadius="6"
                                        AllowFocusOnInteraction="False"
                                        Click="InlineTextStyle_Click" AutomationProperties.Name="Italicize selected text"
                                        ToolTipService.ToolTip="Italic · Ctrl+I">
                                        <FontIcon Glyph="&#xE8DB;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                    </local:HandCursorToggleButton>
                                    <local:HandCursorToggleButton x:Name="InlineUnderline" Width="30" Height="28"
                                        MinWidth="0" Padding="0" BorderThickness="0" CornerRadius="6"
                                        AllowFocusOnInteraction="False"
                                        Click="InlineTextStyle_Click" AutomationProperties.Name="Underline selected text"
                                        ToolTipService.ToolTip="Underline · Ctrl+U">
                                        <FontIcon Glyph="&#xE8DC;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                    </local:HandCursorToggleButton>
                                </StackPanel>
                            </Border>
                        </Canvas>
                        <Border x:Name="GalleryDock" Visibility="Collapsed" Width="80" Opacity="0"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                            Padding="8" CornerRadius="12"
                            Background="{ThemeResource ShnappImagePanelBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                            PointerMoved="GalleryDock_PointerMoved" PointerExited="GalleryDock_PointerExited"
                            PointerWheelChanged="GalleryDock_PointerWheelChanged"
                            ActualThemeChanged="GalleryDock_ActualThemeChanged"
                            AutomationProperties.Name="Recent shnapps gallery. Scroll to browse; drag a preview onto the canvas to add a copy.">
                            <Border.RenderTransform>
                                <TranslateTransform X="-96" />
                            </Border.RenderTransform>
                            <StackPanel Spacing="4">
                                <Button CornerRadius="8" x:Name="GalleryPrevious" Width="58" Height="32" Padding="0"
                                    HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                                    Click="GalleryPrevious_Click" PointerWheelChanged="GalleryDock_PointerWheelChanged"
                                    AutomationProperties.Name="Previous gallery shnapps" AutomationProperties.AutomationId="GalleryPrevious">
                                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                                </Button>
                                <Canvas x:Name="GalleryDockItems" Width="58" />
                                <Button CornerRadius="8" x:Name="GalleryNext" Width="58" Height="32" Padding="0"
                                    HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                                    Click="GalleryNext_Click" PointerWheelChanged="GalleryDock_PointerWheelChanged"
                                    AutomationProperties.Name="More gallery shnapps" AutomationProperties.AutomationId="GalleryNext">
                                    <FontIcon Glyph="&#xE70D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border x:Name="InspectorPanel" Visibility="Visible"
                        Width="252" Margin="12,48,12,36"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Background="{ThemeResource ShnappInspectorAcrylicBrush}" CornerRadius="12"
                        BorderBrush="{ThemeResource ShnappFloatingEdgeBrush}" BorderThickness="1"
                        Translation="0,0,20"
                        AutomationProperties.Name="Tool options">
                        <Border.Shadow><ThemeShadow /></Border.Shadow>
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="InspectorContent" Padding="12,12,12,16" Spacing="8">
                                <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Grid Width="20" Height="20">
                                            <FontIcon x:Name="InspectorToolIcon" Glyph="&#xE8B0;" FontSize="16"
                                                Foreground="{ThemeResource ShnappBlueBrush}" />
                                            <PathIcon x:Name="InspectorLineIcon" Visibility="Collapsed"
                                                Data="M2,13 L12,3 L9,3 L9,1 L15,1 L15,7 L13,7 L13,4 L3,14 Z"
                                                Foreground="{ThemeResource ShnappBlueBrush}" />
                                            <PathIcon x:Name="InspectorRectangleIcon" Visibility="Collapsed"
                                                Data="F0 M1,3 L15,3 L15,13 L1,13 Z M2.5,4.5 L2.5,11.5 L13.5,11.5 L13.5,4.5 Z"
                                                Foreground="{ThemeResource ShnappBlueBrush}" />
                                            <PathIcon x:Name="InspectorSquareIcon" Visibility="Collapsed"
                                                Data="F0 M2,2 L14,2 L14,14 L2,14 Z M3.5,3.5 L3.5,12.5 L12.5,12.5 L12.5,3.5 Z"
                                                Foreground="{ThemeResource ShnappBlueBrush}" />
                                            <PathIcon x:Name="InspectorEllipseIcon" Visibility="Collapsed"
                                                Data="F0 M8,3 C12,3 15,5 15,8 C15,11 12,13 8,13 C4,13 1,11 1,8 C1,5 4,3 8,3 Z M8,4.5 C4.9,4.5 2.5,6 2.5,8 C2.5,10 4.9,11.5 8,11.5 C11.1,11.5 13.5,10 13.5,8 C13.5,6 11.1,4.5 8,4.5 Z"
                                                Foreground="{ThemeResource ShnappBlueBrush}" />
                                            <PathIcon x:Name="InspectorCircleIcon" Visibility="Collapsed"
                                                Data="F0 M8,1 A7,7 0 1 1 8,15 A7,7 0 1 1 8,1 Z M8,2.5 A5.5,5.5 0 1 0 8,13.5 A5.5,5.5 0 1 0 8,2.5 Z"
                                                Foreground="{ThemeResource ShnappBlueBrush}" />
                                            <Path x:Name="InspectorPaletteShapeIcon" Visibility="Collapsed"
                                                Width="18" Height="18" Stretch="Uniform"
                                                Stroke="{ThemeResource ShnappBlueBrush}" StrokeThickness="1.5"
                                                StrokeLineJoin="Round" />
                                        </Grid>
                                        <TextBlock x:Name="InspectorTitle" Text="Select" FontSize="16" FontWeight="SemiBold"
                                            AutomationProperties.AutomationId="InspectorTitle"
                                            MaxWidth="158" TextTrimming="CharacterEllipsis" />
                                        <local:ToolbarActionButton x:Name="EditSelectedTextButton" Width="28" Height="28"
                                            MinWidth="0" Padding="0" BorderThickness="0" CornerRadius="6"
                                            Visibility="Collapsed" Click="EditSelectedText_Click"
                                            AutomationProperties.Name="Edit selected text"
                                            ToolTipService.ToolTip="Edit selected text">
                                            <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                                        </local:ToolbarActionButton>
                                    </StackPanel>
                                    <TextBlock x:Name="InspectorHelp" Text="Click markup to move it. Press Delete to remove it."
                                        TextWrapping="Wrap" FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Grid x:Name="SelectGuideRow" Visibility="Collapsed" ColumnSpacing="10" RowSpacing="8"
                                    Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="SelectGuideFirstLabel" Text="Click" FontSize="11" FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SelectGuideFirstText" Grid.Column="1" Text="Choose an element"
                                        FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SelectGuideSecondLabel" Grid.Row="1" Text="Drag" FontSize="11" FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SelectGuideSecondText" Grid.Row="1" Grid.Column="1"
                                        Text="Move it or resize with handles" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="Arrows" FontSize="11" FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Nudge 1 px · Shift: 10 px"
                                        FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <Rectangle x:Name="InspectorSeparator" Height="1"
                                    Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                <StackPanel x:Name="PhotoOptionsRow" Visibility="Collapsed" Spacing="8">
                                    <TextBlock Text="Photo" FontWeight="SemiBold" />
                                    <TextBlock Text="Crop this layer without changing the canvas. Drag over the part to keep."
                                        FontSize="12" TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="PhotoCropButton" Content="Crop photo" CornerRadius="8"
                                        HorizontalAlignment="Stretch" Click="PhotoCrop_Click"
                                        AutomationProperties.Name="Crop selected photo" />
                                    <Button x:Name="ResetPhotoCropButton" Content="Reset photo crop" CornerRadius="8"
                                        HorizontalAlignment="Stretch" Click="ResetPhotoCrop_Click"
                                        AutomationProperties.Name="Reset selected photo crop" />
                                    <Button x:Name="PhotoAddButton" Content="Add another camera photo" CornerRadius="8"
                                        HorizontalAlignment="Stretch" Click="CameraPhotoTool_Click" IsEnabled="False"
                                        AutomationProperties.Name="Add another camera photo" />
                                </StackPanel>
                                <StackPanel x:Name="CropOptionsRow" Visibility="Collapsed" Spacing="8">
                                    <TextBlock Text="Crop in pixels" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <NumberBox x:Name="CropXChoice" Header="X" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Compact"
                                            ValueChanged="CropNumber_Changed" Loaded="NumberBox_Loaded"
                                            AutomationProperties.Name="Crop X position in pixels" />
                                        <NumberBox x:Name="CropYChoice" Grid.Column="1" Header="Y" Minimum="0" SmallChange="1" SpinButtonPlacementMode="Compact"
                                            ValueChanged="CropNumber_Changed" Loaded="NumberBox_Loaded"
                                            AutomationProperties.Name="Crop Y position in pixels" />
                                        <NumberBox x:Name="CropWidthChoice" Grid.Row="1" Header="Width" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact"
                                            ValueChanged="CropNumber_Changed" Loaded="NumberBox_Loaded"
                                            AutomationProperties.Name="Crop width in pixels" />
                                        <NumberBox x:Name="CropHeightChoice" Grid.Row="1" Grid.Column="1" Header="Height" Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact"
                                            ValueChanged="CropNumber_Changed" Loaded="NumberBox_Loaded"
                                            AutomationProperties.Name="Crop height in pixels" />
                                    </Grid>
                                    <CheckBox x:Name="CropLockProportions" Content="Lock proportions" Click="CropLock_Click" />
                                    <ComboBox x:Name="CropRatioChoice" Header="Aspect ratio" HorizontalAlignment="Stretch"
                                        SelectedIndex="0" SelectionChanged="CropRatio_Changed">
                                        <ComboBoxItem Content="Free" Tag="Free" />
                                        <ComboBoxItem Content="1:1 · Square" Tag="1:1" />
                                        <ComboBoxItem Content="9:16 · Portrait" Tag="9:16" />
                                        <ComboBoxItem Content="16:9 · Wide" Tag="16:9" />
                                        <ComboBoxItem Content="5:7 · Print" Tag="5:7" />
                                        <ComboBoxItem Content="7:5 · Landscape" Tag="7:5" />
                                        <ComboBoxItem Content="4:3 · Classic" Tag="4:3" />
                                        <ComboBoxItem Content="3:2 · Photo" Tag="3:2" />
                                    </ComboBox>
                                    <Button CornerRadius="8" HorizontalAlignment="Stretch" Click="ApplyCrop_Click"
                                        AutomationProperties.Name="Apply crop">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" />
                                            <TextBlock Text="Apply crop" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="RedactionModeRow" Visibility="Collapsed">
                                    <ComboBox x:Name="RedactionModeChoice" Header="Mode" SelectedIndex="0"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed">
                                        <ComboBoxItem Content="Cover" Tag="Solid" />
                                        <ComboBoxItem Content="Blur" Tag="Blur" />
                                        <ComboBoxItem Content="Pixelate" Tag="Pixelate" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="CalloutEditRow" Visibility="Collapsed">
                                    <Button Content="Edit annotation text" Click="EditCallout_Click"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Edit selected annotation text" />
                                </StackPanel>
                                <StackPanel x:Name="MagnifyOptionsRow" Visibility="Collapsed" Spacing="8">
                                    <NumberBox x:Name="MagnifyZoomChoice" Header="Zoom (%)" Value="200"
                                        Minimum="125" Maximum="800" SmallChange="25" SpinButtonPlacementMode="Compact"
                                        ValueChanged="NumberOption_Changed" Loaded="NumberBox_Loaded"
                                        AutomationProperties.Name="Magnifying lens zoom percentage" />
                                    <ComboBox x:Name="MagnifyShapeChoice" Header="Lens shape" SelectedIndex="0"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed">
                                        <ComboBoxItem Content="Ellipse" Tag="Ellipse" />
                                        <ComboBoxItem Content="Rectangle" Tag="Rectangle" />
                                    </ComboBox>
                                    <CheckBox x:Name="MagnifyOutlineChoice" Content="Show border" IsChecked="True"
                                        Click="Options_Changed" />
                                </StackPanel>
                                <StackPanel x:Name="PrimaryColorRow" Visibility="Collapsed" Spacing="8">
                                    <TextBlock x:Name="PrimaryColorLabel" Text="Color" FontWeight="SemiBold" />
                                    <Button CornerRadius="8" x:Name="PrimaryColorButton" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Choose annotation color">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border x:Name="PrimaryColorSwatch" Width="24" Height="24" CornerRadius="4"
                                                    Background="#E5484D" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                                <TextBlock Text="Choose color" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button.Content>
                                        <Button.Flyout>
                                            <Flyout Closed="ColorFlyout_Closed">
                                                <ColorPicker x:Name="PrimaryColorPicker" Color="#E5484D"
                                                    IsAlphaEnabled="True" ColorChanged="ColorOption_Changed" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="SecondaryColorRow" Visibility="Collapsed" Spacing="8">
                                    <TextBlock x:Name="SecondaryColorLabel" Text="Fill color" FontWeight="SemiBold" />
                                    <Button CornerRadius="8" x:Name="SecondaryColorButton" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Choose fill or label color">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border x:Name="SecondaryColorSwatch" Width="24" Height="24" CornerRadius="4"
                                                    Background="#FFFFFF" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                                <TextBlock Text="Choose color" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button.Content>
                                        <Button.Flyout>
                                            <Flyout Closed="ColorFlyout_Closed">
                                                <ColorPicker x:Name="SecondaryColorPicker" Color="#FFFFFF"
                                                    IsAlphaEnabled="True" ColorChanged="ColorOption_Changed" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="StrokeWidthRow" Visibility="Collapsed">
                                    <NumberBox x:Name="StrokeSize" Header="Line width (px)" Value="3" Minimum="1" Maximum="24"
                                        SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="NumberOption_Changed"
                                        Loaded="NumberBox_Loaded" />
                                </StackPanel>
                                <StackPanel x:Name="FontFamilyRow" Visibility="Collapsed">
                                    <AutoSuggestBox x:Name="FontFamilyChoice" Header="Font" PlaceholderText="Search fonts"
                                        HorizontalAlignment="Stretch" MaxSuggestionListHeight="420" QueryIcon="Find"
                                        TextMemberPath="Name" TextChanged="FontFamilyChoice_TextChanged"
                                        QuerySubmitted="FontFamilyChoice_QuerySubmitted"
                                        SuggestionChosen="FontFamilyChoice_SuggestionChosen"
                                        GotFocus="FontFamilyChoice_GotFocus"
                                        LostFocus="FontFamilyChoice_LostFocus"
                                        AutomationProperties.Name="Search fonts">
                                        <AutoSuggestBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:FontPreviewChoice">
                                                <Grid MinWidth="206" MaxWidth="220" MinHeight="46" Padding="10,3" ColumnSpacing="8"
                                                    PointerEntered="FontPreviewItem_PointerEntered"
                                                    ToolTipService.ToolTip="{x:Bind Name}"
                                                    AutomationProperties.Name="{x:Bind Name}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold"
                                                        VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                    <TextBlock Grid.Column="1" Text="Ag" FontFamily="{x:Bind PreviewFont}"
                                                        Width="52" FontSize="22" TextAlignment="Center" VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis" MaxLines="1"
                                                        AutomationProperties.AccessibilityView="Raw" />
                                                </Grid>
                                            </DataTemplate>
                                        </AutoSuggestBox.ItemTemplate>
                                    </AutoSuggestBox>
                                    <TextBlock x:Name="FontFamilyNoResults" Text="No matching fonts"
                                        Visibility="Collapsed" Margin="0,4,0,0" FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel x:Name="FontSizeRow" Visibility="Collapsed">
                                    <NumberBox x:Name="FontSizeChoice" Header="Text size (px)" Value="18" Minimum="8" Maximum="144"
                                        SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="NumberOption_Changed"
                                        Loaded="NumberBox_Loaded" />
                                </StackPanel>
                                <StackPanel x:Name="TextAreaStyleRow" Visibility="Collapsed" Spacing="8">
                                    <TextBlock Text="Text area" FontWeight="SemiBold" />
                                    <StackPanel Spacing="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Padding" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TextPaddingValue" Grid.Column="1" Text="0 px"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <Slider x:Name="TextPaddingChoice" Minimum="0" Maximum="64" Value="0"
                                            SmallChange="1" LargeChange="8" StepFrequency="1"
                                            ValueChanged="TextPaddingChoice_ValueChanged"
                                            AutomationProperties.Name="Text area padding" />
                                    </StackPanel>
                                    <CheckBox x:Name="TextBackgroundEnabled" Content="Background"
                                        Click="Options_Changed" />
                                    <Button x:Name="TextBackgroundColorButton" CornerRadius="8" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Choose text area background color">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border x:Name="TextBackgroundSwatch" Width="24" Height="24" CornerRadius="4"
                                                    Background="White" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                                <TextBlock Text="Background color" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button.Content>
                                        <Button.Flyout>
                                            <Flyout Closed="ColorFlyout_Closed">
                                                <ColorPicker x:Name="TextBackgroundColorPicker" Color="White"
                                                    IsAlphaEnabled="True" ColorChanged="ColorOption_Changed" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <CheckBox x:Name="TextBorderEnabled" Content="Border" Click="Options_Changed" />
                                    <Button x:Name="TextBorderColorButton" CornerRadius="8" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Choose text area border color">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border x:Name="TextBorderSwatch" Width="24" Height="24" CornerRadius="4"
                                                    Background="#0A84FF" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
                                                <TextBlock Text="Border color" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button.Content>
                                        <Button.Flyout>
                                            <Flyout Closed="ColorFlyout_Closed">
                                                <ColorPicker x:Name="TextBorderColorPicker" Color="#0A84FF"
                                                    IsAlphaEnabled="True" ColorChanged="ColorOption_Changed" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <NumberBox x:Name="TextBorderWidthChoice" Header="Border width (px)"
                                        Value="2" Minimum="1" Maximum="24" SmallChange="1"
                                        SpinButtonPlacementMode="Compact" ValueChanged="NumberOption_Changed"
                                        Loaded="NumberBox_Loaded" />
                                </StackPanel>
                                <StackPanel x:Name="TextBoxLayoutRow" Visibility="Collapsed" Spacing="8">
                                    <TextBlock Text="Text box" FontWeight="SemiBold" />
                                    <ComboBox x:Name="TextAlignmentChoice" Header="Alignment" SelectedIndex="0"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed"
                                        AutomationProperties.AutomationId="TextAlignmentChoice">
                                        <ComboBoxItem Content="Left" Tag="Left" />
                                        <ComboBoxItem Content="Center" Tag="Center" />
                                        <ComboBoxItem Content="Right" Tag="Right" />
                                        <ComboBoxItem Content="Justified" Tag="Justify" />
                                    </ComboBox>
                                    <ComboBox x:Name="TextVerticalAlignmentChoice" Header="Vertical alignment" SelectedIndex="0"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed"
                                        AutomationProperties.AutomationId="TextVerticalAlignmentChoice">
                                        <ComboBoxItem Content="Top" Tag="Top" />
                                        <ComboBoxItem Content="Middle" Tag="Middle" />
                                        <ComboBoxItem Content="Bottom" Tag="Bottom" />
                                    </ComboBox>
                                    <ComboBox x:Name="TextTruncationChoice" Header="Overflow" SelectedIndex="0"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed"
                                        AutomationProperties.AutomationId="TextTruncationChoice">
                                        <ComboBoxItem Content="Clip at box edge" Tag="Clip" />
                                        <ComboBoxItem Content="End ellipsis" Tag="EndEllipsis" />
                                    </ComboBox>
                                    <NumberBox x:Name="TextLineHeightChoice" Header="Line height (px)" Value="0"
                                        Minimum="0" Maximum="320" SmallChange="1" SpinButtonPlacementMode="Compact"
                                        ValueChanged="NumberOption_Changed" Loaded="NumberBox_Loaded"
                                        ToolTipService.ToolTip="0 uses the font's default line height"
                                        AutomationProperties.AutomationId="TextLineHeightChoice" />
                                </StackPanel>
                                <StackPanel x:Name="StepSizeRow" Visibility="Collapsed">
                                    <NumberBox x:Name="StepSize" Header="Dot diameter (px)" Value="28" Minimum="16" Maximum="120"
                                        SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="NumberOption_Changed"
                                        Loaded="NumberBox_Loaded" />
                                </StackPanel>
                                <StackPanel x:Name="StepLabelRow" Visibility="Collapsed" Spacing="8">
                                    <ComboBox x:Name="StepLabelChoice" Header="Dot labels" SelectedIndex="0"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed">
                                        <ComboBoxItem Content="1, 2, 3" Tag="Decimal" />
                                        <ComboBoxItem Content="A, B, C" Tag="UpperLetters" />
                                        <ComboBoxItem Content="a, b, c" Tag="LowerLetters" />
                                        <ComboBoxItem Content="I, II, III" Tag="UpperRoman" />
                                        <ComboBoxItem Content="i, ii, iii" Tag="LowerRoman" />
                                    </ComboBox>
                                    <CheckBox x:Name="StepResetCount" Content="Restart count at this dot"
                                        Click="Options_Changed" ToolTipService.ToolTip="Make this dot number one in a new sequence" />
                                </StackPanel>
                                <StackPanel x:Name="OutlineToggleRow" Visibility="Collapsed">
                                    <CheckBox x:Name="OutlineShape" Content="Show outline" IsChecked="True"
                                        Click="Options_Changed"
                                        ToolTipService.ToolTip="Turn off the shape border; a fill stays visible" />
                                </StackPanel>
                                <StackPanel x:Name="FillToggleRow" Visibility="Collapsed">
                                    <CheckBox x:Name="FillShape" Content="Fill shape" Click="Options_Changed" />
                                </StackPanel>
                                <StackPanel x:Name="LinePatternRow" Visibility="Collapsed">
                                    <ComboBox x:Name="LinePatternChoice" Header="Line style" SelectedIndex="0"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed">
                                        <ComboBoxItem Content="Solid" Tag="Solid" />
                                        <ComboBoxItem Content="Dashed" Tag="Dashed" />
                                        <ComboBoxItem Content="Dotted" Tag="Dotted" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="LineFreehandRow" Visibility="Collapsed">
                                    <CheckBox x:Name="LineFreehandChoice" Content="Draw freehand (new lines)"
                                        Click="Options_Changed" AutomationProperties.AutomationId="LineFreehandChoice"
                                        ToolTipService.ToolTip="Follow your pointer with a smoothed line. Hold Shift while dragging to draw a straight horizontal or vertical line." />
                                </StackPanel>
                                <StackPanel x:Name="LineCurvesRow" Visibility="Collapsed">
                                    <CheckBox x:Name="LineCurvesChoice" Content="Allow curves"
                                        Click="Options_Changed" AutomationProperties.AutomationId="LineCurvesChoice"
                                        ToolTipService.ToolTip="Drag the midpoint handle to bend this line. A freehand stroke becomes one editable curve." />
                                </StackPanel>
                                <StackPanel x:Name="LineCapRow" Visibility="Collapsed" Spacing="8">
                                    <ComboBox x:Name="StartCapChoice" Header="Start cap" SelectedIndex="0"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed">
                                        <ComboBoxItem Content="None" Tag="None" />
                                        <ComboBoxItem Content="Triangle" Tag="Triangle" />
                                        <ComboBoxItem Content="Open arrow" Tag="OpenArrow" />
                                        <ComboBoxItem Content="Circle" Tag="Circle" />
                                        <ComboBoxItem Content="Diamond" Tag="Diamond" />
                                        <ComboBoxItem Content="Bar" Tag="Bar" />
                                    </ComboBox>
                                    <ComboBox x:Name="EndCapChoice" Header="End cap" SelectedIndex="0"
                                        HorizontalAlignment="Stretch" SelectionChanged="Options_Changed">
                                        <ComboBoxItem Content="None" Tag="None" />
                                        <ComboBoxItem Content="Triangle" Tag="Triangle" />
                                        <ComboBoxItem Content="Open arrow" Tag="OpenArrow" />
                                        <ComboBoxItem Content="Circle" Tag="Circle" />
                                        <ComboBoxItem Content="Diamond" Tag="Diamond" />
                                        <ComboBoxItem Content="Bar" Tag="Bar" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
            <Grid x:Name="AnnotationToolbarHost" Visibility="Collapsed">
                    <StackPanel x:Name="Tools" Orientation="Horizontal" HorizontalAlignment="Center"
                        Height="28" Spacing="2" VerticalAlignment="Center" Background="Transparent"
                        AutomationProperties.Name="Annotation tools">
                        <StackPanel.Resources>
                            <ResourceDictionary>
                                <SolidColorBrush x:Key="ToolbarClearBrush" Color="Transparent" />
                                <StaticResource x:Key="ButtonBackground" ResourceKey="ToolbarClearBrush" />
                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ToolbarClearBrush" />
                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ToolbarClearBrush" />
                                <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="ToolbarClearBrush" />
                                <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ToolbarClearBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="ToolbarClearBrush" />
                                <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="ToolbarClearBrush" />
                                <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="ToolbarClearBrush" />
                            </ResourceDictionary>
                        </StackPanel.Resources>
                        <local:ToolbarActionButton CornerRadius="6" Padding="0" Margin="0" Width="28" Height="28" x:Name="SelectTool" Tag="Select" Click="Tool_Click"
                            ToolTipService.ToolTip="Select or move · V" AutomationProperties.Name="Select" AutomationProperties.AutomationId="ToolSelect">
                            <FontIcon Glyph="&#xE8B0;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12" />
                        </local:ToolbarActionButton>
                        <local:ToolbarActionButton CornerRadius="6" Padding="0" Margin="0" Width="28" Height="28" x:Name="TextTool" Tag="Text" Click="Tool_Click"
                            ToolTipService.ToolTip="Add text · T" AutomationProperties.Name="Text" AutomationProperties.AutomationId="ToolText">
                            <FontIcon Glyph="&#xE8D2;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12" />
                        </local:ToolbarActionButton>
                        <local:ToolbarActionButton CornerRadius="6" Padding="0" Margin="0" Width="28" Height="28" x:Name="StepTool" Tag="Step" Click="Tool_Click"
                            ToolTipService.ToolTip="Numbered step · N" AutomationProperties.Name="Step" AutomationProperties.AutomationId="ToolStep">
                            <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12" />
                        </local:ToolbarActionButton>
                        <local:ToolbarActionButton CornerRadius="6" Padding="0" Margin="0" Width="28" Height="28" x:Name="CalloutTool" Tag="Callout" Click="Tool_Click"
                            ToolTipService.ToolTip="Numbered annotation outside the image · C" AutomationProperties.Name="Annotate" AutomationProperties.AutomationId="ToolCallout">
                            <FontIcon Glyph="&#xE8F2;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12" />
                        </local:ToolbarActionButton>
