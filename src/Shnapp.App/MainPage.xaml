                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8D2;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="StepTool" Label="Step" Tag="Step" Click="Tool_Click"
                    ToolTipService.ToolTip="Numbered step · N" AutomationProperties.AutomationId="ToolStep">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8FD;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="LineTool" Label="Line" Tag="Line" Click="Tool_Click"
