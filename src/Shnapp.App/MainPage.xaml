<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Shnapp.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:editor="using:Shnapp.App.Editor"
    xmlns:local="using:Shnapp.App"
    FontFamily="Segoe UI Variable Text"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyAccelerator_Invoked" />
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoAccelerator_Invoked" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoAccelerator_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="RedoAccelerator_Invoked" />
    </Page.KeyboardAccelerators>
    <Grid KeyDown="Page_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent">
            <CommandBar.Content>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontWeight="SemiBold"
                    VerticalAlignment="Center" Margin="20,0,16,0" MaxWidth="260" TextTrimming="CharacterEllipsis" />
            </CommandBar.Content>
            <AppBarButton Label="New shnapp" Icon="Camera" AutomationProperties.AutomationId="NewShnapp">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Window" Tag="Window" Click="Capture_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number4" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Full screen" Tag="FullScreen" Click="Capture_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number3" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Free form (rectangle)" Tag="Region" Click="Capture_Click">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number2" Modifiers="Control,Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Label="Library" Icon="Pictures" Click="Library_Click" AutomationProperties.AutomationId="OpenLibrary" />
            <AppBarSeparator />
            <AppBarButton x:Name="CopyButton" Label="Copy" Icon="Copy" Click="Copy_Click"
                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}" AutomationProperties.AutomationId="CopyShnapp"
                ToolTipService.ToolTip="Copy flattened image · Ctrl+C" />
            <AppBarButton x:Name="SaveButton" Label="Save PNG" Icon="Save" Click="Save_Click"
                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}" AutomationProperties.AutomationId="SaveShnapp"
                ToolTipService.ToolTip="Export PNG · Ctrl+S" />
            <AppBarButton Label="Done" Icon="Accept" Click="Done_Click" AutomationProperties.AutomationId="DoneShnapp"
                ToolTipService.ToolTip="Save locally and return to the tray" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Settings" Icon="Setting" Click="Settings_Click" AutomationProperties.AutomationId="OpenSettings" />
                <AppBarButton Label="Quit Shnapp" Icon="Cancel" Click="Quit_Click" AutomationProperties.AutomationId="QuitShnapp" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="16,0,16,8" />
        <Grid x:Name="EditorHost" Grid.Row="2" Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}"
            Background="{ThemeResource ShnappCanvasBrush}">
            <canvas:CanvasControl x:Name="DrawingCanvas" Draw="Canvas_Draw" SizeChanged="Canvas_SizeChanged"
                PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved"
                PointerReleased="Canvas_PointerReleased" PointerCanceled="Canvas_PointerCanceled"
                IsTabStop="True" AutomationProperties.Name="Shnapp annotation canvas"
                AutomationProperties.AutomationId="ShnappCanvas" />
            <Canvas x:Name="TextOverlay" />
            <CommandBar x:Name="Tools" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,8,16,0"
                DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="True" CornerRadius="12"
                Background="{ThemeResource ShnappPanelBrush}">
                <AppBarToggleButton x:Name="SelectTool" Label="Select" Tag="Select" IsChecked="True" Click="Tool_Click"
                    ToolTipService.ToolTip="Select or move · V" AutomationProperties.AutomationId="ToolSelect">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8B0;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="TextTool" Label="Text" Tag="Text" Click="Tool_Click"
                    ToolTipService.ToolTip="Add text · T" AutomationProperties.AutomationId="ToolText">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8D2;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="StepTool" Label="Step" Tag="Step" Click="Tool_Click"
                    ToolTipService.ToolTip="Numbered step · N" AutomationProperties.AutomationId="ToolStep">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8FD;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="ArrowTool" Label="Arrow" Tag="Arrow" Click="Tool_Click"
                    ToolTipService.ToolTip="Arrow · A" AutomationProperties.AutomationId="ToolArrow">
                    <AppBarToggleButton.Icon><SymbolIcon Symbol="Forward" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="LineTool" Label="Line" Tag="Line" Click="Tool_Click"
                    ToolTipService.ToolTip="Line · L" AutomationProperties.AutomationId="ToolLine">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE738;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="RectangleTool" Label="Rectangle" Tag="Rectangle" Click="Tool_Click"
                    ToolTipService.ToolTip="Rectangle · R" AutomationProperties.AutomationId="ToolRectangle">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE739;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="EllipseTool" Label="Ellipse" Tag="Ellipse" Click="Tool_Click"
                    ToolTipService.ToolTip="Ellipse · E" AutomationProperties.AutomationId="ToolEllipse">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xEA3A;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="RedactTool" Label="Redact" Tag="Redaction" Click="Tool_Click"
                    ToolTipService.ToolTip="Opaque redaction · B" AutomationProperties.AutomationId="ToolRedact">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE72E;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="CropTool" Label="Crop" Tag="Crop" Click="Tool_Click"
                    ToolTipService.ToolTip="Drag to crop · Enter confirms · Esc cancels" AutomationProperties.AutomationId="ToolCrop">
                    <AppBarToggleButton.Icon><SymbolIcon Symbol="Crop" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarSeparator />
                <AppBarButton Label="Undo" Icon="Undo" Click="Undo_Click" IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}"
                    ToolTipService.ToolTip="Undo · Ctrl+Z" AutomationProperties.AutomationId="UndoEdit" />
                <AppBarButton Label="Redo" Icon="Redo" Click="Redo_Click" IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}"
                    ToolTipService.ToolTip="Redo · Ctrl+Y" AutomationProperties.AutomationId="RedoEdit" />
                <AppBarButton Label="Tool options" Icon="Setting" ToolTipService.ToolTip="Color, stroke, font, and fill"
                    AutomationProperties.AutomationId="ToolOptions">
                    <AppBarButton.Flyout>
                        <Flyout>
                            <StackPanel Width="248" Spacing="12">
                                <TextBlock Text="Tool options" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ComboBox x:Name="ColorChoice" Header="Color" SelectedIndex="0" SelectionChanged="Options_Changed"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="Annotation color">
                                    <ComboBoxItem Content="Red" Tag="FFE5484D" />
                                    <ComboBoxItem Content="Blue" Tag="FF0A84FF" />
                                    <ComboBoxItem Content="Green" Tag="FF22C55E" />
                                    <ComboBoxItem Content="Violet" Tag="FF7C5CFF" />
                                    <ComboBoxItem Content="Black" Tag="FF111418" />
                                    <ComboBoxItem Content="White" Tag="FFFFFFFF" />
                                </ComboBox>
                                <NumberBox x:Name="StrokeSize" Header="Line width (px)" Value="3" Minimum="1" Maximum="24"
                                    SpinButtonPlacementMode="Compact" ValueChanged="NumberOption_Changed" />
                                <NumberBox x:Name="FontSizeChoice" Header="Text size (px)" Value="18" Minimum="8" Maximum="144"
                                    SpinButtonPlacementMode="Compact" ValueChanged="NumberOption_Changed" />
                                <NumberBox x:Name="StepSize" Header="Step diameter (px)" Value="28" Minimum="16" Maximum="120"
                                    SpinButtonPlacementMode="Compact" ValueChanged="NumberOption_Changed" />
                                <CheckBox x:Name="FillShape" Content="Fill shapes" Click="Options_Changed" />
                                <CheckBox x:Name="BoldText" Content="Bold text" IsChecked="True" Click="Options_Changed" />
                                <TextBlock Text="Redaction is always opaque. More styling controls are planned."
                                    TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
        </Grid>
        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}" Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,20" ColumnSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Library" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Your shnapps, saved here on this PC." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <AutoSuggestBox x:Name="LibrarySearch" Grid.Column="1" Width="240" PlaceholderText="Find a shnapp"
                    TextChanged="LibrarySearch_TextChanged" AutomationProperties.Name="Search library" />
            </Grid>
            <GridView x:Name="LibraryGrid" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Library}"
                SelectionMode="None" IsItemClickEnabled="True" ItemClick="Library_ItemClick"
                ContainerContentChanging="Library_ContainerContentChanging"
                AutomationProperties.Name="Saved shnapps" AutomationProperties.AutomationId="ShnappLibrary">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="editor:LibraryEntry">
                        <StackPanel Width="224" Margin="8" Spacing="8">
                            <Grid Height="144" Background="{ThemeResource ShnappCanvasBrush}" CornerRadius="8">
                                <Image Source="{x:Bind Preview}" Stretch="Uniform" Margin="8" />
                            </Grid>
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel x:Name="LibraryEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="420" Spacing="16">
                <TextBlock x:Name="LibraryEmptyTitle" Text="Your shnapps will show up here." FontFamily="Segoe UI Variable Display"
                    FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="LibraryEmptyDescription" Text="Capture first. Think less." FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="LibraryEmptyCapture" Content="Shnapp a window" Tag="Window" Click="Capture_Click"
                    Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
                <StackPanel x:Name="LibraryEmptyShortcuts" Spacing="6">
                    <TextBlock Text="Ctrl+Shift+4    Window" FontFamily="Cascadia Mono" FontSize="12" />
                    <TextBlock Text="Ctrl+Shift+3    Full screen" FontFamily="Cascadia Mono" FontSize="12" />
                    <TextBlock Text="Ctrl+Shift+2    Free form" FontFamily="Cascadia Mono" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Padding="20,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ShnappStatus" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Dimensions, Mode=OneWay}" FontFamily="Cascadia Mono"
                FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
