<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Shnapp.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Shnapp.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Shnapp"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <!-- The document frame owns the entire window so the image is painted
             behind the title bar instead of starting below it. -->
        <Frame x:Name="RootFrame" />
        <ContentControl x:Name="SettingsOverlay" Visibility="Collapsed" Margin="0,48,0,0"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <TitleBar x:Name="AppTitleBar" Height="48"
            VerticalAlignment="Top" Background="{ThemeResource ShnappImageChromeBrush}">
            <TitleBar.LeftHeader>
                <StackPanel x:Name="TitleLeftControls" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Grid Width="32" Height="32" AutomationProperties.Name="Shnapp">
                        <Image Source="Assets/AppIcon.ico" Width="16" Height="16"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="ChromeNavigationHost" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" />
                    <StackPanel x:Name="EditorTitleActions" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" Visibility="Collapsed">
                        <ToggleButton x:Name="TitleEditButton" Width="58" Height="32" Padding="0" Click="TitleEdit_Click" CornerRadius="7"
                            IsChecked="False" ToolTipService.ToolTip="Show or hide editing tools"
                            AutomationProperties.Name="Editing tools" AutomationProperties.AutomationId="TitleEdit">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Edit" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <ToggleButton.Resources>
                                <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="ShnappToolbarBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="ShnappToolbarBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="ShnappToolbarBrush" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                            </ToggleButton.Resources>
                        </ToggleButton>
                        <StackPanel x:Name="TitleHistoryActions" Orientation="Horizontal" Spacing="6">
                            <AppBarButton x:Name="TitleUndoButton" Width="32" Height="32" MinWidth="0" Padding="0" Label="Undo" LabelPosition="Collapsed" Click="TitleUndo_Click"
                                ToolTipService.ToolTip="Undo · Ctrl+Z" AutomationProperties.Name="Undo" AutomationProperties.AutomationId="UndoEdit">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;" FontSize="16" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="TitleRedoButton" Width="32" Height="32" MinWidth="0" Padding="0" Label="Redo" LabelPosition="Collapsed" Click="TitleRedo_Click"
                                ToolTipService.ToolTip="Redo · Ctrl+Y" AutomationProperties.Name="Redo" AutomationProperties.AutomationId="RedoEdit">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE7A6;" FontSize="16" /></AppBarButton.Icon>
                            </AppBarButton>
                        </StackPanel>
                    </StackPanel>
                    <Grid VerticalAlignment="Center">
                        <ContentControl x:Name="ChromeCommandsHost" VerticalAlignment="Center" />
                        <Ellipse x:Name="UpdateAttentionDot" Width="8" Height="8"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,9,0"
                            Fill="#D6294D" Stroke="{ThemeResource ShnappChromeBrush}"
                            StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </StackPanel>
            </TitleBar.LeftHeader>
            <TitleBar.RightHeader>
                <SplitButton x:Name="TitleSaveActions" Width="88" Height="32" MinWidth="0"
                    Padding="8,0" CornerRadius="7" Content="Save" FontSize="12" FontWeight="SemiBold"
                    Click="TitleSave_Click" Visibility="Collapsed" Margin="0,0,10,0"
                    Background="{ThemeResource ShnappBlueBrush}"
                    Foreground="{ThemeResource ShnappOnBlueBrush}"
                    ToolTipService.ToolTip="Save PNG or open more save actions"
                    AutomationProperties.Name="Save actions" AutomationProperties.AutomationId="TitleSaveActions">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Save PNG…" Click="TitleSaveMenu_Click"
                                AutomationProperties.AutomationId="SaveShnappFromTitle" />
                            <MenuFlyoutItem Text="Save as copy" Click="TitleSaveCopy_Click"
                                AutomationProperties.AutomationId="SaveAsCopy" />
                            <MenuFlyoutItem Text="Copy image" Click="TitleCopy_Click"
                                AutomationProperties.AutomationId="CopyShnappFromTitle" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </TitleBar.RightHeader>
        </TitleBar>
        <Grid x:Name="TitleEditorHost" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,56,0,0" />
    </Grid>
</Window>
