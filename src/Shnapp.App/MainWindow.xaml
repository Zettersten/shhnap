<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Shnapp.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Shnapp.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Shnapp"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <!-- The document frame owns the entire window so the image is painted
             behind the title bar instead of starting below it. -->
        <Frame x:Name="RootFrame" />
        <ContentControl x:Name="SettingsOverlay" Visibility="Collapsed" Margin="0,48,0,0"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <TitleBar x:Name="AppTitleBar" Height="48"
            VerticalAlignment="Top" Background="{ThemeResource ShnappImageChromeBrush}">
            <TitleBar.Resources>
                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            </TitleBar.Resources>
            <TitleBar.LeftHeader>
                <StackPanel x:Name="TitleLeftControls" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Grid Width="28" Height="28" AutomationProperties.Name="Shnapp">
                        <Image Source="Assets/AppIcon.ico" Width="12" Height="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="ChromeNavigationHost" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" />
                    <Border Width="1" Height="16" Margin="5,0" VerticalAlignment="Center"
                        Background="{ThemeResource ShnappFloatingEdgeBrush}" Opacity="0.5" />
                    <ContentControl x:Name="ChromeToolsHost" VerticalAlignment="Center" />
                </StackPanel>
            </TitleBar.LeftHeader>
            <TitleBar.RightHeader>
                <StackPanel x:Name="TitleRightControls" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center" Margin="0,0,8,0">
                    <local:ToolbarActionButton x:Name="TitleUndoButton" Width="28" Height="28" MinWidth="0" Padding="0"
                        CornerRadius="6" Click="TitleUndo_Click"
                        ToolTipService.ToolTip="Undo · Ctrl+Z" AutomationProperties.Name="Undo" AutomationProperties.AutomationId="UndoEdit">
                        <FontIcon Glyph="&#xE7A7;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12" />
                    </local:ToolbarActionButton>
                    <local:ToolbarActionButton x:Name="TitleRedoButton" Width="28" Height="28" MinWidth="0" Padding="0"
                        CornerRadius="6" Click="TitleRedo_Click"
                        ToolTipService.ToolTip="Redo · Ctrl+Y" AutomationProperties.Name="Redo" AutomationProperties.AutomationId="RedoEdit">
                        <FontIcon Glyph="&#xE7A6;" FontFamily="Segoe Fluent Icons" FontSize="12" Width="12" Height="12" />
                    </local:ToolbarActionButton>
                    <Border Width="1" Height="16" Margin="5,0" VerticalAlignment="Center"
                        Background="{ThemeResource ShnappFloatingEdgeBrush}" Opacity="0.5" />
                    <ContentControl x:Name="ChromeLibraryHost" VerticalAlignment="Center" />
                    <ContentControl x:Name="ChromeCommandsHost" VerticalAlignment="Center" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>
        <Grid x:Name="TitleEditorHost" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,56,0,0" />
    </Grid>
</Window>
