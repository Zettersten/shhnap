<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Shnapp.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Shnapp.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Shnapp"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <!-- The document frame owns the entire window so the image is painted
             behind the title bar instead of starting below it. -->
        <Frame x:Name="RootFrame" />
        <ContentControl x:Name="SettingsOverlay" Visibility="Collapsed" Margin="0,48,0,0"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <TitleBar x:Name="AppTitleBar" Height="48"
            VerticalAlignment="Top" Background="{ThemeResource ShnappImageChromeBrush}">
            <TitleBar.LeftHeader>
                <StackPanel x:Name="TitleLeftControls" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Image Source="Assets/AppIcon.ico" Width="20" Height="20" Margin="4,0,8,0"
                        AutomationProperties.Name="Shnapp" />
                    <StackPanel x:Name="ChromeNavigationHost" Orientation="Horizontal" Spacing="2"
                        VerticalAlignment="Center" />
                    <StackPanel x:Name="EditorTitleActions" Orientation="Horizontal" Spacing="2"
                        VerticalAlignment="Center" Visibility="Collapsed">
                        <Button Width="58" Height="32" Padding="0" Click="TitleEdit_Click" CornerRadius="7"
                            ToolTipService.ToolTip="Edit annotations" AutomationProperties.Name="Edit annotations">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE70F;" FontSize="16" />
                                <TextBlock Text="Edit" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <AppBarButton x:Name="TitleUndoButton" Width="32" Height="32" MinWidth="0" Label="Undo" LabelPosition="Collapsed" Click="TitleUndo_Click"
                            ToolTipService.ToolTip="Undo · Ctrl+Z" AutomationProperties.Name="Undo">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;" FontSize="16" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="TitleRedoButton" Width="32" Height="32" MinWidth="0" Label="Redo" LabelPosition="Collapsed" Click="TitleRedo_Click"
                            ToolTipService.ToolTip="Redo · Ctrl+Y" AutomationProperties.Name="Redo">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE7A6;" FontSize="16" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Width="32" Height="32" MinWidth="0" Label="Copy" LabelPosition="Collapsed" Click="TitleCopy_Click"
                            ToolTipService.ToolTip="Copy image · Ctrl+C" AutomationProperties.Name="Copy image">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" FontSize="16" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Width="32" Height="32" MinWidth="0" Label="Save" LabelPosition="Collapsed" Click="TitleSave_Click"
                            ToolTipService.ToolTip="Save PNG · Ctrl+S" AutomationProperties.Name="Save PNG">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" FontSize="16" /></AppBarButton.Icon>
                        </AppBarButton>
                    </StackPanel>
                    <Grid VerticalAlignment="Center">
                        <ContentControl x:Name="ChromeCommandsHost" VerticalAlignment="Center" />
                        <Ellipse x:Name="UpdateAttentionDot" Width="8" Height="8"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,9,0"
                            Fill="#D6294D" Stroke="{ThemeResource ShnappChromeBrush}"
                            StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </StackPanel>
            </TitleBar.LeftHeader>
        </TitleBar>
        <Grid Height="48" VerticalAlignment="Top">
            <Button x:Name="WindowDocumentTitleButton" IsHitTestVisible="False" Click="WindowDocumentTitle_Click"
                Background="Transparent" BorderThickness="0" Padding="8,0" Height="32"
                HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="7"
                ToolTipService.ToolTip="Rename shnapp" AutomationProperties.Name="Rename shnapp">
                <TextBlock x:Name="WindowDocumentTitle" Text="Shnapp" FontSize="13"
                    FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Button>
        </Grid>
        <Grid x:Name="TitleEditorHost" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,8,0,0" />
    </Grid>
</Window>
