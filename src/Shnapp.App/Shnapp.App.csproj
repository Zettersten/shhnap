<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Shnapp.App</RootNamespace>
    <AssemblyName>Shnapp</AssemblyName>
    <Product>Shnapp</Product>
    <Authors>Erik Zettersten</Authors>
    <Company>Erik Zettersten</Company>
    <Copyright>Copyright © Erik Zettersten</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- CI opts into Store packaging with -p:ShnappDistribution=Store. -->
    <WindowsPackageType Condition="'$(ShnappDistribution)' == 'Store'">MSIX</WindowsPackageType>
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <EnableMsixTooling Condition="'$(ShnappDistribution)' == 'Store'">true</EnableMsixTooling>
    <EnableMsixTooling Condition="'$(ShnappDistribution)' == 'PortableSingleFile'">true</EnableMsixTooling>
    <EnableMsixTooling Condition="'$(EnableMsixTooling)' == ''">false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(ShnappDistribution)' == 'PortableSingleFile'">true</SelfContained>
    <PublishSingleFile Condition="'$(ShnappDistribution)' == 'PortableSingleFile'">true</PublishSingleFile>
    <IncludeAllContentForSelfExtract Condition="'$(ShnappDistribution)' == 'PortableSingleFile'">true</IncludeAllContentForSelfExtract>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Store artwork is retained in source, but the portable build has no package manifest. -->
  <ItemGroup Condition="'$(WindowsPackageType)' != 'None'">
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ShnappLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\LibraryEmptyBackground.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\NewShnappButton*.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\provenance.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Store job generates these from the exact runtime/NuGet versions before MSIX packaging. -->
  <ItemGroup Condition="'$(ShnappDistribution)' == 'Store'">
    <Content Include="obj\$(Platform)\DistributionNotices\**\*"
             Link="%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Self-contained WinUI generates a manifest with its WinRT registrations. Add
       the pan cursors to that manifest and the app icon in one native resource. -->
  <Target Name="CompileShnappNativeResources" BeforeTargets="CoreCompile"
          DependsOnTargets="CreateWinRTRegistration;SetWin32ManifestProperties">
    <PropertyGroup>
      <_ShnappAssetDirectory>$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\', '/'))/Assets</_ShnappAssetDirectory>
      <_ShnappManifestPath>$([System.String]::Copy('$(ApplicationManifest)').Replace('\', '/'))</_ShnappManifestPath>
      <_ShnappNativeVersion Condition="'$(FileVersion)' != ''">$(FileVersion)</_ShnappNativeVersion>
      <_ShnappNativeVersion Condition="'$(FileVersion)' == ''">$(Version).0</_ShnappNativeVersion>
      <_ShnappNativeVersionCommas>$([System.String]::Copy('$(_ShnappNativeVersion)').Replace('.', ','))</_ShnappNativeVersionCommas>
    </PropertyGroup>
    <ItemGroup>
      <_ShnappNativeResourceLine Include="1 ICON &quot;$(_ShnappAssetDirectory)/AppIcon.ico&quot;" />
      <_ShnappNativeResourceLine Include="1 24 &quot;$(_ShnappManifestPath)&quot;" />
      <_ShnappNativeResourceLine Include="101 CURSOR &quot;$(_ShnappAssetDirectory)/PanOpen.cur&quot;" />
      <_ShnappNativeResourceLine Include="102 CURSOR &quot;$(_ShnappAssetDirectory)/PanClosed.cur&quot;" />
      <_ShnappNativeResourceLine Include="1 VERSIONINFO" />
      <_ShnappNativeResourceLine Include="FILEVERSION $(_ShnappNativeVersionCommas)" />
      <_ShnappNativeResourceLine Include="PRODUCTVERSION $(_ShnappNativeVersionCommas)" />
      <_ShnappNativeResourceLine Include="FILEFLAGSMASK 0x3fL" />
      <_ShnappNativeResourceLine Include="FILEFLAGS 0x0L" />
      <_ShnappNativeResourceLine Include="FILEOS 0x40004L" />
      <_ShnappNativeResourceLine Include="FILETYPE 0x1L" />
      <_ShnappNativeResourceLine Include="FILESUBTYPE 0x0L" />
      <_ShnappNativeResourceLine Include="BEGIN" />
      <_ShnappNativeResourceLine Include="BLOCK &quot;StringFileInfo&quot;" />
      <_ShnappNativeResourceLine Include="BEGIN" />
      <_ShnappNativeResourceLine Include="BLOCK &quot;040904B0&quot;" />
      <_ShnappNativeResourceLine Include="BEGIN" />
      <_ShnappNativeResourceLine Include="VALUE &quot;CompanyName&quot;, &quot;$(Company)\0&quot;" />
      <_ShnappNativeResourceLine Include="VALUE &quot;FileDescription&quot;, &quot;$(Product)\0&quot;" />
      <_ShnappNativeResourceLine Include="VALUE &quot;FileVersion&quot;, &quot;$(_ShnappNativeVersion)\0&quot;" />
      <_ShnappNativeResourceLine Include="VALUE &quot;InternalName&quot;, &quot;$(AssemblyName)\0&quot;" />
      <_ShnappNativeResourceLine Include="VALUE &quot;LegalCopyright&quot;, &quot;Copyright 2026 Erik Zettersten\0&quot;" />
      <_ShnappNativeResourceLine Include="VALUE &quot;OriginalFilename&quot;, &quot;$(AssemblyName).exe\0&quot;" />
      <_ShnappNativeResourceLine Include="VALUE &quot;ProductName&quot;, &quot;$(Product)\0&quot;" />
      <_ShnappNativeResourceLine Include="VALUE &quot;ProductVersion&quot;, &quot;$(_ShnappNativeVersion)\0&quot;" />
      <_ShnappNativeResourceLine Include="END" />
      <_ShnappNativeResourceLine Include="END" />
      <_ShnappNativeResourceLine Include="BLOCK &quot;VarFileInfo&quot;" />
      <_ShnappNativeResourceLine Include="BEGIN" />
      <_ShnappNativeResourceLine Include="VALUE &quot;Translation&quot;, 0x409, 1200" />
      <_ShnappNativeResourceLine Include="END" />
      <_ShnappNativeResourceLine Include="END" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)ShnappNative.rc"
                      Lines="@(_ShnappNativeResourceLine)" Overwrite="true" />
    <Exec Command="&quot;$(WindowsSDKBuildToolsBinVersionedArchFolder)\rc.exe&quot; /nologo /fo &quot;$(IntermediateOutputPath)ShnappNative.res&quot; &quot;$(IntermediateOutputPath)ShnappNative.rc&quot;" />
    <PropertyGroup>
      <Win32Resource>$(IntermediateOutputPath)ShnappNative.res</Win32Resource>
      <Win32Manifest></Win32Manifest>
      <NoWin32Manifest>true</NoWin32Manifest>
    </PropertyGroup>
  </Target>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <ProjectReference Include="..\Shnapp.Core\Shnapp.Core.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- ReadyToRun grows portable releases; trimming needs CsWinRT and COM-path validation before use. -->
  <PropertyGroup>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Windows App SDK 2.3 generates the app PRI but omits it from unpackaged publish output. -->
  <Target Name="IncludeUnpackagedProjectPriInPublish"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(WindowsPackageType)' == 'None'">
    <Error Condition="!Exists('$(ProjectPriFullPath)')"
           Text="The generated Shnapp.pri is missing from the build output." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
