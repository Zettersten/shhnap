<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Shnapp.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Segoe UI Variable Text"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingsSupportingTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <NavigationView x:Name="SettingsNavigation"
        PaneTitle="Settings"
        PaneDisplayMode="LeftMinimal"
        OpenPaneLength="252"
        IsPaneOpen="False"
        IsPaneToggleButtonVisible="True"
        IsSettingsVisible="False"
        IsBackButtonVisible="Collapsed"
        AlwaysShowHeader="False"
        SelectionChanged="SettingsNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="General" Tag="general" AutomationProperties.AutomationId="SettingsGeneral">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="About &amp; Updates" Tag="updates" AutomationProperties.AutomationId="SettingsUpdates">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Feedback" Tag="feedback" AutomationProperties.AutomationId="SettingsFeedback">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE939;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.Content>
            <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto"
                HorizontalContentAlignment="Stretch">
                <StackPanel MaxWidth="840" HorizontalAlignment="Stretch" Margin="32,20,32,48" Spacing="28">
                    <Button Click="BackToEditor_Click" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="BackToEditor">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" />
                            <TextBlock Text="Back to editor" />
                        </StackPanel>
                    </Button>
                    <InfoBar x:Name="ExternalLinkMessage" IsOpen="False" IsClosable="True" />

                    <StackPanel x:Name="GeneralPanel" Spacing="28">
                        <StackPanel Spacing="6">
                            <TextBlock Text="General" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="Choose how Shnapp captures and handles your work."
                                Style="{StaticResource SettingsSupportingTextStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Capture" Style="{StaticResource SettingsSectionTitleStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <Grid Margin="18,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" Margin="0,0,16,0">
                                            <TextBlock Text="Start Shnapp at sign-in" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Keep capture one shortcut away after Windows starts."
                                                Style="{StaticResource SettingsSupportingTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="StartAtSignIn" Grid.Column="1" VerticalAlignment="Center"
                                            AutomationProperties.Name="Start Shnapp at sign-in"
                                            AutomationProperties.AutomationId="StartOnLogin" />
                                    </Grid>
                                    <Rectangle Height="1" Margin="18,0" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Grid Margin="18,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" Margin="0,0,16,0">
                                            <TextBlock Text="Copy new shnapps automatically" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Your latest capture is ready to paste."
                                                Style="{StaticResource SettingsSupportingTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AutoCopy" Grid.Column="1" VerticalAlignment="Center"
                                            AutomationProperties.Name="Copy new shnapps automatically"
                                            AutomationProperties.AutomationId="AutoCopy" />
                                    </Grid>
                                    <Rectangle Height="1" Margin="18,0" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Grid Margin="18,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3" Margin="0,0,16,0">
                                            <TextBlock Text="Soft shadow on window shnapps" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Give captured windows a little separation when shared."
                                                Style="{StaticResource SettingsSupportingTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="WindowShadow" Grid.Column="1" VerticalAlignment="Center"
                                            AutomationProperties.Name="Soft shadow on window shnapps"
                                            AutomationProperties.AutomationId="WindowShadow" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionTitleStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="18,16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                                    <TextBlock Text="Match Windows or choose the look that suits your workspace."
                                        Style="{StaticResource SettingsSupportingTextStyle}" />
                                    <ComboBox x:Name="ThemePicker" MinWidth="200" HorizontalAlignment="Left"
                                        AutomationProperties.Name="Theme" AutomationProperties.AutomationId="ShnappTheme">
                                        <ComboBoxItem Content="System" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Dark" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SettingsSectionTitleStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="18,16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Capture a window" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="Ctrl+Shift+4" FontFamily="Cascadia Mono"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,0,0,0" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Capture full screen" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="Ctrl+Shift+3" FontFamily="Cascadia Mono"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,0,0,0" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Capture a region" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="Ctrl+Shift+2" FontFamily="Cascadia Mono"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Local library" Style="{StaticResource SettingsSectionTitleStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="18,16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Saved shnapps" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LibraryPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock x:Name="LibraryNote" Style="{StaticResource SettingsSupportingTextStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button Content="Save preferences" Click="SavePreferences_Click"
                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="SavePreferences" />
                        <InfoBar x:Name="PreferenceMessage" IsOpen="False" IsClosable="True" />
                    </StackPanel>

                    <StackPanel x:Name="UpdatesPanel" Spacing="28" Visibility="Collapsed">
                        <StackPanel Spacing="6">
                            <TextBlock Text="About &amp; Updates" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="App details and the latest available release."
                                Style="{StaticResource SettingsSupportingTextStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Shnapp" Style="{StaticResource SettingsSectionTitleStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="18,16">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="VersionLabel" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                                    <TextBlock x:Name="RuntimeLabel" IsTextSelectionEnabled="True"
                                        Style="{StaticResource SettingsSupportingTextStyle}" />
                                    <TextBlock Text="Published by Erik Zettersten · MIT licensed"
                                        Style="{StaticResource SettingsSupportingTextStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Updates" Style="{StaticResource SettingsSectionTitleStyle}" />
                            <TextBlock x:Name="UpdateChannelLabel" Style="{StaticResource SettingsSupportingTextStyle}" />
                            <InfoBar x:Name="UpdateMessage" IsOpen="True" IsClosable="False"
                                Severity="Informational" Title="Update status" />
                            <StackPanel Spacing="8" HorizontalAlignment="Left">
                                <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click"
                                    Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="CheckForUpdates" />
                                <Button x:Name="OpenLatestButton" Content="View release" Click="OpenLatest_Click"
                                    Visibility="Collapsed" AutomationProperties.AutomationId="ViewLatestRelease" />
                                <Button x:Name="InstallStoreUpdateButton" Content="Update now" Click="InstallStoreUpdate_Click"
                                    Visibility="Collapsed" AutomationProperties.AutomationId="InstallStoreUpdate" />
                                <Button x:Name="RestartStoreButton" Content="Restart Shnapp" Click="RestartStore_Click"
                                    Visibility="Collapsed" AutomationProperties.AutomationId="RestartAfterStoreUpdate" />
                                <Button x:Name="RestartPortableButton" Content="Restart to update" Click="RestartPortable_Click"
                                    Visibility="Collapsed" AutomationProperties.AutomationId="RestartAfterPortableUpdate" />
                                <Button x:Name="ManagerUpdateButton" Content="Update with package manager" Click="ManagerUpdate_Click"
                                    Visibility="Collapsed" AutomationProperties.AutomationId="UpdateWithPackageManager" />
                                <Button x:Name="OpenStoreButton" Content="Open Microsoft Store updates" Click="OpenStore_Click"
                                    Visibility="Collapsed" AutomationProperties.AutomationId="OpenStoreUpdates" />
                            </StackPanel>
                            <TextBlock x:Name="UpdateHelpText"
                                Text="Shnapp checks for newer versions."
                                Style="{StaticResource SettingsSupportingTextStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Links" Style="{StaticResource SettingsSectionTitleStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="18,16">
                                <StackPanel Spacing="8" HorizontalAlignment="Left">
                                    <Button Content="Visit shhnap.com" Click="OpenWebsite_Click"
                                        AutomationProperties.AutomationId="OpenWebsite" />
                                    <Button Content="Open source repository" Click="OpenRepository_Click"
                                        AutomationProperties.AutomationId="OpenRepository" />
                                    <Button Content="About the publisher" Click="OpenPublisher_Click"
                                        AutomationProperties.AutomationId="OpenPublisher" />
                                    <Button Content="Privacy" Click="OpenPrivacy_Click"
                                        AutomationProperties.AutomationId="OpenPrivacy" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="FeedbackPanel" Spacing="28" Visibility="Collapsed">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Feedback" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="Help make Shnapp better."
                                Style="{StaticResource SettingsSupportingTextStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <TextBlock Text="Share an idea or issue" Style="{StaticResource SettingsSectionTitleStyle}" />
                            <TextBlock Text="GitHub issues keep bug reports and feature ideas in one place."
                                Style="{StaticResource SettingsSupportingTextStyle}" />
                            <StackPanel Spacing="8" HorizontalAlignment="Left">
                                <Button Content="Report a bug" Click="ReportBug_Click"
                                    Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ReportBug" />
                                <Button Content="Request a feature" Click="RequestFeature_Click"
                                    AutomationProperties.AutomationId="RequestFeature" />
                                <Button Content="Browse existing issues" Click="BrowseIssues_Click"
                                    AutomationProperties.AutomationId="BrowseIssues" />
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}" Padding="18,16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Before you send" FontWeight="SemiBold" />
                                <TextBlock Text="Include your Shnapp version and Windows version when reporting a bug. Avoid sharing private captures."
                                    Style="{StaticResource SettingsSupportingTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView.Content>
    </NavigationView>
</Page>
