<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Shnapp.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shnapp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShnappCanvasBrush" Color="#F1F3F6" />
                    <SolidColorBrush x:Key="ShnappPanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ShnappBlueBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="ShnappOnBlueBrush" Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ShnappCanvasBrush" Color="#171A1F" />
                    <SolidColorBrush x:Key="ShnappPanelBrush" Color="#20242A" />
                    <SolidColorBrush x:Key="ShnappBlueBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="ShnappOnBlueBrush" Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ShnappCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ShnappPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ShnappBlueBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ShnappOnBlueBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
