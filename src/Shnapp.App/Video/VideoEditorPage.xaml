<Page
    x:Class="Shnapp.App.Video.VideoEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Shnapp.App"
    Unloaded="Page_Unloaded">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="Paste_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="Undo_Invoked" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="Redo_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="Redo_Invoked" />
        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="Export_Invoked" />
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Invoked" />
        <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="Library_Invoked" />
        <KeyboardAccelerator Key="G" Modifiers="Control,Shift" Invoked="Gallery_Invoked" />
        <KeyboardAccelerator Key="Space" Invoked="PlayPause_Invoked" />
        <KeyboardAccelerator Key="I" Invoked="MarkIn_Invoked" />
        <KeyboardAccelerator Key="O" Invoked="MarkOut_Invoked" />
        <KeyboardAccelerator Key="S" Invoked="Split_Invoked" />
        <KeyboardAccelerator Key="Delete" Invoked="DeleteClip_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Background="{ThemeResource ShnappCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid x:Name="PreviewHost" Grid.Row="1" Background="#080F1C"
            SizeChanged="PreviewHost_SizeChanged"
            PointerMoved="PreviewHost_PointerMoved"
            PointerExited="PreviewHost_PointerExited"
            AllowDrop="True" DragOver="GalleryMedia_DragOver" Drop="GalleryMedia_Drop">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="CompactVideoPreview">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="InspectorPanel.Width" Value="192" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideVideoPreview">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="800" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="InspectorPanel.Width" Value="244" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <MediaPlayerElement x:Name="VideoPlayer" AutoPlay="False"
                AreTransportControlsEnabled="False" Stretch="Uniform"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <ProgressRing x:Name="PreviewProgress" IsActive="False"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" />
            <Grid Background="Transparent" AllowDrop="True"
                DragOver="GalleryMedia_DragOver" Drop="GalleryMedia_Drop" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                Padding="2" CornerRadius="8" Background="{ThemeResource ShnappImageChromeBrush}"
                BorderBrush="{ThemeResource ShnappFloatingEdgeBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <local:ToolbarActionButton Width="28" Height="28" MinWidth="0" Padding="0"
                        CornerRadius="6" Background="Transparent" BorderThickness="0"
                        Click="AddImage_Click" AutomationProperties.Name="Browse saved media"
                        ToolTipService.ToolTip="Browse saved videos and images · Ctrl+Shift+G">
                        <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe Fluent Icons"
                            FontSize="12" Width="12" Height="12" />
                    </local:ToolbarActionButton>
                    <local:ToolbarActionButton Width="28" Height="28" MinWidth="0" Padding="0"
                        CornerRadius="6" Background="Transparent" BorderThickness="0"
                        Click="AddAudio_Click" AutomationProperties.Name="Add audio track"
                        ToolTipService.ToolTip="Add an audio track">
                        <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe Fluent Icons"
                            FontSize="12" Width="12" Height="12" />
                    </local:ToolbarActionButton>
                    <Border Width="1" Height="16" Margin="2,0" VerticalAlignment="Center"
                        Background="{ThemeResource ShnappFloatingEdgeBrush}" Opacity="0.5" />
                    <local:ToolbarActionButton Width="28" Height="28" MinWidth="0" Padding="0"
                        CornerRadius="6" Background="Transparent" BorderThickness="0"
                        Click="Export_Click" AutomationProperties.Name="Export video as MP4"
                        ToolTipService.ToolTip="Export MP4 · Ctrl+E">
                        <FontIcon Glyph="&#xEDE1;" FontFamily="Segoe Fluent Icons"
                            FontSize="12" Width="12" Height="12" />
                    </local:ToolbarActionButton>
                </StackPanel>
            </Border>
            <local:ToolbarActionButton x:Name="GalleryHotspot" Width="24" Height="48"
                MinWidth="0" Padding="0" CornerRadius="0,8,8,0"
                Background="{ThemeResource ShnappImagePanelBrush}" BorderThickness="0"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Click="GalleryHotspot_Click" PointerEntered="GalleryHotspot_PointerEntered"
                AutomationProperties.Name="Browse saved videos and images"
                ToolTipService.ToolTip="Browse saved videos and images · Ctrl+Shift+G">
                <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe Fluent Icons" FontSize="12"
                    Width="12" Height="12" />
            </local:ToolbarActionButton>
            <Border x:Name="GalleryPanel" Visibility="Collapsed" Width="80"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                Padding="8" CornerRadius="12"
                BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Background="{ThemeResource ShnappImagePanelBrush}"
                PointerExited="GalleryPanel_PointerExited"
                PointerWheelChanged="GalleryPanel_PointerWheelChanged"
                AutomationProperties.Name="Saved videos and images. Click a video to open it, or drag media onto the timeline to add it.">
                <StackPanel Spacing="4">
                    <local:ToolbarActionButton x:Name="GalleryPrevious" Width="58" Height="28"
                        MinWidth="0" Padding="0" CornerRadius="8"
                        Background="Transparent" BorderThickness="0"
                        Click="GalleryPrevious_Click" AutomationProperties.Name="Previous saved media">
                        <FontIcon Glyph="&#xE70E;" FontFamily="Segoe Fluent Icons" FontSize="12"
                            Width="12" Height="12" />
                    </local:ToolbarActionButton>
                    <StackPanel x:Name="GalleryItemsHost" Spacing="6" />
                    <local:ToolbarActionButton x:Name="GalleryNext" Width="58" Height="28"
                        MinWidth="0" Padding="0" CornerRadius="8"
                        Background="Transparent" BorderThickness="0"
                        Click="GalleryNext_Click" AutomationProperties.Name="More saved media">
                        <FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="12"
                            Width="12" Height="12" />
                    </local:ToolbarActionButton>
                </StackPanel>
            </Border>

            <Border x:Name="InspectorPanel" Visibility="Collapsed" Width="244"
                HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="8"
                Padding="12" CornerRadius="10"
                BorderThickness="1" BorderBrush="{ThemeResource ShnappFloatingEdgeBrush}"
                Background="{ThemeResource ShnappInspectorAcrylicBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="SelectedItemTitle" Text="Clip" FontSize="13"
                            FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"
                            MaxWidth="132" TextTrimming="CharacterEllipsis" />
                        <local:ToolbarActionButton HorizontalAlignment="Right" Width="28" Height="28"
                            MinWidth="0" Padding="0" CornerRadius="6"
                            Background="Transparent" BorderThickness="0"
                            Click="CloseInspector_Click" AutomationProperties.Name="Close clip properties"
                            ToolTipService.ToolTip="Close clip properties">
                            <FontIcon Glyph="&#xE8BB;" FontFamily="Segoe Fluent Icons"
                                FontSize="12" Width="12" Height="12" />
                        </local:ToolbarActionButton>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="7">
                            <TextBlock x:Name="SelectedItemDetail" FontSize="10" TextWrapping="WrapWholeWords"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <NumberBox x:Name="ClipStartSeconds" Header="Start (s)"
                                AutomationProperties.Name="Clip start time in seconds"
                                Minimum="0" SpinButtonPlacementMode="Compact" FontSize="11"
                                ValueChanged="InspectorNumber_ValueChanged" />
                            <Grid x:Name="SourceFields" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="ClipSourceInSeconds" Header="In (s)"
                                    AutomationProperties.Name="Source in time in seconds"
                                    MinWidth="0" Minimum="0" SpinButtonPlacementMode="Compact" FontSize="11"
                                    ValueChanged="InspectorNumber_ValueChanged" />
                                <NumberBox x:Name="ClipSourceOutSeconds" Grid.Column="1" Header="Out (s)"
                                    AutomationProperties.Name="Source out time in seconds"
                                    MinWidth="0" Minimum="0" SpinButtonPlacementMode="Compact" FontSize="11"
                                    ValueChanged="InspectorNumber_ValueChanged" />
                            </Grid>
                            <StackPanel x:Name="AudioFields" Visibility="Collapsed" Spacing="7">
                                <TextBlock Text="Gain" FontSize="11" />
                                <Slider x:Name="AudioGainSlider" Minimum="0" Maximum="4"
                                    StepFrequency="0.05" SmallChange="0.05"
                                    ValueChanged="InspectorSlider_ValueChanged" />
                                <ToggleSwitch x:Name="AudioMuteSwitch" Header="Mute this clip"
                                    OnContent="Muted" OffContent="Audible" FontSize="11"
                                    Toggled="InspectorMute_Toggled" />
                            </StackPanel>
                            <Grid x:Name="OverlayFields" Visibility="Collapsed" RowSpacing="7" ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="OverlayDurationSeconds" Grid.ColumnSpan="2" Header="Duration (s)"
                                    AutomationProperties.Name="Image duration in seconds"
                                    Minimum="0.1" SpinButtonPlacementMode="Compact" FontSize="11"
                                    ValueChanged="InspectorNumber_ValueChanged" />
                                <NumberBox x:Name="OverlayX" Grid.Row="1" Header="Left (px)"
                                    AutomationProperties.Name="Image left position in pixels"
                                    MinWidth="0" SpinButtonPlacementMode="Compact" FontSize="11"
                                    ValueChanged="InspectorNumber_ValueChanged" />
                                <NumberBox x:Name="OverlayY" Grid.Row="1" Grid.Column="1" Header="Top (px)"
                                    AutomationProperties.Name="Image top position in pixels"
                                    MinWidth="0" SpinButtonPlacementMode="Compact" FontSize="11"
                                    ValueChanged="InspectorNumber_ValueChanged" />
                                <NumberBox x:Name="OverlayWidth" Grid.Row="2" Header="Width (px)"
                                    AutomationProperties.Name="Image width in pixels"
                                    MinWidth="0" Minimum="1" SpinButtonPlacementMode="Compact" FontSize="11"
                                    ValueChanged="InspectorNumber_ValueChanged" />
                                <NumberBox x:Name="OverlayHeight" Grid.Row="2" Grid.Column="1" Header="Height (px)"
                                    AutomationProperties.Name="Image height in pixels"
                                    MinWidth="0" Minimum="1" SpinButtonPlacementMode="Compact" FontSize="11"
                                    ValueChanged="InspectorNumber_ValueChanged" />
                                <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                    <TextBlock Text="Layer order" FontSize="11" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                        <local:ToolbarActionButton x:Name="MoveImageForwardButton"
                                            Width="28" Height="28" MinWidth="0" Padding="0"
                                            CornerRadius="6" Background="Transparent" BorderThickness="0"
                                            Click="MoveImageForward_Click"
                                            AutomationProperties.Name="Move image layer forward"
                                            ToolTipService.ToolTip="Move image in front of the next layer">
                                            <FontIcon Glyph="&#xE70E;" FontFamily="Segoe Fluent Icons"
                                                FontSize="12" Width="12" Height="12" />
                                        </local:ToolbarActionButton>
                                        <local:ToolbarActionButton x:Name="MoveImageBackButton"
                                            Width="28" Height="28" MinWidth="0" Padding="0"
                                            CornerRadius="6" Background="Transparent" BorderThickness="0"
                                            Click="MoveImageBack_Click"
                                            AutomationProperties.Name="Move image layer backward"
                                            ToolTipService.ToolTip="Move image behind the next layer">
                                            <FontIcon Glyph="&#xE70D;" FontFamily="Segoe Fluent Icons"
                                                FontSize="12" Width="12" Height="12" />
                                        </local:ToolbarActionButton>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock x:Name="PendingChangesText" Text="Changes pending"
                            Visibility="Collapsed" FontSize="10" VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Right">
                        <local:ToolbarActionButton x:Name="ApplyPropertiesButton"
                            Width="28" Height="28" MinWidth="0"
                            Padding="0" CornerRadius="6" Background="Transparent"
                            BorderThickness="0" Click="ApplyProperties_Click" IsEnabled="False"
                            AutomationProperties.Name="Apply clip properties"
                            ToolTipService.ToolTip="No clip changes to apply">
                            <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons"
                                FontSize="12" Width="12" Height="12" />
                        </local:ToolbarActionButton>
                        <local:ToolbarActionButton x:Name="DeleteClipButton"
                            Width="28" Height="28" MinWidth="0" Padding="0"
                            CornerRadius="6" Background="Transparent" BorderThickness="0"
                            Click="DeleteSelected_Click"
                            AutomationProperties.Name="Remove selected clip"
                            ToolTipService.ToolTip="Remove selected clip · Delete">
                            <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons"
                                FontSize="12" Width="12" Height="12" />
                        </local:ToolbarActionButton>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="12,0" ColumnSpacing="8"
            Background="{ThemeResource ShnappImageChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:ToolbarActionButton x:Name="PlayPauseButton" Width="28" Height="28"
                MinWidth="0" Padding="0" CornerRadius="6" Background="Transparent"
                BorderThickness="0" Click="PlayPause_Click"
                AutomationProperties.Name="Play or pause video"
                ToolTipService.ToolTip="Play or pause · Space">
                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontFamily="Segoe Fluent Icons"
                    FontSize="12" Width="12" Height="12" />
            </local:ToolbarActionButton>
            <TextBlock x:Name="CurrentTimeText" Grid.Column="1" Text="00:00"
                FontSize="11" VerticalAlignment="Center" MinWidth="46" />
            <Slider x:Name="TransportSlider" Grid.Column="2" Minimum="0" Maximum="1"
                StepFrequency="0.01" VerticalAlignment="Center"
                ValueChanged="TransportSlider_ValueChanged"
                AutomationProperties.Name="Video playhead" />
            <TextBlock x:Name="DurationText" Grid.Column="3" Text="00:00"
                FontSize="11" VerticalAlignment="Center" MinWidth="46"
                TextAlignment="Right" />
        </Grid>

        <Grid x:Name="TimelinePanel" Grid.Row="3" Height="210"
            Background="{ThemeResource ShnappCanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="14,0" ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TIMELINE" FontSize="10" FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SelectionHint" Grid.Column="1" Text="Select a clip to edit"
                        FontSize="10" MaxWidth="240" TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center">
                    <local:ToolbarActionButton x:Name="MarkInButton" Width="28" Height="28"
                        MinWidth="0" Padding="0" CornerRadius="6" Background="Transparent"
                        BorderThickness="0" Click="MarkIn_Click"
                        AutomationProperties.Name="Mark range start at playhead"
                        ToolTipService.ToolTip="Mark range start at playhead · I">
                        <FontIcon Glyph="&#xE7C1;" FontFamily="Segoe Fluent Icons"
                            FontSize="12" Width="12" Height="12" />
                    </local:ToolbarActionButton>
                    <local:ToolbarActionButton x:Name="MarkOutButton" Width="28" Height="28"
                        MinWidth="0" Padding="0" CornerRadius="6" Background="Transparent"
                        BorderThickness="0" Click="MarkOut_Click"
                        AutomationProperties.Name="Mark range end at playhead"
                        ToolTipService.ToolTip="Mark range end at playhead · O">
                        <FontIcon Glyph="&#xE7C1;" FontFamily="Segoe Fluent Icons"
                            FontSize="12" Width="12" Height="12" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform>
                        </FontIcon>
                    </local:ToolbarActionButton>
                    <local:ToolbarActionButton x:Name="CutRangeButton" Width="28" Height="28"
                        MinWidth="0" Padding="0" CornerRadius="6" Background="Transparent"
                        BorderThickness="0" Click="CutRange_Click"
                        AutomationProperties.Name="Cut marked range from selected audio or image, or all tracks"
                        ToolTipService.ToolTip="Cut marked range · Selected audio or image only; video or no selection ripples all tracks">
                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons"
                            FontSize="12" Width="12" Height="12" />
                    </local:ToolbarActionButton>
                    <Border Width="1" Height="16" Margin="4,0"
                        Background="{ThemeResource ShnappFloatingEdgeBrush}" Opacity="0.5" />
                    <local:ToolbarActionButton x:Name="SplitButton" Width="28" Height="28"
                        MinWidth="0" Padding="0" CornerRadius="6" Background="Transparent"
                        BorderThickness="0" Click="Split_Click"
                        AutomationProperties.Name="Split selected clip at playhead"
                        ToolTipService.ToolTip="Split selected clip at playhead · S">
                        <FontIcon Glyph="&#xE8C6;" FontFamily="Segoe Fluent Icons"
                            FontSize="12" Width="12" Height="12" />
                    </local:ToolbarActionButton>
                    <local:ToolbarActionButton x:Name="TrimLeftButton" Width="28" Height="28"
                        MinWidth="0" Padding="0" CornerRadius="6" Background="Transparent"
                        BorderThickness="0" Click="TrimLeft_Click"
                        AutomationProperties.Name="Trim selected clip start to playhead"
                        ToolTipService.ToolTip="Trim clip start to playhead">
                        <FontIcon Glyph="&#xE78A;" FontFamily="Segoe Fluent Icons"
                            FontSize="12" Width="12" Height="12" />
                    </local:ToolbarActionButton>
                    <local:ToolbarActionButton x:Name="TrimRightButton" Width="28" Height="28"
                        MinWidth="0" Padding="0" CornerRadius="6" Background="Transparent"
                        BorderThickness="0" Click="TrimRight_Click"
                        AutomationProperties.Name="Trim selected clip end to playhead"
                        ToolTipService.ToolTip="Trim clip end to playhead">
                        <FontIcon Glyph="&#xE78A;" FontFamily="Segoe Fluent Icons"
                            FontSize="12" Width="12" Height="12" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform>
                        </FontIcon>
                    </local:ToolbarActionButton>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled">
            <Grid ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TimelineLaneHeaders" Grid.Column="0"
                    Padding="12,0,8,0" Spacing="0" />
                <ScrollViewer x:Name="TimelineScroll" Grid.Column="1"
                    SizeChanged="TimelineScroll_SizeChanged" ViewChanged="TimelineScroll_ViewChanged"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <Grid x:Name="TimelineContent" Height="164" Background="Transparent"
                        PointerPressed="Timeline_PointerPressed"
                        PointerMoved="Timeline_PointerMoved" PointerReleased="Timeline_PointerReleased"
                        PointerCaptureLost="Timeline_PointerCaptureLost"
                        AllowDrop="True" DragOver="Timeline_DragOver" Drop="Timeline_Drop">
                        <Canvas x:Name="TimelineCanvas" Height="164" Background="Transparent"
                            AllowDrop="True" DragOver="Timeline_DragOver" Drop="Timeline_Drop" />
                    </Grid>
                </ScrollViewer>
            </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="4" Height="28" Padding="10,0"
            Background="{ThemeResource ShnappImageChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProjectTitleText" MaxWidth="160" FontSize="10"
                FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="MetadataText" Grid.Column="1" Margin="10,0,0,0"
                FontSize="10" VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="StatusText" Grid.Column="2" Margin="10,0,0,0"
                FontSize="10" VerticalAlignment="Center" TextAlignment="Right"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
