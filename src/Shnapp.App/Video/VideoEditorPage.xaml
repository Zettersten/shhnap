<Page
    x:Class="Shnapp.App.Video.VideoEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    SizeChanged="Page_SizeChanged"
    Unloaded="Page_Unloaded">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="Paste_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="Undo_Invoked" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="Redo_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" Invoked="Redo_Invoked" />
        <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="Export_Invoked" />
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Invoked" />
        <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="Library_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Background="{ThemeResource ShnappCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Padding="16,0" ColumnSpacing="10"
            Background="{ThemeResource ShnappImageChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE714;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                <TextBlock Text="Video editor" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="ProjectTitleText" FontSize="11" VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="320"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                VerticalAlignment="Center">
                <Button Padding="10,4" Click="AddImage_Click"
                    ToolTipService.ToolTip="Paste an image or choose one from your library">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        <TextBlock Text="Add image" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Padding="10,4" Click="AddAudio_Click"
                    ToolTipService.ToolTip="Add an audio track">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE189;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        <TextBlock Text="Add audio" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Padding="10,4" Click="Export_Click"
                    ToolTipService.ToolTip="Export MP4 · Ctrl+E">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        <TextBlock Text="Export" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Background="#080F1C">
            <MediaPlayerElement x:Name="VideoPlayer" AutoPlay="False"
                AreTransportControlsEnabled="False" Stretch="Uniform"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <ProgressRing x:Name="PreviewProgress" IsActive="False"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="32" Height="32" />
            <Border x:Name="GalleryHotspot" Width="24" Height="84" CornerRadius="0,8,8,0"
                Background="{ThemeResource ShnappImagePanelBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                PointerEntered="GalleryHotspot_PointerEntered"
                ToolTipService.ToolTip="Recent images">
                <FontIcon Glyph="&#xEB9F;" FontFamily="Segoe Fluent Icons" FontSize="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="GalleryPanel" Visibility="Collapsed" Width="244"
                HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="8"
                Padding="12" CornerRadius="10"
                BorderThickness="1" BorderBrush="{ThemeResource ShnappFloatingEdgeBrush}"
                Background="{ThemeResource ShnappInspectorAcrylicBrush}"
                PointerExited="GalleryPanel_PointerExited">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Recent images" FontSize="13" FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons"
                            HorizontalAlignment="Right" Width="26" Height="26" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Click="CloseGallery_Click" AutomationProperties.Name="Close gallery" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="GalleryItemsHost" Spacing="6" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="InspectorPanel" Visibility="Collapsed" Width="244"
                HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="8"
                Padding="12" CornerRadius="10"
                BorderThickness="1" BorderBrush="{ThemeResource ShnappFloatingEdgeBrush}"
                Background="{ThemeResource ShnappInspectorAcrylicBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="SelectedItemTitle" Text="Clip" FontSize="13"
                            FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons"
                            HorizontalAlignment="Right" Width="26" Height="26" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Click="CloseInspector_Click" AutomationProperties.Name="Close clip properties" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Spacing="7">
                            <TextBlock x:Name="SelectedItemDetail" FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <NumberBox x:Name="ClipStartSeconds" Header="Start · seconds"
                                Minimum="0" SpinButtonPlacementMode="Compact" FontSize="11" />
                            <StackPanel x:Name="SourceFields" Spacing="7">
                                <NumberBox x:Name="ClipSourceInSeconds" Header="Source in · seconds"
                                    Minimum="0" SpinButtonPlacementMode="Compact" FontSize="11" />
                                <NumberBox x:Name="ClipSourceOutSeconds" Header="Source out · seconds"
                                    Minimum="0" SpinButtonPlacementMode="Compact" FontSize="11" />
                            </StackPanel>
                            <StackPanel x:Name="AudioFields" Visibility="Collapsed" Spacing="7">
                                <TextBlock Text="Gain" FontSize="11" />
                                <Slider x:Name="AudioGainSlider" Minimum="0" Maximum="4"
                                    StepFrequency="0.05" SmallChange="0.05" />
                                <ToggleSwitch x:Name="AudioMuteSwitch" Header="Mute this clip"
                                    OnContent="Muted" OffContent="Audible" FontSize="11" />
                            </StackPanel>
                            <StackPanel x:Name="OverlayFields" Visibility="Collapsed" Spacing="7">
                                <NumberBox x:Name="OverlayDurationSeconds" Header="Duration · seconds"
                                    Minimum="0.1" SpinButtonPlacementMode="Compact" FontSize="11" />
                                <NumberBox x:Name="OverlayX" Header="Left · pixels"
                                    SpinButtonPlacementMode="Compact" FontSize="11" />
                                <NumberBox x:Name="OverlayY" Header="Top · pixels"
                                    SpinButtonPlacementMode="Compact" FontSize="11" />
                                <NumberBox x:Name="OverlayWidth" Header="Width · pixels"
                                    Minimum="1" SpinButtonPlacementMode="Compact" FontSize="11" />
                                <NumberBox x:Name="OverlayHeight" Header="Height · pixels"
                                    Minimum="1" SpinButtonPlacementMode="Compact" FontSize="11" />
                            </StackPanel>
                            <Button Content="Apply" Click="ApplyProperties_Click"
                                HorizontalAlignment="Stretch" />
                            <Button Content="Remove clip" Click="DeleteSelected_Click"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Padding="14,0" ColumnSpacing="10"
            Background="{ThemeResource ShnappImageChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayPauseButton" Width="30" Height="30" Padding="0"
                Background="Transparent" BorderThickness="0" Click="PlayPause_Click"
                AutomationProperties.Name="Play or pause video">
                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontFamily="Segoe Fluent Icons"
                    FontSize="14" />
            </Button>
            <TextBlock x:Name="CurrentTimeText" Grid.Column="1" Text="00:00"
                FontSize="11" VerticalAlignment="Center" MinWidth="46" />
            <Slider x:Name="TransportSlider" Grid.Column="2" Minimum="0" Maximum="1"
                StepFrequency="0.01" VerticalAlignment="Center"
                ValueChanged="TransportSlider_ValueChanged"
                AutomationProperties.Name="Video playhead" />
            <TextBlock x:Name="DurationText" Grid.Column="3" Text="00:00"
                FontSize="11" VerticalAlignment="Center" MinWidth="46"
                TextAlignment="Right" />
        </Grid>

        <Grid x:Name="TimelinePanel" Grid.Row="4" Height="210"
            Background="{ThemeResource ShnappCanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="14,0" ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="TIMELINE" FontSize="10" FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SelectionHint" Text="Select a clip to edit"
                        FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center">
                    <Button Content="In" Padding="8,3" Click="MarkIn_Click"
                        ToolTipService.ToolTip="Mark cut range start at playhead" FontSize="11" />
                    <Button Content="Out" Padding="8,3" Click="MarkOut_Click"
                        ToolTipService.ToolTip="Mark cut range end at playhead" FontSize="11" />
                    <Button Content="Cut" Padding="8,3" Click="CutRange_Click"
                        ToolTipService.ToolTip="Remove marked range from all tracks" FontSize="11" />
                    <Border Width="1" Height="16" Margin="4,0"
                        Background="{ThemeResource ShnappFloatingEdgeBrush}" Opacity="0.5" />
                    <Button Content="Split" Padding="8,3" Click="Split_Click"
                        ToolTipService.ToolTip="Split selected clip at playhead" FontSize="11" />
                    <Button Content="Trim left" Padding="8,3" Click="TrimLeft_Click"
                        ToolTipService.ToolTip="Trim selected clip to playhead" FontSize="11" />
                    <Button Content="Trim right" Padding="8,3" Click="TrimRight_Click"
                        ToolTipService.ToolTip="Trim selected clip from playhead" FontSize="11" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Padding="12,0,8,0" Spacing="0">
                    <TextBlock Text="" Height="22" />
                    <TextBlock Text="Video" Height="28" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="Computer" Height="28" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="Microphone" Height="28" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="Images" Height="28" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="Added audio" Height="28" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer x:Name="TimelineScroll" Grid.Column="1"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <Grid x:Name="TimelineContent" Height="164" PointerPressed="Timeline_PointerPressed">
                        <Canvas x:Name="TimelineCanvas" Height="164" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="5" Height="28" Padding="10,0"
            Background="{ThemeResource ShnappImageChromeBrush}">
            <TextBlock x:Name="MetadataText" FontSize="10" VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="StatusText" FontSize="10" VerticalAlignment="Center"
                HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Page>
